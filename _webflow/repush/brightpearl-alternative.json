      "prop_id": "6ae44b23-f874-dafc-7624-6eb2dd6738c5",
      "type": "string",
      "string_value": "Not A Brightpearl Alternative: Fix Mistakes Before Automation"
     },
     {
      "prop_id": "d410be85-5d89-9215-6f62-195b0e3f7c44",
      "type": "string",
      "string_value": "Stop a wrong item before your automation sends it on to picking and invoicing. With VoiceOrder Solutions, each chef speaks into our app, then reads the list and changes anything that is off before sending. Brightpearl goes on handling your stock, pricing and automation."
     },
     {
      "prop_id": "5813a60d-8c20-4700-72bd-d80ce9c60b67",
      "type": "string",
      "string_value": "Book a Free Demo"
