     },
     {
      "prop_id": "6ae44b23-f874-dafc-7624-6eb2dd6738c5",
      "type": "string",
      "string_value": "Not A Cin7 Alternative: A Kitchen Ordering Channel"
     },
     {
      "prop_id": "d410be85-5d89-9215-6f62-195b0e3f7c44",
      "type": "string",
      "string_value": "Give your phone-order restaurants a channel of their own. In the VoiceOrder Solutions app, the head chef says what the kitchen needs, fixes any item and sends the order to you. Cin7 keeps the stock, the batches and any webstore or portal you run."
     },
     {
      "prop_id": "5813a60d-8c20-4700-72bd-d80ce9c60b67",
      "type": "string",
      "string_value": "Book a Free Demo"
     }
    ]
   }
  },
