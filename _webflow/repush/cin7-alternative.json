    },
    "values": [
     {
      "prop_id": "be41c71a-4d6f-3276-eb73-5cf5dd4f25f6",
      "type": "string",
      "string_value": "Keep every Cin7 channel, and open one for the kitchens that call"
     },
     {
      "prop_id": "5e0d3c39-9fde-6661-5b10-e1aef4f809a4",
      "type": "string",
      "string_value": "A short demo: one order spoken into the app, and the file your desk would receive."
