      "string_value": "For Food Distributors"
     },
     {
      "prop_id": "6ae44b23-f874-dafc-7624-6eb2dd6738c5",
      "type": "string",
      "string_value": "Not A Zoho Inventory Alternative: Orders Without The Call"
     },
     {
      "prop_id": "d410be85-5d89-9215-6f62-195b0e3f7c44",
      "type": "string",
      "string_value": "Zoho's customer portal lets a restaurant pay a bill, but not start an order. Inside the VoiceOrder Solutions app, your customer's chef talks through what is short and reviews each item before it reaches you. Zoho Inventory carries on with your stock, prices and portal."
     },
     {
      "prop_id": "5813a60d-8c20-4700-72bd-d80ce9c60b67",
      "type": "string",
      "string_value": "Book a Free Demo"
     }
    ]
   }
  },
  {
   "label": "mainCta",
   "set_component_instance_prop_values": {
    "element_id": {
     "component": "6af1a2661c76afa2e8fb7cd5",
