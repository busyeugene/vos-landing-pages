      "string_value": "For Restaurant Operators"
     },
     {
      "prop_id": "6ae44b23-f874-dafc-7624-6eb2dd6738c5",
      "type": "string",
      "string_value": "Not A Lavu POS Alternative: Send Supply Orders"
     },
     {
      "prop_id": "d410be85-5d89-9215-6f62-195b0e3f7c44",
      "type": "string",
      "string_value": "Say your supply order into the VoiceOrder Solutions app, go over each line from your distributor's order guide (your regular items, priced for your account) and send it with an order number. Lavu logs supply orders but does not send them. Your distributor has to offer the app."
     },
     {
      "prop_id": "5813a60d-8c20-4700-72bd-d80ce9c60b67",
      "type": "string",
      "string_value": "Check If My Distributor Offers It"
     }
    ]
   }
  },
