    "values": [
     {
      "prop_id": "a7704768-52e6-0ad3-2179-5447d7543ee2",
      "type": "string",
      "string_value": "For Food Distributors"
     },
     {
      "prop_id": "6ae44b23-f874-dafc-7624-6eb2dd6738c5",
      "type": "string",
      "string_value": "Looking For A Choco Alternative For Voice Ordering?"
     },
     {
      "prop_id": "d410be85-5d89-9215-6f62-195b0e3f7c44",
      "type": "string",
      "string_value": "Add voice ordering without giving anything up. VoiceOrder Solutions runs alongside Choco: kitchens talk through what they are short of in our app, confirm each item, then send. It lands on your desk numbered and dated, by email or straight into your system, while Choco keeps its storefront and customer tools."
     },
     {
      "prop_id": "5813a60d-8c20-4700-72bd-d80ce9c60b67",
      "type": "string",
      "string_value": "Book a Free Demo"
     }
    ]
   }
  },
  {
   "label": "mainCta",
   "set_component_instance_prop_values": {
    "element_id": {
     "component": "6aca3a56a6caad0812b5c2cd",
