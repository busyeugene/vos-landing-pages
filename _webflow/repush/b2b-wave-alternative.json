    "values": [
     {
      "prop_id": "a7704768-52e6-0ad3-2179-5447d7543ee2",
      "type": "string",
      "string_value": "For Food Distributors"
     },
     {
      "prop_id": "6ae44b23-f874-dafc-7624-6eb2dd6738c5",
      "type": "string",
      "string_value": "Not A B2B Wave Alternative: Chefs Approve While Ordering"
     },
     {
      "prop_id": "d410be85-5d89-9215-6f62-195b0e3f7c44",
      "type": "string",
      "string_value": "Chefs who like the phone can talk through their order with our app, then approve each item ahead of sending. B2B Wave's blog has a rep enter it for them, or build it on the call for the chef to approve later in the portal. Your portal stays as it is."
     },
     {
      "prop_id": "5813a60d-8c20-4700-72bd-d80ce9c60b67",
      "type": "string",
      "string_value": "Book a Free Demo"
     }
    ]
   }
  },
  {
   "label": "mainCta",
   "set_component_instance_prop_values": {
    "element_id": {
     "component": "6af1a25d2050d088124d1116",
     "element": "f9bd322f-b390-c3a2-de4c-530ccaac0ed2"
    },
    "values": [
     {
      "prop_id": "be41c71a-4d6f-3276-eb73-5cf5dd4f25f6",
      "type": "string",
      "string_value": "Chefs who talk rather than type sign off on every item themselves."
     },
     {
      "prop_id": "5e0d3c39-9fde-6661-5b10-e1aef4f809a4",
      "type": "string",
      "string_value": "Watch an order get spoken into the app, corrected and sent, ready for your desk."
     },
     {
      "prop_id": "0336eaf6-adb9-6ceb-4140-3e3e57f922c4",
      "type": "string",
      "string_value": "Book a Free Demo"
     }
    ]
   }
  }
