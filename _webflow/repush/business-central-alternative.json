      "prop_id": "6ae44b23-f874-dafc-7624-6eb2dd6738c5",
      "type": "string",
      "string_value": "Not A Business Central Alternative: Orders Checked Before Sending"
     },
     {
      "prop_id": "d410be85-5d89-9215-6f62-195b0e3f7c44",
      "type": "string",
      "string_value": "Get orders that each kitchen has gone over itself, one line at a time. With VoiceOrder Solutions, whoever orders for the kitchen talks it into our app and fixes any wrong line before it goes. The books, the stock and the warehouse remain Business Central's job."
     },
     {
      "prop_id": "5813a60d-8c20-4700-72bd-d80ce9c60b67",
      "type": "string",
      "string_value": "Book a Free Demo"
     }
    ]
   }
  },
