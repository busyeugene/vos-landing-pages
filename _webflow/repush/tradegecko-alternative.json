    "values": [
     {
      "prop_id": "a7704768-52e6-0ad3-2179-5447d7543ee2",
      "type": "string",
      "string_value": "For Food Distributors"
     },
     {
      "prop_id": "6ae44b23-f874-dafc-7624-6eb2dd6738c5",
      "type": "string",
      "string_value": "A TradeGecko Alternative Where Chefs Order Aloud"
     },
     {
      "prop_id": "d410be85-5d89-9215-6f62-195b0e3f7c44",
      "type": "string",
      "string_value": "VoiceOrder Solutions lets restaurants reach you with orders now that TradeGecko's B2B store has closed. In the app, each chef says aloud what is running short, looks over every item, then sends it to you. Stock, purchasing and accounting stay in the system you moved them to."
     },
     {
      "prop_id": "5813a60d-8c20-4700-72bd-d80ce9c60b67",
      "type": "string",
      "string_value": "Book a Free Demo"
     }
    ]
   }
  },
  {
   "label": "mainCta",
   "set_component_instance_prop_values": {
    "element_id": {
     "component": "6af1a255d721161624d33e6a",
     "element": "f9bd322f-b390-c3a2-de4c-530ccaac0ed2"
    },
    "values": [
     {
      "prop_id": "be41c71a-4d6f-3276-eb73-5cf5dd4f25f6",
      "type": "string",
      "string_value": "Replace the store TradeGecko ran with an app restaurants order in by voice"
     },
     {
      "prop_id": "5e0d3c39-9fde-6661-5b10-e1aef4f809a4",
      "type": "string",
      "string_value": "Give us twenty minutes and see one spoken order go from a chef's phone to a distributor's inbox, and what a desk would receive."
     },
     {
      "prop_id": "0336eaf6-adb9-6ceb-4140-3e3e57f922c4",
      "type": "string",
      "string_value": "Book a Free Demo"
     }
    ]
   }
  }
