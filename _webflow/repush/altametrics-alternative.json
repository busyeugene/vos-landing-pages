   "label": "hero",
   "set_component_instance_prop_values": {
    "element_id": {
     "component": "6af1a25759a91f4cdb2b9d62",
     "element": "989faf8b-cac3-f127-6306-f797ae33f470"
    },
    "values": [
     {
      "prop_id": "a7704768-52e6-0ad3-2179-5447d7543ee2",
      "type": "string",
      "string_value": "For Restaurant Operators"
     },
     {
      "prop_id": "6ae44b23-f874-dafc-7624-6eb2dd6738c5",
      "type": "string",
      "string_value": "Not An Altametrics Alternative: When Ordering Isn't Included"
     },
     {
      "prop_id": "d410be85-5d89-9215-6f62-195b0e3f7c44",
      "type": "string",
      "string_value": "On your phone, say what you need from one distributor, go over each item, then tap send and get an order number. Each line comes from the order guide that distributor loads for you: the products you get from them most, priced for your account. This works only where your distributor carries VoiceOrder Solutions."
     },
     {
      "prop_id": "5813a60d-8c20-4700-72bd-d80ce9c60b67",
      "type": "string",
      "string_value": "Check If My Distributor Offers It"
     }
    ]
   }
  },
  {
   "label": "mainCta",
   "set_component_instance_prop_values": {
    "element_id": {
     "component": "6af1a25759a91f4cdb2b9d62",
     "element": "f9bd322f-b390-c3a2-de4c-530ccaac0ed2"
    },
    "values": [
     {
      "prop_id": "be41c71a-4d6f-3276-eb73-5cf5dd4f25f6",
      "type": "string",
      "string_value": "Say what the truck should bring, and keep Altametrics for the rest"
     },
     {
      "prop_id": "5e0d3c39-9fde-6661-5b10-e1aef4f809a4",
      "type": "string",
      "string_value": "Find out from your distributor if they offer VoiceOrder Solutions, or have us check for you."
     },
     {
      "prop_id": "0336eaf6-adb9-6ceb-4140-3e3e57f922c4",
      "type": "string",
      "string_value": "Ask About Getting Started"
     }
    ]
   }
  }
 ],
