      "string_value": "For Food Distributors"
     },
     {
      "prop_id": "6ae44b23-f874-dafc-7624-6eb2dd6738c5",
      "type": "string",
      "string_value": "Not A Syspro Alternative: Kitchen Orders In Writing"
     },
     {
      "prop_id": "d410be85-5d89-9215-6f62-195b0e3f7c44",
      "type": "string",
      "string_value": "Chefs who phone you each morning can send you a checked, written order instead. With VoiceOrder Solutions, the chef speaks each line into our app and fixes any mistakes before you get it. Syspro carries on with the stock, the pricing and the books."
     },
     {
      "prop_id": "5813a60d-8c20-4700-72bd-d80ce9c60b67",
      "type": "string",
      "string_value": "Book a Free Demo"
     }
    ]
   }
  },
  {
   "label": "mainCta",
   "set_component_instance_prop_values": {
    "element_id": {
     "component": "6af1a269744788a272faf024",
     "element": "f9bd322f-b390-c3a2-de4c-530ccaac0ed2"
    },
    "values": [
     {
      "prop_id": "be41c71a-4d6f-3276-eb73-5cf5dd4f25f6",
      "type": "string",
      "string_value": "Syspro stays. The kitchen's order arrives written and checked."
     },
     {
      "prop_id": "5e0d3c39-9fde-6661-5b10-e1aef4f809a4",
      "type": "string",
      "string_value": "Twenty minutes is enough to follow a chef's order from the walk-in to your desk."
     },
     {
      "prop_id": "0336eaf6-adb9-6ceb-4140-3e3e57f922c4",
      "type": "string",
      "string_value": "Book a Free Demo"
     }
    ]
   }
  }
