     {
      "prop_id": "6ae44b23-f874-dafc-7624-6eb2dd6738c5",
      "type": "string",
      "string_value": "An OrderEase Alternative That Adds Voice Ordering"
     },
     {
      "prop_id": "d410be85-5d89-9215-6f62-195b0e3f7c44",
      "type": "string",
      "string_value": "Keep every way you take orders today and add one more. VoiceOrder Solutions sits alongside OrderEase: the kitchen's buyer talks the order into our app and approves each line, so it arrives as a list of your own items and codes. EDI, portals and emailed POs stay with OrderEase."
     },
     {
      "prop_id": "5813a60d-8c20-4700-72bd-d80ce9c60b67",
      "type": "string",
      "string_value": "Book a Free Demo"
     }
    ]
   }
  },
