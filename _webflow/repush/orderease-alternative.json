      "string_value": "Get fewer orders to sort through"
     },
     {
      "prop_id": "5e0d3c39-9fde-6661-5b10-e1aef4f809a4",
      "type": "string",
      "string_value": "Twenty minutes, and one order that turns up itemized, ready to work."
