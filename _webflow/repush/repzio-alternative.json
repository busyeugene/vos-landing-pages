      "prop_id": "6ae44b23-f874-dafc-7624-6eb2dd6738c5",
      "type": "string",
      "string_value": "Not A RepZio Alternative: Chefs Reorder By Voice"
     },
     {
      "prop_id": "d410be85-5d89-9215-6f62-195b0e3f7c44",
      "type": "string",
      "string_value": "Get each reorder after the sale straight from the chef, who says it into our app from that restaurant's order guide and looks over every item before it goes. RepZio stays your reps' tool for presentations and showroom orders, and B2B Direct stays your storefront."
     },
     {
      "prop_id": "5813a60d-8c20-4700-72bd-d80ce9c60b67",
      "type": "string",
      "string_value": "Book a Free Demo"
     }
    ]
