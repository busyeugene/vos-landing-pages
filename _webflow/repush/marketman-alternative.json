     {
      "prop_id": "6ae44b23-f874-dafc-7624-6eb2dd6738c5",
      "type": "string",
      "string_value": "Not A MarketMan Alternative: Skip The Supplier Call"
     },
     {
      "prop_id": "d410be85-5d89-9215-6f62-195b0e3f7c44",
      "type": "string",
      "string_value": "Instead of the call, speak your list into the VoiceOrder Solutions app, check the lines from your distributor's guide, priced for your account, and send a numbered order. It is for a distributor you phone or order through a rep, and only if that distributor offers it."
     },
     {
      "prop_id": "5813a60d-8c20-4700-72bd-d80ce9c60b67",
      "type": "string",
      "string_value": "Check If My Distributor Offers It"
