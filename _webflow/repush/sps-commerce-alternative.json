      "prop_id": "6ae44b23-f874-dafc-7624-6eb2dd6738c5",
      "type": "string",
      "string_value": "Not An SPS Commerce Alternative: For Non-EDI Accounts"
     },
     {
      "prop_id": "d410be85-5d89-9215-6f62-195b0e3f7c44",
      "type": "string",
      "string_value": "Get the restaurants that never send EDI off the phone and into an app made for ordering. With VoiceOrder Solutions, a chef names today's items in our app, by voice, and corrects any before they reach you. SPS Commerce still runs EDI for the chains and large accounts that require it."
     },
     {
      "prop_id": "5813a60d-8c20-4700-72bd-d80ce9c60b67",
      "type": "string",
      "string_value": "Book a Free Demo"
     }
    ]
   }
  },
