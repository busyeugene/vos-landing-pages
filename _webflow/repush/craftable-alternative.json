     {
      "prop_id": "6ae44b23-f874-dafc-7624-6eb2dd6738c5",
      "type": "string",
      "string_value": "Not A Craftable Alternative: Speak The Routine Reorder"
     },
     {
      "prop_id": "d410be85-5d89-9215-6f62-195b0e3f7c44",
      "type": "string",
      "string_value": "Say your weekly reorder from the walk-in, look over every item, then send it with an order number and a confirmation back to your phone. It works with a distributor you still phone or text, if they hand out our app. They keep your guide and your prices current."
     },
     {
      "prop_id": "5813a60d-8c20-4700-72bd-d80ce9c60b67",
      "type": "string",
      "string_value": "Check If My Distributor Offers It"
     }
    ]
   }
  },
