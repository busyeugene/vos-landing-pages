    },
    "values": [
     {
      "prop_id": "a7704768-52e6-0ad3-2179-5447d7543ee2",
      "type": "string",
      "string_value": "For Restaurant Operators"
     },
     {
      "prop_id": "6ae44b23-f874-dafc-7624-6eb2dd6738c5",
      "type": "string",
      "string_value": "Not A MarginEdge Alternative: Speak Orders To Your Distributor"
     },
     {
      "prop_id": "d410be85-5d89-9215-6f62-195b0e3f7c44",
      "type": "string",
      "string_value": "Use your voice to order in the app your distributor hands you, from their guide at the prices they set for you. You check every item before it goes, then get a numbered order and a confirmation on your phone. It works only if your distributor offers VoiceOrder Solutions."
     },
     {
      "prop_id": "5813a60d-8c20-4700-72bd-d80ce9c60b67",
      "type": "string",
      "string_value": "Check If My Distributor Offers It"
     }
    ]
   }
  },
  {
   "label": "mainCta",
   "set_component_instance_prop_values": {
    "element_id": {
     "component": "6ae17ab2ecd9d1b59d8a332a",
     "element": "f9bd322f-b390-c3a2-de4c-530ccaac0ed2"
    },
    "values": [
     {
      "prop_id": "be41c71a-4d6f-3276-eb73-5cf5dd4f25f6",
      "type": "string",
      "string_value": "Let MarginEdge track the costs, and say your next order instead of calling it in."
     },
     {
      "prop_id": "5e0d3c39-9fde-6661-5b10-e1aef4f809a4",
      "type": "string",
      "string_value": "Ask your rep, or ask us, whether the app is open to your kitchen, and we will show you what the distributor receives from a voice order."
     },
     {
      "prop_id": "0336eaf6-adb9-6ceb-4140-3e3e57f922c4",
      "type": "string",
      "string_value": "Ask About Getting Started"
     }
    ]
   }
  }
 ],
