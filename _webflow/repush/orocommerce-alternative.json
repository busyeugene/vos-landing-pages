    },
    "values": [
     {
      "prop_id": "a7704768-52e6-0ad3-2179-5447d7543ee2",
      "type": "string",
      "string_value": "For Food Distributors"
     },
     {
      "prop_id": "6ae44b23-f874-dafc-7624-6eb2dd6738c5",
      "type": "string",
      "string_value": "Not An OroCommerce Alternative: No Login To Reorder"
     },
     {
      "prop_id": "d410be85-5d89-9215-6f62-195b0e3f7c44",
      "type": "string",
      "string_value": "When a chef would rather phone than sign in to your store, let them send each short reorder as a list they have looked over. In the VoiceOrder Solutions app, chefs say their usual items and fix any wrong one before sending. OroCommerce keeps the storefront, sign-offs and quotes your larger accounts use."
     },
     {
      "prop_id": "5813a60d-8c20-4700-72bd-d80ce9c60b67",
      "type": "string",
      "string_value": "Book a Free Demo"
     }
    ]
   }
  },
  {
   "label": "mainCta",
   "set_component_instance_prop_values": {
    "element_id": {
     "component": "6af1a260d65a2fd45f2f30ec",
     "element": "f9bd322f-b390-c3a2-de4c-530ccaac0ed2"
    },
    "values": [
     {
      "prop_id": "be41c71a-4d6f-3276-eb73-5cf5dd4f25f6",
      "type": "string",
      "string_value": "Sign-offs for the groups who need them. Quick spoken reorders for chefs who need none."
     },
     {
      "prop_id": "5e0d3c39-9fde-6661-5b10-e1aef4f809a4",
      "type": "string",
      "string_value": "Give us twenty minutes to show a reorder going from the walk-in to your desk, the way a chef who skips your store would send it."
     },
     {
      "prop_id": "0336eaf6-adb9-6ceb-4140-3e3e57f922c4",
      "type": "string",
      "string_value": "Book a Free Demo"
     }
    ]
   }
  }
