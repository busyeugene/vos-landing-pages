      "string_value": "For Restaurant Operators"
     },
     {
      "prop_id": "6ae44b23-f874-dafc-7624-6eb2dd6738c5",
      "type": "string",
      "string_value": "Not A Restaurant365 Alternative: Speak What You Phone In"
     },
     {
      "prop_id": "d410be85-5d89-9215-6f62-195b0e3f7c44",
      "type": "string",
      "string_value": "Still phoning or texting a rep for one supplier? If that distributor gives you our app, speak that order from the walk-in, fix what is wrong, and send it at any hour. Lines come from their guide, priced for your account, and a text or notification confirms it was sent."
     },
     {
      "prop_id": "5813a60d-8c20-4700-72bd-d80ce9c60b67",
      "type": "string",
      "string_value": "Check If My Distributor Offers It"
     }
    ]
   }
  },
  {
