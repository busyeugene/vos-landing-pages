[{"label": "who.chips[7].alt.image", "set_image_asset": {"id": {"component": "6ac7652a2a715d3e702a0559", "element": "97f1fccd-9ed9-2010-5549-14e9ba48ef26"}, "image_asset_id": "6ad07a8582ff418bc8a6c6b6"}}, {"label": "who.chips[8].alt.image", "set_image_asset": {"id": {"component": "6ac7652a2a715d3e702a0559", "element": "97f1fccd-9ed9-2010-5549-14e9ba48ef2b"}, "image_asset_id": "6ad07a8b1207c22da70d53ca"}}, {"label": "look.h2", "set_text": {"id": {"component": "6ac7652a2a715d3e702a0559", "element": "243523a4-0d73-45a8-d313-77e76fb61846"}, "text": "Three checks before you trust a reorder point"}}, {"label": "look.intro", "set_text": {"id": {"component": "6ac7652a2a715d3e702a0559", "element": "243523a4-0d73-45a8-d313-77e76fb6184a"}, "text": "The sum is simple. The trouble is in the stock and the buffer you feed it, and in the units you count them in."}}, {"label": "vos.body", "set_text": {"id": {"component": "6ac7652a2a715d3e702a0559", "element": "e5cd8bef-40a6-1f65-cfdc-e2adebdb331d"}, "text": "VOS does not set your reorder point, count your stock or order from your suppliers. It works on the demand side, where inventory visibility follows order activity as customers order by voice in the VOS app."}}, {"label": "next.cards[0].alt.image", "set_image_asset": {"id": {"component": "6ac7652a2a715d3e702a0559", "element": "14a34b3b-de20-5ad9-e419-4d7cf0596819"}, "image_asset_id": "6ad07a8c46e29627d6ef796b"}}, {"label": "next.cards[1].alt.image", "set_image_asset": {"id": {"component": "6ac7652a2a715d3e702a0559", "element": "14a34b3b-de20-5ad9-e419-4d7cf0596826"}, "image_asset_id": "6ad07a8582b4c538b5789ee3"}}, {"label": "next.cards[2].body", "set_text": {"id": {"component": "6ac7652a2a715d3e702a0559", "element": "14a34b3b-de20-5ad9-e419-4d7cf0596839"}, "text": "Step back from single lines to the whole stock: turns per year, days on hand, and the cash that sits idle."}}, {"label": "next.cards[2].alt.image", "set_image_asset": {"id": {"component": "6ac7652a2a715d3e702a0559", "element": "14a34b3b-de20-5ad9-e419-4d7cf0596833"}, "image_asset_id": "6ad07a86f43d7bfc43f824d1"}}]