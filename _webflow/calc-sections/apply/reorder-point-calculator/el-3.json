[{"label": "next.cards[0].title", "set_text": {"id": {"component": "6ac7652a2a715d3e702a0559", "element": "14a34b3b-de20-5ad9-e419-4d7cf059681c"}, "text": "Size the buffer you typed in"}}, {"label": "next.cards[0].body", "set_text": {"id": {"component": "6ac7652a2a715d3e702a0559", "element": "14a34b3b-de20-5ad9-e419-4d7cf059681f"}, "text": "Work out a buffer from how much your demand and lead times move, pick a service level, then check it against shelf life."}}, {"label": "next.cards[0].link_label", "set_text": {"id": {"component": "6ac7652a2a715d3e702a0559", "element": "14a34b3b-de20-5ad9-e419-4d7cf0596823"}, "text": "Open the safety stock calculator"}}, {"label": "next.cards[0].link", "set_link": {"id": {"component": "6ac7652a2a715d3e702a0559", "element": "14a34b3b-de20-5ad9-e419-4d7cf0596821"}, "linkType": "page", "link": "6ac735249b6f12d26ba60ce1"}}, {"label": "next.cards[1].title", "set_text": {"id": {"component": "6ac7652a2a715d3e702a0559", "element": "14a34b3b-de20-5ad9-e419-4d7cf0596829"}, "text": "Set how far each order tops up"}}, {"label": "next.cards[1].body", "set_text": {"id": {"component": "6ac7652a2a715d3e702a0559", "element": "14a34b3b-de20-5ad9-e419-4d7cf059682c"}, "text": "Find the level each line returns to between deliveries, and see the cash every buffer day ties up on your floor."}}, {"label": "next.cards[1].link_label", "set_text": {"id": {"component": "6ac7652a2a715d3e702a0559", "element": "14a34b3b-de20-5ad9-e419-4d7cf0596830"}, "text": "Open the par level calculator"}}, {"label": "next.cards[1].link", "set_link": {"id": {"component": "6ac7652a2a715d3e702a0559", "element": "14a34b3b-de20-5ad9-e419-4d7cf059682e"}, "linkType": "page", "link": "6ac79be1b863c26cbc96979a"}}, {"label": "next.cards[2].title", "set_text": {"id": {"component": "6ac7652a2a715d3e702a0559", "element": "14a34b3b-de20-5ad9-e419-4d7cf0596836"}, "text": "See how fast the stock turns"}}, {"label": "next.cards[2].body", "set_text": {"id": {"component": "6ac7652a2a715d3e702a0559", "element": "14a34b3b-de20-5ad9-e419-4d7cf0596839"}, "text": "Count your turns a year, how long a case sits before it sells, and the cash a slow turn keeps tied up."}}, {"label": "next.cards[2].link_label", "set_text": {"id": {"component": "6ac7652a2a715d3e702a0559", "element": "14a34b3b-de20-5ad9-e419-4d7cf059683d"}, "text": "Open the inventory turnover calculator"}}, {"label": "next.cards[2].link", "set_link": {"id": {"component": "6ac7652a2a715d3e702a0559", "element": "14a34b3b-de20-5ad9-e419-4d7cf059683b"}, "linkType": "page", "link": "6ac7252ae188e18d1d906bba"}}]