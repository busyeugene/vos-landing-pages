[{"label": "who.chips[4].label", "set_text": {"id": {"component": "6ac7652a2a715d3e702a0559", "element": "97f1fccd-9ed9-2010-5549-14e9ba48ef19"}, "text": "Controllers questioning rush freight"}}, {"label": "who.chips[5].label", "set_text": {"id": {"component": "6ac7652a2a715d3e702a0559", "element": "97f1fccd-9ed9-2010-5549-14e9ba48ef1e"}, "text": "DSD teams timing warehouse restocks"}}, {"label": "who.chips[6].label", "set_text": {"id": {"component": "6ac7652a2a715d3e702a0559", "element": "97f1fccd-9ed9-2010-5549-14e9ba48ef23"}, "text": "Purchasing teams timing deal buys"}}, {"label": "who.chips[7].label", "set_text": {"id": {"component": "6ac7652a2a715d3e702a0559", "element": "97f1fccd-9ed9-2010-5549-14e9ba48ef28"}, "text": "Warehouse leads flagging low lines"}}, {"label": "who.chips[8].label", "set_text": {"id": {"component": "6ac7652a2a715d3e702a0559", "element": "97f1fccd-9ed9-2010-5549-14e9ba48ef2d"}, "text": "Analysts comparing triggers across SKUs"}}, {"label": "look.h2", "set_text": {"id": {"component": "6ac7652a2a715d3e702a0559", "element": "243523a4-0d73-45a8-d313-77e76fb61846"}, "text": "What to look for before you trust the trigger"}}, {"label": "look.intro", "set_text": {"id": {"component": "6ac7652a2a715d3e702a0559", "element": "243523a4-0d73-45a8-d313-77e76fb6184a"}, "text": "The sum is simple. The trouble is in the stock and the buffer you feed it. Check these three before you set a trigger."}}, {"label": "look.steps[0].title", "set_text": {"id": {"component": "6ac7652a2a715d3e702a0559", "element": "243523a4-0d73-45a8-d313-77e76fb61850"}, "text": "On hand means free to sell"}}, {"label": "look.steps[0].body", "set_text": {"id": {"component": "6ac7652a2a715d3e702a0559", "element": "243523a4-0d73-45a8-d313-77e76fb61854"}, "text": "Take out cases already picked or promised to orders that are in. 850 cases on the floor is less than 850 free if tomorrow's orders already claim part of it."}}, {"label": "look.steps[1].title", "set_text": {"id": {"component": "6ac7652a2a715d3e702a0559", "element": "243523a4-0d73-45a8-d313-77e76fb61858"}, "text": "A buffer sized for this supplier"}}, {"label": "look.steps[1].body", "set_text": {"id": {"component": "6ac7652a2a715d3e702a0559", "element": "243523a4-0d73-45a8-d313-77e76fb6185c"}, "text": "The 229 cases you type in were sized for one lead time. Change the supplier or the lead time and size the buffer again before you trust the trigger."}}, {"label": "look.steps[2].title", "set_text": {"id": {"component": "6ac7652a2a715d3e702a0559", "element": "243523a4-0d73-45a8-d313-77e76fb61860"}, "text": "One unit in every field"}}]