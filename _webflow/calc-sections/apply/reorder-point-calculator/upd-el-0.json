[{"label": "whatis.cards[0].title", "set_text": {"id": {"component": "6ac7652a2a715d3e702a0559", "element": "76639e50-7ac0-f59c-6a87-2ca81ec71243"}, "text": "Supplier wait time, stated in cases"}}, {"label": "whatis.cards[0].alt.image", "set_image_asset": {"id": {"component": "6ac7652a2a715d3e702a0559", "element": "76639e50-7ac0-f59c-6a87-2ca81ec71240"}, "image_asset_id": "6ad07a8a27aa3ab4d513d9f3"}}, {"label": "whatis.cards[1].title", "set_text": {"id": {"component": "6ac7652a2a715d3e702a0559", "element": "76639e50-7ac0-f59c-6a87-2ca81ec7124b"}, "text": "It misses cases already on order"}}, {"label": "whatis.cards[1].alt.image", "set_image_asset": {"id": {"component": "6ac7652a2a715d3e702a0559", "element": "76639e50-7ac0-f59c-6a87-2ca81ec71248"}, "image_asset_id": "6ad07a88927330500c3958ed"}}, {"label": "whatis.cards[2].alt.image", "set_image_asset": {"id": {"component": "6ac7652a2a715d3e702a0559", "element": "76639e50-7ac0-f59c-6a87-2ca81ec71250"}, "image_asset_id": "6ad07a870941cf0d0c62fa49"}}, {"label": "who.intro", "set_text": {"id": {"component": "6ac7652a2a715d3e702a0559", "element": "97f1fccd-9ed9-2010-5549-14e9ba48ef00"}, "text": "Buyers at distributors that hold stock in their own warehouse use it to decide when each line needs a supplier order. Whoever places supplier orders should run it for each line, not once for the whole range."}}, {"label": "who.chips[0].alt.image", "set_image_asset": {"id": {"component": "6ac7652a2a715d3e702a0559", "element": "97f1fccd-9ed9-2010-5549-14e9ba48ef03"}, "image_asset_id": "6ad07a89927330500c3959e0"}}, {"label": "who.chips[1].alt.image", "set_image_asset": {"id": {"component": "6ac7652a2a715d3e702a0559", "element": "97f1fccd-9ed9-2010-5549-14e9ba48ef08"}, "image_asset_id": "6ad07a8a27aa3ab4d513d988"}}, {"label": "who.chips[2].alt.image", "set_image_asset": {"id": {"component": "6ac7652a2a715d3e702a0559", "element": "97f1fccd-9ed9-2010-5549-14e9ba48ef0d"}, "image_asset_id": "6ac71ff0081aaf502c3a5b4f"}}, {"label": "who.chi