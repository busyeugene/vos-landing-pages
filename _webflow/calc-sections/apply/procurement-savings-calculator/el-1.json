[{"label": "who.chips[4].label", "set_text": {"id": {"component": "6ac78670c218082afa38ac6f", "element": "69bfa8b1-cda9-5878-9c7c-47c8f9cb5e56"}, "text": "Finance setting next year's budget"}}, {"label": "who.chips[5].label", "set_text": {"id": {"component": "6ac78670c218082afa38ac6f", "element": "69bfa8b1-cda9-5878-9c7c-47c8f9cb5e5b"}, "text": "Buyers renewing annual contracts"}}, {"label": "who.chips[6].label", "set_text": {"id": {"component": "6ac78670c218082afa38ac6f", "element": "69bfa8b1-cda9-5878-9c7c-47c8f9cb5e60"}, "text": "Buyers pushing back on increases"}}, {"label": "who.chips[7].label", "set_text": {"id": {"component": "6ac78670c218082afa38ac6f", "element": "69bfa8b1-cda9-5878-9c7c-47c8f9cb5e65"}, "text": "Controllers tracking falling case costs"}}, {"label": "who.chips[8].label", "set_text": {"id": {"component": "6ac78670c218082afa38ac6f", "element": "69bfa8b1-cda9-5878-9c7c-47c8f9cb5e6a"}, "text": "Managers comparing two buyers' results"}}, {"label": "look.h2", "set_text": {"id": {"component": "6ac78670c218082afa38ac6f", "element": "9a5ee337-7c4d-daef-8eec-404c5488495e"}, "text": "What to check before you report the saving"}}, {"label": "look.intro", "set_text": {"id": {"component": "6ac78670c218082afa38ac6f", "element": "9a5ee337-7c4d-daef-8eec-404c54884962"}, "text": "A savings figure is only as good as the comparison under it. These three checks catch the claims that look fine in a deck and fail in review."}}, {"label": "look.steps[0].title", "set_text": {"id": {"component": "6ac78670c218082afa38ac6f", "element": "9a5ee337-7c4d-daef-8eec-404c54884968"}, "text": "The same case on both prices"}}, {"label": "look.steps[0].body", "set_text": {"id": {"component": "6ac78670c218082afa38ac6f", "element": "9a5ee337-7c4d-daef-8eec-404c5488496c"}, "text": "$22.56 has to buy the same pack, brand and grade that $24.00 did. A smaller pack or a cheaper brand is a different product, not a saving."}}, {"label": "look.steps[1].title", "set_text": {"id": {"component": "6ac78670c218082afa38ac6f", "element": "9a5ee337-7c4d-daef-8eec-404c54884970"}, "text": "Cases bought at the new price"}}, {"label": "look.steps[1].body", "set_text": {"id": {"component": "6ac78670c218082afa38ac6f", "element": "9a5ee337-7c4d-daef-8eec-404c54884974"}, "text": "The calculator assumes the new price ran all year. If the deal started partway through, enter only the cases bought since, not the full 72,000."}}, {"label": "look.steps[2].title", "set_text": {"id": {"component": "6ac78670c218082afa38ac6f", "element": "9a5ee337-7c4d-daef-8eec-404c54884978"}, "text": "An increase someone put in writing"}}]