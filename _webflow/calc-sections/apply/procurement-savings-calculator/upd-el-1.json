[{"label": "who.chips[6].alt.image", "set_image_asset": {"id": {"component": "6ac78670c218082afa38ac6f", "element": "69bfa8b1-cda9-5878-9c7c-47c8f9cb5e5e"}, "image_asset_id": "6ad07a8a27aa3ab4d513d988"}}, {"label": "who.chips[7].alt.image", "set_image_asset": {"id": {"component": "6ac78670c218082afa38ac6f", "element": "69bfa8b1-cda9-5878-9c7c-47c8f9cb5e63"}, "image_asset_id": "6ad07a86a7398c6342ee4976"}}, {"label": "who.chips[8].alt.image", "set_image_asset": {"id": {"component": "6ac78670c218082afa38ac6f", "element": "69bfa8b1-cda9-5878-9c7c-47c8f9cb5e68"}, "image_asset_id": "6ad07a8f36601c73ce217313"}}, {"label": "look.h2", "set_text": {"id": {"component": "6ac78670c218082afa38ac6f", "element": "9a5ee337-7c4d-daef-8eec-404c5488495e"}, "text": "Test a saving before it goes in the report"}}, {"label": "vos.body", "set_text": {"id": {"component": "6ac78670c218082afa38ac6f", "element": "2da9766d-0e45-a24f-48b2-996706602f00"}, "text": "VOS does not measure savings or deal with your suppliers. It comes in after the deal: each account orders from its own guide, at the prices you set. When a deal changes a sell price, you update the guides in the VOS admin platform."}}, {"label": "next.cards[0].alt.image", "set_image_asset": {"id": {"component": "6ac78670c218082afa38ac6f", "element": "b1ec5a1b-cda3-6dee-9887-e4566cb0424e"}, "image_asset_id": "6ad07a86f43d7bfc43f824d1"}}, {"label": "next.cards[1].body", "set_text": {"id": {"component": "6ac78670c218082afa38ac6f", "element": "b1ec5a1b-cda3-6dee-9887-e4566cb04261"}, "text": "Before you book a lower case price as a saving, check that it still wins per unit once freight is in."}}, {"label": "next.cards[1].alt.image", "set_image_asset": {"id": {"component": "6ac78670c218082afa38ac6f", "element": "b1ec5a1b-cda3-6dee-9887-e4566cb0425b"}, "image_asset_id": "6ad07a8582b4c538b5789ee3"}}, {"label": "next.cards[2].alt.image", "set_image_asset": {"id": {"component": "6ac78670c218082afa38ac6f", "element": "b1ec5a1b-cda3-6dee-9887-e4566c