[{"label": "next.cards[0].title", "set_text": {"id": {"component": "6ac78670c218082afa38ac6f", "element": "b1ec5a1b-cda3-6dee-9887-e4566cb04251"}, "text": "Check the invoice held the deal"}}, {"label": "next.cards[0].body", "set_text": {"id": {"component": "6ac78670c218082afa38ac6f", "element": "b1ec5a1b-cda3-6dee-9887-e4566cb04254"}, "text": "Compare the price on each invoice with your standard, per case and as a percent, and see what the gap is worth a year."}}, {"label": "next.cards[0].link_label", "set_text": {"id": {"component": "6ac78670c218082afa38ac6f", "element": "b1ec5a1b-cda3-6dee-9887-e4566cb04258"}, "text": "Open the price variance calculator"}}, {"label": "next.cards[0].link", "set_link": {"id": {"component": "6ac78670c218082afa38ac6f", "element": "b1ec5a1b-cda3-6dee-9887-e4566cb04256"}, "linkType": "page", "link": "6ac7866c27806c8148c2855e"}}, {"label": "next.cards[1].title", "set_text": {"id": {"component": "6ac78670c218082afa38ac6f", "element": "b1ec5a1b-cda3-6dee-9887-e4566cb0425e"}, "text": "Rank supplier offers on landed cost"}}, {"label": "next.cards[1].body", "set_text": {"id": {"component": "6ac78670c218082afa38ac6f", "element": "b1ec5a1b-cda3-6dee-9887-e4566cb04261"}, "text": "Compare three supplier quotes on landed cost per unit, because the cheapest case price is rarely the cheapest unit."}}, {"label": "next.cards[1].link_label", "set_text": {"id": {"component": "6ac78670c218082afa38ac6f", "element": "b1ec5a1b-cda3-6dee-9887-e4566cb04265"}, "text": "Open the landed cost calculator"}}, {"label": "next.cards[1].link", "set_link": {"id": {"component": "6ac78670c218082afa38ac6f", "element": "b1ec5a1b-cda3-6dee-9887-e4566cb04263"}, "linkType": "page", "link": "6ac7652962cd713ecd056f43"}}, {"label": "next.cards[2].title", "set_text": {"id": {"component": "6ac78670c218082afa38ac6f", "element": "b1ec5a1b-cda3-6dee-9887-e4566cb0426b"}, "text": "Price the payment terms too"}}, {"label": "next.cards[2].body", "set_text": {"id": {"component": "6ac78670c218082afa38ac6f", "element": "b1ec5a1b-cda3-6dee-9887-e4566cb0426e"}, "text": "See what paying a supplier early is worth as a yearly rate, and what the case costs after discounts and freight."}}, {"label": "next.cards[2].link_label", "set_text": {"id": {"component": "6ac78670c218082afa38ac6f", "element": "b1ec5a1b-cda3-6dee-9887-e4566cb04272"}, "text": "Open the early payment discount calculator"}}, {"label": "next.cards[2].link", "set_link": {"id": {"component": "6ac78670c218082afa38ac6f", "element": "b1ec5a1b-cda3-6dee-9887-e4566cb04270"}, "linkType": "page", "link": "6ac79be4b863c26cbc9698b6"}}]