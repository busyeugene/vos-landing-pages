[{"label": "look.steps[2].body", "set_text": {"id": {"component": "6ac7252ae188e18d1d906bba", "element": "c03931a6-a165-dec7-3ef4-477be13be87c"}, "text": "Writing off dead stock lowers average inventory without selling a single case. Turns go up, and nothing moved any faster."}}, {"label": "vos.badge", "set_text": {"id": {"component": "6ac7252ae188e18d1d906bba", "element": "4a53b61c-659c-d34a-f579-cbb662e7d6d3"}, "text": "Order Taking"}}, {"label": "vos.h2", "set_text": {"id": {"component": "6ac7252ae188e18d1d906bba", "element": "4a53b61c-659c-d34a-f579-cbb662e7d6d4"}, "text": "Where VOS sits next to your turns"}}, {"label": "vos.row_badge", "set_text": {"id": {"component": "6ac7252ae188e18d1d906bba", "element": "4a53b61c-659c-d34a-f579-cbb662e7d6dd"}, "text": "Your Cost of Goods Sold"}}, {"label": "vos.h3", "set_text": {"id": {"component": "6ac7252ae188e18d1d906bba", "element": "4a53b61c-659c-d34a-f579-cbb662e7d6de"}, "text": "Every turn starts with an account's order"}}, {"label": "vos.body", "set_text": {"id": {"component": "6ac7252ae188e18d1d906bba", "element": "4a53b61c-659c-d34a-f579-cbb662e7d6e2"}, "text": "VOS does not calculate your turns or keep your books. It works where stock leaves the shelf: your customers order by voice in the VOS app and review each line first."}}, {"label": "vos.bullets[0]", "set_text": {"id": {"component": "6ac7252ae188e18d1d906bba", "element": "4a53b61c-659c-d34a-f579-cbb662e7d6e9"}, "text": "Sales reps freed to sell instead of taking orders"}}, {"label": "vos.bullets[1]", "set_text": {"id": {"component": "6ac7252ae188e18d1d906bba", "element": "4a53b61c-659c-d34a-f579-cbb662e7d6ef"}, "text": "Orders reach you by email, EDI or API"}}, {"label": "vos.bullets[2]", "set_text": {"id": {"component": "6ac7252ae188e18d1d906bba", "element": "4a53b61c-659c-d34a-f579-cbb662e7d6f5"}, "text": "Order history per account in one admin platform"}}, {"label": "vos.bullets[3]", "set_text": {"id": {"component": "6ac7252ae188e18d1d906bba", "element": "4a53b61c-659c-d34a-f579-cbb662e7d6fb"}, "text": "Promos and confirmations reach accounts by notification and text"}}, {"label": "next.h2", "set_text": {"id": {"component": "6ac7252ae188e18d1d906bba", "element": "dd2ddcd7-bb5c-16f7-de83-aa2325a30b88"}, "text": "What to run after inventory turnover"}}, {"label": "next.intro", "set_text": {"id": {"component": "6ac7252ae188e18d1d906bba", "element": "dd2ddcd7-bb5c-16f7-de83-aa2325a30b8d"}, "text": "Turns show how fast the shelf moves. These free calculators price the holding, follow the cash to collection, and set when to reorder."}}]