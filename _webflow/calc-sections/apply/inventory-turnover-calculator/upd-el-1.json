[{"label": "who.chips[6].alt.image", "set_image_asset": {"id": {"component": "6ac7252ae188e18d1d906bba", "element": "c40542e6-da8e-0896-13c5-b31b9fea9edf"}, "image_asset_id": "6ad07a87835ef439cc7910a2"}}, {"label": "who.chips[7].alt.image", "set_image_asset": {"id": {"component": "6ac7252ae188e18d1d906bba", "element": "c40542e6-da8e-0896-13c5-b31b9fea9ee4"}, "image_asset_id": "6ac71f2ddacb5c302d9d5c0a"}}, {"label": "who.chips[8].alt.image", "set_image_asset": {"id": {"component": "6ac7252ae188e18d1d906bba", "element": "c40542e6-da8e-0896-13c5-b31b9fea9ee9"}, "image_asset_id": "6ad07a8b1207c22da70d53ca"}}, {"label": "look.h2", "set_text": {"id": {"component": "6ac7252ae188e18d1d906bba", "element": "c03931a6-a165-dec7-3ef4-477be13be85e"}, "text": "What can skew an inventory turnover ratio"}}, {"label": "look.intro", "set_text": {"id": {"component": "6ac7252ae188e18d1d906bba", "element": "c03931a6-a165-dec7-3ef4-477be13be862"}, "text": "Turns come from one division, and the division never fails. The two numbers you divide are where the ratio drifts, so look here before setting a target."}}, {"label": "vos.body", "set_text": {"id": {"component": "6ac7252ae188e18d1d906bba", "element": "4a53b61c-659c-d34a-f579-cbb662e7d6e2"}, "text": "VOS does not calculate your turns or keep your books. It handles the order that takes stock off the shelf: customers speak it into the VOS app and review each line first."}}, {"label": "next.cards[1].alt.image", "set_image_asset": {"id": {"component": "6ac7252ae188e18d1d906bba", "element": "dd2ddcd7-bb5c-16f7-de83-aa2325a30b9f"}, "image_asset_id": "6ad07a8582b4c538b5789ee3"}}, {"label": "next.cards[2].alt.image", "set_image_asset": {"id": {"component": "6ac7252ae188e18d1d906bba", "element": "dd2ddcd7-bb5c-16f7-de83-aa2325a30bac"}, "image_asset_id": "6ac71f2c44e677760b6845f4"}}]