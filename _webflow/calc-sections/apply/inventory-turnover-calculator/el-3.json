[{"label": "next.cards[0].title", "set_text": {"id": {"component": "6ac7252ae188e18d1d906bba", "element": "dd2ddcd7-bb5c-16f7-de83-aa2325a30b95"}, "text": "Build the rate behind the carrying cost"}}, {"label": "next.cards[0].body", "set_text": {"id": {"component": "6ac7252ae188e18d1d906bba", "element": "dd2ddcd7-bb5c-16f7-de83-aa2325a30b98"}, "text": "Add capital, storage, spoilage, insurance and obsolescence into a carrying rate of your own, instead of a borrowed one."}}, {"label": "next.cards[0].link_label", "set_text": {"id": {"component": "6ac7252ae188e18d1d906bba", "element": "dd2ddcd7-bb5c-16f7-de83-aa2325a30b9c"}, "text": "Open the inventory carrying cost calculator"}}, {"label": "next.cards[0].link", "set_link": {"id": {"component": "6ac7252ae188e18d1d906bba", "element": "dd2ddcd7-bb5c-16f7-de83-aa2325a30b9a"}, "linkType": "page", "link": "6ac7866e071fb41c4807eab0"}}, {"label": "next.cards[1].title", "set_text": {"id": {"component": "6ac7252ae188e18d1d906bba", "element": "dd2ddcd7-bb5c-16f7-de83-aa2325a30ba2"}, "text": "Follow the cash after the case sells"}}, {"label": "next.cards[1].body", "set_text": {"id": {"component": "6ac7252ae188e18d1d906bba", "element": "dd2ddcd7-bb5c-16f7-de83-aa2325a30ba5"}, "text": "Check how fast accounts pay, how many days past terms they really run, and what financing that delay costs."}}, {"label": "next.cards[1].link_label", "set_text": {"id": {"component": "6ac7252ae188e18d1d906bba", "element": "dd2ddcd7-bb5c-16f7-de83-aa2325a30ba9"}, "text": "Open the accounts receivable turnover calculator"}}, {"label": "next.cards[1].link", "set_link": {"id": {"component": "6ac7252ae188e18d1d906bba", "element": "dd2ddcd7-bb5c-16f7-de83-aa2325a30ba7"}, "linkType": "page", "link": "6ac72b932e36cb4efe865399"}}, {"label": "next.cards[2].title", "set_text": {"id": {"component": "6ac7252ae188e18d1d906bba", "element": "dd2ddcd7-bb5c-16f7-de83-aa2325a30baf"}, "text": "Set a trigger on the lines that matter"}}, {"label": "next.cards[2].body", "set_text": {"id": {"component": "6ac7252ae188e18d1d906bba", "element": "dd2ddcd7-bb5c-16f7-de83-aa2325a30bb2"}, "text": "Get the stock level that should start the next order, the days of cover left, and what a late truck costs in cases."}}, {"label": "next.cards[2].link_label", "set_text": {"id": {"component": "6ac7252ae188e18d1d906bba", "element": "dd2ddcd7-bb5c-16f7-de83-aa2325a30bb6"}, "text": "Open the reorder point calculator"}}, {"label": "next.cards[2].link", "set_link": {"id": {"component": "6ac7252ae188e18d1d906bba", "element": "dd2ddcd7-bb5c-16f7-de83-aa2325a30bb4"}, "linkType": "page", "link": "6ac7652a2a715d3e702a0559"}}]