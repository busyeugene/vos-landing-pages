[{"label": "who.chips[4].label", "set_text": {"id": {"component": "6ac7252ae188e18d1d906bba", "element": "c40542e6-da8e-0896-13c5-b31b9fea9ed7"}, "text": "Buyers weighing a deal buy"}}, {"label": "who.chips[5].label", "set_text": {"id": {"component": "6ac7252ae188e18d1d906bba", "element": "c40542e6-da8e-0896-13c5-b31b9fea9edc"}, "text": "Category managers ranking line turns"}}, {"label": "who.chips[6].label", "set_text": {"id": {"component": "6ac7252ae188e18d1d906bba", "element": "c40542e6-da8e-0896-13c5-b31b9fea9ee1"}, "text": "Sales managers pushing slow lines"}}, {"label": "who.chips[7].label", "set_text": {"id": {"component": "6ac7252ae188e18d1d906bba", "element": "c40542e6-da8e-0896-13c5-b31b9fea9ee6"}, "text": "Warehouse leads clearing dead stock"}}, {"label": "who.chips[8].label", "set_text": {"id": {"component": "6ac7252ae188e18d1d906bba", "element": "c40542e6-da8e-0896-13c5-b31b9fea9eeb"}, "text": "Analysts comparing year on year"}}, {"label": "look.h2", "set_text": {"id": {"component": "6ac7252ae188e18d1d906bba", "element": "c03931a6-a165-dec7-3ef4-477be13be85e"}, "text": "What to look for before you trust the ratio"}}, {"label": "look.intro", "set_text": {"id": {"component": "6ac7252ae188e18d1d906bba", "element": "c03931a6-a165-dec7-3ef4-477be13be862"}, "text": "The division is simple. The two numbers you divide are where the ratio drifts. Check these three before you set a target off it."}}, {"label": "look.steps[0].title", "set_text": {"id": {"component": "6ac7252ae188e18d1d906bba", "element": "c03931a6-a165-dec7-3ef4-477be13be868"}, "text": "The same twelve months on both sides"}}, {"label": "look.steps[0].body", "set_text": {"id": {"component": "6ac7252ae188e18d1d906bba", "element": "c03931a6-a165-dec7-3ef4-477be13be86c"}, "text": "Cost of goods and average inventory have to cover the same period. Pair a calendar year of sales with a fiscal year of stock and the ratio measures neither year."}}, {"label": "look.steps[1].title", "set_text": {"id": {"component": "6ac7252ae188e18d1d906bba", "element": "c03931a6-a165-dec7-3ef4-477be13be870"}, "text": "Sales that never touched the shelf"}}, {"label": "look.steps[1].body", "set_text": {"id": {"component": "6ac7252ae188e18d1d906bba", "element": "c03931a6-a165-dec7-3ef4-477be13be874"}, "text": "Drop shipped and cross docked product lands in cost of goods without sitting in stock. Leave it in and 12.0 turns reads faster than your shelf moves."}}, {"label": "look.steps[2].title", "set_text": {"id": {"component": "6ac7252ae188e18d1d906bba", "element": "c03931a6-a165-dec7-3ef4-477be13be878"}, "text": "Write offs that flatter the ratio"}}]