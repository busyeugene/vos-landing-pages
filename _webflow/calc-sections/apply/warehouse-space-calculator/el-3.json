[{"label": "next.h2", "set_text": {"id": {"component": "6ac735232408756f9071e095", "element": "61e5d8e8-d8e7-94bd-6b06-219d9edabe85"}, "text": "What to run after warehouse space"}}, {"label": "next.intro", "set_text": {"id": {"component": "6ac735232408756f9071e095", "element": "61e5d8e8-d8e7-94bd-6b06-219d9edabe8a"}, "text": "You know the floor your stock needs. These three check the building you have, what holding the stock costs, and how fast it moves."}}, {"label": "next.cards[0].title", "set_text": {"id": {"component": "6ac735232408756f9071e095", "element": "61e5d8e8-d8e7-94bd-6b06-219d9edabe92"}, "text": "Check what your building holds"}}, {"label": "next.cards[0].body", "set_text": {"id": {"component": "6ac735232408756f9071e095", "element": "61e5d8e8-d8e7-94bd-6b06-219d9edabe95"}, "text": "See how many cases the building you already have will hold, and how many weeks of flow that covers."}}, {"label": "next.cards[0].link_label", "set_text": {"id": {"component": "6ac735232408756f9071e095", "element": "61e5d8e8-d8e7-94bd-6b06-219d9edabe99"}, "text": "Open the warehouse size calculator"}}, {"label": "next.cards[0].link", "set_link": {"id": {"component": "6ac735232408756f9071e095", "element": "61e5d8e8-d8e7-94bd-6b06-219d9edabe97"}, "linkType": "page", "link": "6ac72b9663b2850d53a5f878"}}, {"label": "next.cards[1].title", "set_text": {"id": {"component": "6ac735232408756f9071e095", "element": "61e5d8e8-d8e7-94bd-6b06-219d9edabe9f"}, "text": "Price the stock you hold"}}, {"label": "next.cards[1].body", "set_text": {"id": {"component": "6ac735232408756f9071e095", "element": "61e5d8e8-d8e7-94bd-6b06-219d9edabea2"}, "text": "Add capital, storage, spoilage, insurance and obsolescence into one carrying rate, instead of a rule of thumb."}}, {"label": "next.cards[1].link_label", "set_text": {"id": {"component": "6ac735232408756f9071e095", "element": "61e5d8e8-d8e7-94bd-6b06-219d9edabea6"}, "text": "Open the carrying cost calculator"}}, {"label": "next.cards[1].link", "set_link": {"id": {"component": "6ac735232408756f9071e095", "element": "61e5d8e8-d8e7-94bd-6b06-219d9edabea4"}, "linkType": "page", "link": "6ac7866e071fb41c4807eab0"}}, {"label": "next.cards[2].title", "set_text": {"id": {"component": "6ac735232408756f9071e095", "element": "61e5d8e8-d8e7-94bd-6b06-219d9edabeac"}, "text": "Count how often the stock turns"}}, {"label": "next.cards[2].body", "set_text": {"id": {"component": "6ac735232408756f9071e095", "element": "61e5d8e8-d8e7-94bd-6b06-219d9edabeaf"}, "text": "See how many times a year your stock turns, and how long a case sits before it sells."}}]