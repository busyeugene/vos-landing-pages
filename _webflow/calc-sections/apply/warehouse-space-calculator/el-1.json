[{"label": "who.chips[2].label", "set_text": {"id": {"component": "6ac735232408756f9071e095", "element": "f1a8dd8c-246d-5c22-669f-abce47e79f6b"}, "text": "Teams planning for growth"}}, {"label": "who.chips[3].label", "set_text": {"id": {"component": "6ac735232408756f9071e095", "element": "f1a8dd8c-246d-5c22-669f-abce47e79f70"}, "text": "Ops planning dock and staging"}}, {"label": "who.chips[4].label", "set_text": {"id": {"component": "6ac735232408756f9071e095", "element": "f1a8dd8c-246d-5c22-669f-abce47e79f75"}, "text": "Finance budgeting rent per case"}}, {"label": "who.chips[5].label", "set_text": {"id": {"component": "6ac735232408756f9071e095", "element": "f1a8dd8c-246d-5c22-669f-abce47e79f7a"}, "text": "Buyers adding a seasonal range"}}, {"label": "who.chips[6].label", "set_text": {"id": {"component": "6ac735232408756f9071e095", "element": "f1a8dd8c-246d-5c22-669f-abce47e79f7f"}, "text": "Owners briefing a property broker"}}, {"label": "who.chips[7].label", "set_text": {"id": {"component": "6ac735232408756f9071e095", "element": "f1a8dd8c-246d-5c22-669f-abce47e79f84"}, "text": "Teams cutting overflow storage"}}, {"label": "who.chips[8].label", "set_text": {"id": {"component": "6ac735232408756f9071e095", "element": "f1a8dd8c-246d-5c22-669f-abce47e79f89"}, "text": "Ops sizing cooler against dry"}}, {"label": "look.h2", "set_text": {"id": {"component": "6ac735232408756f9071e095", "element": "dc3e4f04-1c78-f3d9-c3b0-40d0a8e79716"}, "text": "What to check before you trust the square footage"}}, {"label": "look.intro", "set_text": {"id": {"component": "6ac735232408756f9071e095", "element": "dc3e4f04-1c78-f3d9-c3b0-40d0a8e7971a"}, "text": "Every result on the page comes from the first few inputs. These three are where a space estimate tends to drift."}}, {"label": "look.steps[0].title", "set_text": {"id": {"component": "6ac735232408756f9071e095", "element": "dc3e4f04-1c78-f3d9-c3b0-40d0a8e79720"}, "text": "One real peak, not a sum of peaks"}}, {"label": "look.steps[0].body", "set_text": {"id": {"component": "6ac735232408756f9071e095", "element": "dc3e4f04-1c78-f3d9-c3b0-40d0a8e79724"}, "text": "In shared storage, adding each line's busiest week overstates it, because lines do not all peak together. Use the most cases you held on one actual day."}}, {"label": "look.steps[1].title", "set_text": {"id": {"component": "6ac735232408756f9071e095", "element": "dc3e4f04-1c78-f3d9-c3b0-40d0a8e79728"}, "text": "Stack height the product can bear"}}]