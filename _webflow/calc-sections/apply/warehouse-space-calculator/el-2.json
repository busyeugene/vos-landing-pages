[{"label": "look.steps[1].body", "set_text": {"id": {"component": "6ac735232408756f9071e095", "element": "dc3e4f04-1c78-f3d9-c3b0-40d0a8e7972c"}, "text": "Not every case can carry a pallet on top. Soft or fragile lines often stay one high, so run them on their own before you enter 2."}}, {"label": "look.steps[2].title", "set_text": {"id": {"component": "6ac735232408756f9071e095", "element": "dc3e4f04-1c78-f3d9-c3b0-40d0a8e79730"}, "text": "Each temperature zone on its own"}}, {"label": "look.steps[2].body", "set_text": {"id": {"component": "6ac735232408756f9071e095", "element": "dc3e4f04-1c78-f3d9-c3b0-40d0a8e79734"}, "text": "Run dry, cooler and freezer as three separate estimates. One blended run lets spare dry floor hide a freezer that is already full."}}, {"label": "vos.badge", "set_text": {"id": {"component": "6ac735232408756f9071e095", "element": "b99db44d-00a4-7904-f4ec-3695dbdf9ab3"}, "text": "Order Intake"}}, {"label": "vos.h2", "set_text": {"id": {"component": "6ac735232408756f9071e095", "element": "b99db44d-00a4-7904-f4ec-3695dbdf9ab4"}, "text": "Where VOS sits next to your warehouse"}}, {"label": "vos.row_badge", "set_text": {"id": {"component": "6ac735232408756f9071e095", "element": "b99db44d-00a4-7904-f4ec-3695dbdf9abd"}, "text": "Not A Warehouse System"}}, {"label": "vos.h3", "set_text": {"id": {"component": "6ac735232408756f9071e095", "element": "b99db44d-00a4-7904-f4ec-3695dbdf9abe"}, "text": "Sizing the building stays with you"}}, {"label": "vos.body", "set_text": {"id": {"component": "6ac735232408756f9071e095", "element": "b99db44d-00a4-7904-f4ec-3695dbdf9ac2"}, "text": "VOS does not size buildings or run a warehouse: no bins, pick paths or scanning. It works on the orders coming in. Customers order by voice in the VOS app at any hour, so overnight orders are waiting when the day's picking is planned."}}, {"label": "vos.bullets[0]", "set_text": {"id": {"component": "6ac735232408756f9071e095", "element": "b99db44d-00a4-7904-f4ec-3695dbdf9ac9"}, "text": "After-hours orders captured and waiting"}}, {"label": "vos.bullets[1]", "set_text": {"id": {"component": "6ac735232408756f9071e095", "element": "b99db44d-00a4-7904-f4ec-3695dbdf9acf"}, "text": "Stock visibility that follows order activity"}}, {"label": "vos.bullets[2]", "set_text": {"id": {"component": "6ac735232408756f9071e095", "element": "b99db44d-00a4-7904-f4ec-3695dbdf9ad5"}, "text": "Your stock numbers stay in your own system"}}, {"label": "vos.bullets[3]", "set_text": {"id": {"component": "6ac735232408756f9071e095", "element": "b99db44d-00a4-7904-f4ec-3695dbdf9adb"}, "text": "Runs alongside your current systems, nothing to rip out"}}]