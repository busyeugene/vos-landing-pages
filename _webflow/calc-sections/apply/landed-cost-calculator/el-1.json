[{"label": "who.chips[4].label", "set_text": {"id": {"component": "6ac7652962cd713ecd056f43", "element": "a4201960-640a-6b8d-78d5-777d1ed14ce4"}, "text": "Controllers checking cost of goods"}}, {"label": "who.chips[5].label", "set_text": {"id": {"component": "6ac7652962cd713ecd056f43", "element": "a4201960-640a-6b8d-78d5-777d1ed14ce9"}, "text": "Purchasing teams rebidding at renewal"}}, {"label": "who.chips[6].label", "set_text": {"id": {"component": "6ac7652962cd713ecd056f43", "element": "a4201960-640a-6b8d-78d5-777d1ed14cee"}, "text": "Pricing staff setting sell prices"}}, {"label": "who.chips[7].label", "set_text": {"id": {"component": "6ac7652962cd713ecd056f43", "element": "a4201960-640a-6b8d-78d5-777d1ed14cf3"}, "text": "Ops leads trimming unit cost"}}, {"label": "who.chips[8].label", "set_text": {"id": {"component": "6ac7652962cd713ecd056f43", "element": "a4201960-640a-6b8d-78d5-777d1ed14cf8"}, "text": "Teams comparing case sizes"}}, {"label": "look.h2", "set_text": {"id": {"component": "6ac7652962cd713ecd056f43", "element": "a45171a4-a190-e258-b94e-9324a4409043"}, "text": "What to look for before you trust the ranking"}}, {"label": "look.intro", "set_text": {"id": {"component": "6ac7652962cd713ecd056f43", "element": "a45171a4-a190-e258-b94e-9324a4409047"}, "text": "The division is exact. The quotes you feed it are not always alike, and these three gaps are the usual reason."}}, {"label": "look.steps[0].title", "set_text": {"id": {"component": "6ac7652962cd713ecd056f43", "element": "a45171a4-a190-e258-b94e-9324a440904d"}, "text": "The same item in all three quotes"}}, {"label": "look.steps[0].body", "set_text": {"id": {"component": "6ac7652962cd713ecd056f43", "element": "a45171a4-a190-e258-b94e-9324a4409051"}, "text": "Check grade, brand and spec before you rank. A cheaper unit of a lower grade is a different product, and the ranking cannot tell the difference."}}, {"label": "look.steps[1].title", "set_text": {"id": {"component": "6ac7652962cd713ecd056f43", "element": "a45171a4-a190-e258-b94e-9324a4409055"}, "text": "Prices that hold for the same term"}}, {"label": "look.steps[1].body", "set_text": {"id": {"component": "6ac7652962cd713ecd056f43", "element": "a45171a4-a190-e258-b94e-9324a4409059"}, "text": "A spot price good for this week and a contract price held for a year do not belong in one ranking. Note how long each quote stands."}}, {"label": "look.steps[2].title", "set_text": {"id": {"component": "6ac7652962cd713ecd056f43", "element": "a45171a4-a190-e258-b94e-9324a440905d"}, "text": "A price you can actually buy at"}}]