[{"label": "next.cards[0].title", "set_text": {"id": {"component": "6ac7652962cd713ecd056f43", "element": "a46337c5-b14f-769e-d3c1-0d4b64144c7a"}, "text": "Compare two packs by the pound"}}, {"label": "next.cards[0].body", "set_text": {"id": {"component": "6ac7652962cd713ecd056f43", "element": "a46337c5-b14f-769e-d3c1-0d4b64144c7d"}, "text": "Put two pack sizes on the same base, per unit and per pound, so a lighter unit cannot pass for a cheaper one."}}, {"label": "next.cards[0].link_label", "set_text": {"id": {"component": "6ac7652962cd713ecd056f43", "element": "a46337c5-b14f-769e-d3c1-0d4b64144c81"}, "text": "Open the unit price calculator"}}, {"label": "next.cards[0].link", "set_link": {"id": {"component": "6ac7652962cd713ecd056f43", "element": "a46337c5-b14f-769e-d3c1-0d4b64144c7f"}, "linkType": "page", "link": "6ac72b948f277e012d8d7584"}}, {"label": "next.cards[1].title", "set_text": {"id": {"component": "6ac7652962cd713ecd056f43", "element": "a46337c5-b14f-769e-d3c1-0d4b64144c87"}, "text": "Report the saving honestly"}}, {"label": "next.cards[1].body", "set_text": {"id": {"component": "6ac7652962cd713ecd056f43", "element": "a46337c5-b14f-769e-d3c1-0d4b64144c8a"}, "text": "Split hard savings from increases you avoided, size both against spend, and see which part reaches the P&L."}}, {"label": "next.cards[1].link_label", "set_text": {"id": {"component": "6ac7652962cd713ecd056f43", "element": "a46337c5-b14f-769e-d3c1-0d4b64144c8e"}, "text": "Open the procurement savings calculator"}}, {"label": "next.cards[1].link", "set_link": {"id": {"component": "6ac7652962cd713ecd056f43", "element": "a46337c5-b14f-769e-d3c1-0d4b64144c8c"}, "linkType": "page", "link": "6ac78670c218082afa38ac6f"}}, {"label": "next.cards[2].title", "set_text": {"id": {"component": "6ac7652962cd713ecd056f43", "element": "a46337c5-b14f-769e-d3c1-0d4b64144c94"}, "text": "Price the case you switched to"}}, {"label": "next.cards[2].body", "set_text": {"id": {"component": "6ac7652962cd713ecd056f43", "element": "a46337c5-b14f-769e-d3c1-0d4b64144c97"}, "text": "Build a case price from freight, handling and shrink, then see what your markup leaves once shrink comes back out."}}, {"label": "next.cards[2].link_label", "set_text": {"id": {"component": "6ac7652962cd713ecd056f43", "element": "a46337c5-b14f-769e-d3c1-0d4b64144c9b"}, "text": "Open the material markup calculator"}}, {"label": "next.cards[2].link", "set_link": {"id": {"component": "6ac7652962cd713ecd056f43", "element": "a46337c5-b14f-769e-d3c1-0d4b64144c99"}, "linkType": "page", "link": "6ac72b95bdfb92fbc692e782"}}]