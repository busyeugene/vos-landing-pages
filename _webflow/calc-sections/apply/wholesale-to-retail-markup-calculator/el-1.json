[{"label": "who.chips[2].label", "set_text": {"id": {"component": "6ac73522edd07accabdbe401", "element": "1cad1503-b8a1-720d-895e-8f7ed14fd273"}, "text": "Brokers pitching a new item"}}, {"label": "who.chips[3].label", "set_text": {"id": {"component": "6ac73522edd07accabdbe401", "element": "1cad1503-b8a1-720d-895e-8f7ed14fd278"}, "text": "DSD reps pricing store routes"}}, {"label": "who.chips[4].label", "set_text": {"id": {"component": "6ac73522edd07accabdbe401", "element": "1cad1503-b8a1-720d-895e-8f7ed14fd27d"}, "text": "Controllers checking gross profit"}}, {"label": "who.chips[5].label", "set_text": {"id": {"component": "6ac73522edd07accabdbe401", "element": "1cad1503-b8a1-720d-895e-8f7ed14fd282"}, "text": "Category managers reviewing lines"}}, {"label": "who.chips[6].label", "set_text": {"id": {"component": "6ac73522edd07accabdbe401", "element": "1cad1503-b8a1-720d-895e-8f7ed14fd287"}, "text": "Teams setting suggested retail prices"}}, {"label": "who.chips[7].label", "set_text": {"id": {"component": "6ac73522edd07accabdbe401", "element": "1cad1503-b8a1-720d-895e-8f7ed14fd28c"}, "text": "Reps answering shelf price pushback"}}, {"label": "who.chips[8].label", "set_text": {"id": {"component": "6ac73522edd07accabdbe401", "element": "1cad1503-b8a1-720d-895e-8f7ed14fd291"}, "text": "Managers comparing retail and foodservice"}}, {"label": "look.h2", "set_text": {"id": {"component": "6ac73522edd07accabdbe401", "element": "2147bfc4-0044-81f3-ce71-89b7aec433ba"}, "text": "What to check before you trust the shelf price"}}, {"label": "look.intro", "set_text": {"id": {"component": "6ac73522edd07accabdbe401", "element": "2147bfc4-0044-81f3-ce71-89b7aec433be"}, "text": "The math in both steps is fixed. Real accounts break it at the inputs, most often in one of these three places."}}, {"label": "look.steps[0].title", "set_text": {"id": {"component": "6ac73522edd07accabdbe401", "element": "2147bfc4-0044-81f3-ce71-89b7aec433c4"}, "text": "Units the store actually prices"}}, {"label": "look.steps[0].body", "set_text": {"id": {"component": "6ac73522edd07accabdbe401", "element": "2147bfc4-0044-81f3-ce71-89b7aec433c8"}, "text": "Count the units the store puts a price on, not the items packed inside. If the items come in twin packs, the store prices half as many units at twice the cost."}}, {"label": "look.steps[1].title", "set_text": {"id": {"component": "6ac73522edd07accabdbe401", "element": "2147bfc4-0044-81f3-ce71-89b7aec433cc"}, "text": "The case price after deals"}}]