[{"label": "look.steps[1].body", "set_text": {"id": {"component": "6ac73522edd07accabdbe401", "element": "2147bfc4-0044-81f3-ce71-89b7aec433d0"}, "text": "If the case carries an off-invoice deal, the store's real cost sits below your list case price. Enter what the buyer actually pays, or the shelf comes out too high."}}, {"label": "look.steps[2].title", "set_text": {"id": {"component": "6ac73522edd07accabdbe401", "element": "2147bfc4-0044-81f3-ce71-89b7aec433d4"}, "text": "The price ending the store uses"}}, {"label": "look.steps[2].body", "set_text": {"id": {"component": "6ac73522edd07accabdbe401", "element": "2147bfc4-0044-81f3-ce71-89b7aec433d8"}, "text": "The calculator sets the shelf on the target margin, to the cent. Stores round to their own price endings, so ask how this one rounds before you defend a case price."}}, {"label": "vos.badge", "set_text": {"id": {"component": "6ac73522edd07accabdbe401", "element": "f2154cbf-2280-14ea-7b62-7ed48e934933"}, "text": "Order Taking"}}, {"label": "vos.h2", "set_text": {"id": {"component": "6ac73522edd07accabdbe401", "element": "f2154cbf-2280-14ea-7b62-7ed48e934934"}, "text": "Where VOS fits next to the markup chain"}}, {"label": "vos.row_badge", "set_text": {"id": {"component": "6ac73522edd07accabdbe401", "element": "f2154cbf-2280-14ea-7b62-7ed48e93493d"}, "text": "Your Reps' Time"}}, {"label": "vos.h3", "set_text": {"id": {"component": "6ac73522edd07accabdbe401", "element": "f2154cbf-2280-14ea-7b62-7ed48e93493e"}, "text": "Reps sell the shelf instead of taking the order"}}, {"label": "vos.body", "set_text": {"id": {"component": "6ac73522edd07accabdbe401", "element": "f2154cbf-2280-14ea-7b62-7ed48e934942"}, "text": "VOS does not calculate markups or shelf prices. It takes the routine order off your reps. Stores order by voice in the VOS app, from their own guide at your case prices."}}, {"label": "vos.bullets[0]", "set_text": {"id": {"component": "6ac73522edd07accabdbe401", "element": "f2154cbf-2280-14ea-7b62-7ed48e934949"}, "text": "Frees sales reps to sell instead of taking orders"}}, {"label": "vos.bullets[1]", "set_text": {"id": {"component": "6ac73522edd07accabdbe401", "element": "f2154cbf-2280-14ea-7b62-7ed48e93494f"}, "text": "20-30 minutes saved on each order versus a phone call"}}, {"label": "vos.bullets[2]", "set_text": {"id": {"component": "6ac73522edd07accabdbe401", "element": "f2154cbf-2280-14ea-7b62-7ed48e934955"}, "text": "Orders arrive confirmed after the customer checks each line"}}, {"label": "vos.bullets[3]", "set_text": {"id": {"component": "6ac73522edd07accabdbe401", "element": "f2154cbf-2280-14ea-7b62-7ed48e93495b"}, "text": "Orders captured 24/7, including after hours"}}]