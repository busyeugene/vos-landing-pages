[{"label": "next.h2", "set_text": {"id": {"component": "6ac73522edd07accabdbe401", "element": "b7f12ec0-6b31-1860-96e6-8572d38c7899"}, "text": "What to run after wholesale to retail markup"}}, {"label": "next.intro", "set_text": {"id": {"component": "6ac73522edd07accabdbe401", "element": "b7f12ec0-6b31-1860-96e6-8572d38c789e"}, "text": "The chain shows where your case lands on the shelf. These three free calculators take each step of it further."}}, {"label": "next.cards[0].title", "set_text": {"id": {"component": "6ac73522edd07accabdbe401", "element": "b7f12ec0-6b31-1860-96e6-8572d38c78a6"}, "text": "Work the store's side on its own"}}, {"label": "next.cards[0].body", "set_text": {"id": {"component": "6ac73522edd07accabdbe401", "element": "b7f12ec0-6b31-1860-96e6-8572d38c78a9"}, "text": "Start from a store's cost and shelf price to see its margin, the markup behind it and the shelf price a target needs."}}, {"label": "next.cards[0].link_label", "set_text": {"id": {"component": "6ac73522edd07accabdbe401", "element": "b7f12ec0-6b31-1860-96e6-8572d38c78ad"}, "text": "Open the retail margin calculator"}}, {"label": "next.cards[0].link", "set_link": {"id": {"component": "6ac73522edd07accabdbe401", "element": "b7f12ec0-6b31-1860-96e6-8572d38c78ab"}, "linkType": "page", "link": "6ac76528743f1f2a6f8ae6e6"}}, {"label": "next.cards[1].title", "set_text": {"id": {"component": "6ac73522edd07accabdbe401", "element": "b7f12ec0-6b31-1860-96e6-8572d38c78b3"}, "text": "See your markup across the book"}}, {"label": "next.cards[1].body", "set_text": {"id": {"component": "6ac73522edd07accabdbe401", "element": "b7f12ec0-6b31-1860-96e6-8572d38c78b6"}, "text": "Take a landed cost up to a wholesale price, then watch low-margin staples pull your blended margin below the quote."}}, {"label": "next.cards[1].link_label", "set_text": {"id": {"component": "6ac73522edd07accabdbe401", "element": "b7f12ec0-6b31-1860-96e6-8572d38c78ba"}, "text": "Open the wholesale markup calculator"}}, {"label": "next.cards[1].link", "set_link": {"id": {"component": "6ac73522edd07accabdbe401", "element": "b7f12ec0-6b31-1860-96e6-8572d38c78b8"}, "linkType": "page", "link": "6ac73521a469d3c306f7aa87"}}, {"label": "next.cards[2].title", "set_text": {"id": {"component": "6ac73522edd07accabdbe401", "element": "b7f12ec0-6b31-1860-96e6-8572d38c78c0"}, "text": "Keep markup and margin apart"}}, {"label": "next.cards[2].body", "set_text": {"id": {"component": "6ac73522edd07accabdbe401", "element": "b7f12ec0-6b31-1860-96e6-8572d38c78c3"}, "text": "Line up price and margin at every markup step, so a markup never gets quoted as if it were the margin."}}]