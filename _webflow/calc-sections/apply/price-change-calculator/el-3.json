[{"label": "next.intro", "set_text": {"id": {"component": "6ac735253fe7317c927e4447", "element": "5be3f14e-566c-dcae-c831-65bd0e907bd5"}, "text": "The breakeven says whether a move can pay. These three free calculators help you decide where the price should sit."}}, {"label": "next.cards[0].title", "set_text": {"id": {"component": "6ac735253fe7317c927e4447", "element": "5be3f14e-566c-dcae-c831-65bd0e907bdd"}, "text": "Rebuild the case price three ways"}}, {"label": "next.cards[0].body", "set_text": {"id": {"component": "6ac735253fe7317c927e4447", "element": "5be3f14e-566c-dcae-c831-65bd0e907be0"}, "text": "Price one case by cost-plus, a target profit and a competitor's price, and see the margin each route leaves."}}, {"label": "next.cards[0].link", "set_link": {"id": {"component": "6ac735253fe7317c927e4447", "element": "5be3f14e-566c-dcae-c831-65bd0e907be2"}, "linkType": "page", "link": "6ac718c668be300e93fb7203"}}, {"label": "next.cards[1].title", "set_text": {"id": {"component": "6ac735253fe7317c927e4447", "element": "5be3f14e-566c-dcae-c831-65bd0e907bea"}, "text": "Find the floor before a cut"}}, {"label": "next.cards[1].body", "set_text": {"id": {"component": "6ac735253fe7317c927e4447", "element": "5be3f14e-566c-dcae-c831-65bd0e907bed"}, "text": "Work out what one more case really costs, including the step cost when new volume needs another truck or route."}}, {"label": "next.cards[1].link_label", "set_text": {"id": {"component": "6ac735253fe7317c927e4447", "element": "5be3f14e-566c-dcae-c831-65bd0e907bf1"}, "text": "Open the marginal cost calculator"}}, {"label": "next.cards[1].link", "set_link": {"id": {"component": "6ac735253fe7317c927e4447", "element": "5be3f14e-566c-dcae-c831-65bd0e907bef"}, "linkType": "page", "link": "6ac69810ef654fbdecf37f4b"}}, {"label": "next.cards[2].title", "set_text": {"id": {"component": "6ac735253fe7317c927e4447", "element": "5be3f14e-566c-dcae-c831-65bd0e907bf7"}, "text": "Check the blend across your book"}}, {"label": "next.cards[2].body", "set_text": {"id": {"component": "6ac735253fe7317c927e4447", "element": "5be3f14e-566c-dcae-c831-65bd0e907bfa"}, "text": "Start from landed cost and see how low-margin staples drag the blended margin below the number you quoted."}}, {"label": "next.cards[2].link_label", "set_text": {"id": {"component": "6ac735253fe7317c927e4447", "element": "5be3f14e-566c-dcae-c831-65bd0e907bfe"}, "text": "Open the wholesale markup calculator"}}, {"label": "next.cards[2].link", "set_link": {"id": {"component": "6ac735253fe7317c927e4447", "element": "5be3f14e-566c-dcae-c831-65bd0e907bfc"}, "linkType": "page", "link": "6ac73521a469d3c306f7aa87"}}]