[{"label": "who.chips[2].label", "set_text": {"id": {"component": "6ac735253fe7317c927e4447", "element": "4e5d306c-6db0-6484-fb73-cc3d0af56f46"}, "text": "Pricing teams planning a raise"}}, {"label": "who.chips[3].label", "set_text": {"id": {"component": "6ac735253fe7317c927e4447", "element": "4e5d306c-6db0-6484-fb73-cc3d0af56f4b"}, "text": "DSD teams repricing a route"}}, {"label": "who.chips[4].label", "set_text": {"id": {"component": "6ac735253fe7317c927e4447", "element": "4e5d306c-6db0-6484-fb73-cc3d0af56f50"}, "text": "Controllers protecting gross profit"}}, {"label": "who.chips[5].label", "set_text": {"id": {"component": "6ac735253fe7317c927e4447", "element": "4e5d306c-6db0-6484-fb73-cc3d0af56f55"}, "text": "Buyers passing on supplier increases"}}, {"label": "who.chips[6].label", "set_text": {"id": {"component": "6ac735253fe7317c927e4447", "element": "4e5d306c-6db0-6484-fb73-cc3d0af56f5a"}, "text": "Reps defending a new price"}}, {"label": "who.chips[7].label", "set_text": {"id": {"component": "6ac735253fe7317c927e4447", "element": "4e5d306c-6db0-6484-fb73-cc3d0af56f5f"}, "text": "Managers asked to match competitors"}}, {"label": "who.chips[8].label", "set_text": {"id": {"component": "6ac735253fe7317c927e4447", "element": "4e5d306c-6db0-6484-fb73-cc3d0af56f64"}, "text": "Analysts comparing raise and cut"}}, {"label": "look.h2", "set_text": {"id": {"component": "6ac735253fe7317c927e4447", "element": "0ba30408-a9d4-a9f6-2bad-9a108b7ba940"}, "text": "What to look for before you trust the breakeven"}}, {"label": "look.intro", "set_text": {"id": {"component": "6ac735253fe7317c927e4447", "element": "0ba30408-a9d4-a9f6-2bad-9a108b7ba944"}, "text": "The ratio itself is exact. The inputs behind it are where a price decision goes wrong, usually in one of these three."}}, {"label": "look.steps[0].title", "set_text": {"id": {"component": "6ac735253fe7317c927e4447", "element": "0ba30408-a9d4-a9f6-2bad-9a108b7ba94a"}, "text": "A cost per case that is current"}}, {"label": "look.steps[0].body", "set_text": {"id": {"component": "6ac735253fe7317c927e4447", "element": "0ba30408-a9d4-a9f6-2bad-9a108b7ba94e"}, "text": "Enter what the case costs you today, freight in, not last quarter's invoice. An old cost makes the contribution look bigger or smaller than it really is."}}, {"label": "look.steps[1].title", "set_text": {"id": {"component": "6ac735253fe7317c927e4447", "element": "0ba30408-a9d4-a9f6-2bad-9a108b7ba952"}, "text": "The price accounts actually pay"}}]