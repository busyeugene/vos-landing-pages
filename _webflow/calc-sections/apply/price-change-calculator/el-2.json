[{"label": "look.steps[1].body", "set_text": {"id": {"component": "6ac735253fe7317c927e4447", "element": "0ba30408-a9d4-a9f6-2bad-9a108b7ba956"}, "text": "Start from the net price after rebates, deals and contract discounts, not the list. A raise worked off a list price nobody pays tells you very little."}}, {"label": "look.steps[2].title", "set_text": {"id": {"component": "6ac735253fe7317c927e4447", "element": "0ba30408-a9d4-a9f6-2bad-9a108b7ba95a"}, "text": "A month that is typical"}}, {"label": "look.steps[2].body", "set_text": {"id": {"component": "6ac735253fe7317c927e4447", "element": "0ba30408-a9d4-a9f6-2bad-9a108b7ba95e"}, "text": "The monthly dollars use the case count you type in. Take it from a normal month, not a holiday peak or a slow stretch, or the swing reads wrong."}}, {"label": "vos.badge", "set_text": {"id": {"component": "6ac735253fe7317c927e4447", "element": "c1f2fed8-cb94-6cd6-65f0-d5eb5837aa88"}, "text": "Order History"}}, {"label": "vos.h2", "set_text": {"id": {"component": "6ac735253fe7317c927e4447", "element": "c1f2fed8-cb94-6cd6-65f0-d5eb5837aa89"}, "text": "Where VOS fits after a price move"}}, {"label": "vos.row_badge", "set_text": {"id": {"component": "6ac735253fe7317c927e4447", "element": "c1f2fed8-cb94-6cd6-65f0-d5eb5837aa92"}, "text": "Volume After the Move"}}, {"label": "vos.h3", "set_text": {"id": {"component": "6ac735253fe7317c927e4447", "element": "c1f2fed8-cb94-6cd6-65f0-d5eb5837aa93"}, "text": "See which accounts kept ordering"}}, {"label": "vos.body", "set_text": {"id": {"component": "6ac735253fe7317c927e4447", "element": "c1f2fed8-cb94-6cd6-65f0-d5eb5837aa97"}, "text": "VOS does not set prices or work out the breakeven. It helps with the check that comes after. Orders from the VOS app build each account's order history, which you see in one admin platform."}}, {"label": "vos.bullets[0]", "set_text": {"id": {"component": "6ac735253fe7317c927e4447", "element": "c1f2fed8-cb94-6cd6-65f0-d5eb5837aa9e"}, "text": "Order history per account, to check volume after a move"}}, {"label": "vos.bullets[1]", "set_text": {"id": {"component": "6ac735253fe7317c927e4447", "element": "c1f2fed8-cb94-6cd6-65f0-d5eb5837aaa4"}, "text": "Each account's guide carries the prices you set"}}, {"label": "vos.bullets[2]", "set_text": {"id": {"component": "6ac735253fe7317c927e4447", "element": "c1f2fed8-cb94-6cd6-65f0-d5eb5837aaaa"}, "text": "Each app order has a number, date and timestamp"}}, {"label": "next.h2", "set_text": {"id": {"component": "6ac735253fe7317c927e4447", "element": "5be3f14e-566c-dcae-c831-65bd0e907bd0"}, "text": "What to run after a price change"}}]