[{"label": "look.steps[2].title", "set_text": {"id": {"component": "6ac7652b0d7b366d7fd65177", "element": "2e5da571-744f-72b1-f8e2-538647914913"}, "text": "Miles from yard to yard"}}, {"label": "look.steps[2].body", "set_text": {"id": {"component": "6ac7652b0d7b366d7fd65177", "element": "2e5da571-744f-72b1-f8e2-538647914917"}, "text": "Use odometer miles for the whole day, out and back. Distance between stops on a map leaves out the run to the first drop and home again."}}, {"label": "vos.badge", "set_text": {"id": {"component": "6ac7652b0d7b366d7fd65177", "element": "a68ebfd4-23e2-b939-0670-d77a42b014ab"}, "text": "Order Timing"}}, {"label": "vos.h2", "set_text": {"id": {"component": "6ac7652b0d7b366d7fd65177", "element": "a68ebfd4-23e2-b939-0670-d77a42b014ac"}, "text": "Where VOS sits before the route leaves"}}, {"label": "vos.row_badge", "set_text": {"id": {"component": "6ac7652b0d7b366d7fd65177", "element": "a68ebfd4-23e2-b939-0670-d77a42b014b5"}, "text": "Your Route Day"}}, {"label": "vos.h3", "set_text": {"id": {"component": "6ac7652b0d7b366d7fd65177", "element": "a68ebfd4-23e2-b939-0670-d77a42b014b6"}, "text": "Orders can land before the route is built"}}, {"label": "vos.body", "set_text": {"id": {"component": "6ac7652b0d7b366d7fd65177", "element": "a68ebfd4-23e2-b939-0670-d77a42b014ba"}, "text": "VOS does not plan routes, dispatch trucks or track deliveries. It works a step earlier. Customers order by voice in the VOS app, 24/7, and after-hours orders are in before the truck is loaded."}}, {"label": "vos.bullets[0]", "set_text": {"id": {"component": "6ac7652b0d7b366d7fd65177", "element": "a68ebfd4-23e2-b939-0670-d77a42b014c1"}, "text": "Customers order 24/7, after hours included"}}, {"label": "vos.bullets[1]", "set_text": {"id": {"component": "6ac7652b0d7b366d7fd65177", "element": "a68ebfd4-23e2-b939-0670-d77a42b014c7"}, "text": "Each line reviewed by the customer before it is sent"}}, {"label": "vos.bullets[2]", "set_text": {"id": {"component": "6ac7652b0d7b366d7fd65177", "element": "a68ebfd4-23e2-b939-0670-d77a42b014cd"}, "text": "For DSD, drivers show up with the right product"}}, {"label": "vos.bullets[3]", "set_text": {"id": {"component": "6ac7652b0d7b366d7fd65177", "element": "a68ebfd4-23e2-b939-0670-d77a42b014d3"}, "text": "20-30 minutes saved per order compared with a phone order"}}, {"label": "next.h2", "set_text": {"id": {"component": "6ac7652b0d7b366d7fd65177", "element": "7e543664-f5a0-6411-93af-9782a78eaf2c"}, "text": "What to run after cost per delivery"}}]