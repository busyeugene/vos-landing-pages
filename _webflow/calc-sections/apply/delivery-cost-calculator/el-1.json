[{"label": "who.chips[3].label", "set_text": {"id": {"component": "6ac7652b0d7b366d7fd65177", "element": "9ff09b7f-3b26-144e-2ee7-60621f6b1c99"}, "text": "Transport managers costing a route"}}, {"label": "who.chips[4].label", "set_text": {"id": {"component": "6ac7652b0d7b366d7fd65177", "element": "9ff09b7f-3b26-144e-2ee7-60621f6b1c9e"}, "text": "Controllers budgeting the fleet"}}, {"label": "who.chips[5].label", "set_text": {"id": {"component": "6ac7652b0d7b366d7fd65177", "element": "9ff09b7f-3b26-144e-2ee7-60621f6b1ca3"}, "text": "DSD teams setting visit frequency"}}, {"label": "who.chips[6].label", "set_text": {"id": {"component": "6ac7652b0d7b366d7fd65177", "element": "9ff09b7f-3b26-144e-2ee7-60621f6b1ca8"}, "text": "Owners pricing delivery fees"}}, {"label": "who.chips[7].label", "set_text": {"id": {"component": "6ac7652b0d7b366d7fd65177", "element": "9ff09b7f-3b26-144e-2ee7-60621f6b1cad"}, "text": "Ops reviewing light drops"}}, {"label": "who.chips[8].label", "set_text": {"id": {"component": "6ac7652b0d7b366d7fd65177", "element": "9ff09b7f-3b26-144e-2ee7-60621f6b1cb2"}, "text": "Teams comparing two routes"}}, {"label": "look.h2", "set_text": {"id": {"component": "6ac7652b0d7b366d7fd65177", "element": "2e5da571-744f-72b1-f8e2-5386479148f9"}, "text": "What to check before you trust the drop cost"}}, {"label": "look.intro", "set_text": {"id": {"component": "6ac7652b0d7b366d7fd65177", "element": "2e5da571-744f-72b1-f8e2-5386479148fd"}, "text": "Driver cost is most of the day, so two of these checks start with the driver. The third is the miles."}}, {"label": "look.steps[0].title", "set_text": {"id": {"component": "6ac7652b0d7b366d7fd65177", "element": "2e5da571-744f-72b1-f8e2-538647914903"}, "text": "Hours from the timesheet"}}, {"label": "look.steps[0].body", "set_text": {"id": {"component": "6ac7652b0d7b366d7fd65177", "element": "2e5da571-744f-72b1-f8e2-538647914907"}, "text": "Enter the hours the driver is paid, clock in to clock out, not just time on the road. If overtime is regular, build it into the hourly rate."}}, {"label": "look.steps[1].title", "set_text": {"id": {"component": "6ac7652b0d7b366d7fd65177", "element": "2e5da571-744f-72b1-f8e2-53864791490b"}, "text": "A wage with the extras on"}}, {"label": "look.steps[1].body", "set_text": {"id": {"component": "6ac7652b0d7b366d7fd65177", "element": "2e5da571-744f-72b1-f8e2-53864791490f"}, "text": "$28.00 should carry payroll taxes, benefits and insurance, not just the pay rate. A bare wage makes every drop look cheaper than it is."}}]