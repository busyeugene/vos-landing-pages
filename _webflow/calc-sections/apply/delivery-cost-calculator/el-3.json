[{"label": "next.intro", "set_text": {"id": {"component": "6ac7652b0d7b366d7fd65177", "element": "7e543664-f5a0-6411-93af-9782a78eaf31"}, "text": "A drop cost prices one stop. These three follow it to the next case, the building the cases ship from, and what they cost to bring in."}}, {"label": "next.cards[0].title", "set_text": {"id": {"component": "6ac7652b0d7b366d7fd65177", "element": "7e543664-f5a0-6411-93af-9782a78eaf39"}, "text": "Find the cost of the next case"}}, {"label": "next.cards[0].body", "set_text": {"id": {"component": "6ac7652b0d7b366d7fd65177", "element": "7e543664-f5a0-6411-93af-9782a78eaf3c"}, "text": "Find what one more case really costs, including the step cost when new volume needs another truck or route."}}, {"label": "next.cards[0].link_label", "set_text": {"id": {"component": "6ac7652b0d7b366d7fd65177", "element": "7e543664-f5a0-6411-93af-9782a78eaf40"}, "text": "Open the marginal cost calculator"}}, {"label": "next.cards[0].link", "set_link": {"id": {"component": "6ac7652b0d7b366d7fd65177", "element": "7e543664-f5a0-6411-93af-9782a78eaf3e"}, "linkType": "page", "link": "6ac69810ef654fbdecf37f4b"}}, {"label": "next.cards[1].title", "set_text": {"id": {"component": "6ac7652b0d7b366d7fd65177", "element": "7e543664-f5a0-6411-93af-9782a78eaf46"}, "text": "See what your warehouse can hold"}}, {"label": "next.cards[1].body", "set_text": {"id": {"component": "6ac7652b0d7b366d7fd65177", "element": "7e543664-f5a0-6411-93af-9782a78eaf49"}, "text": "Count how many cases your building holds once aisles and dock are out, and the weeks of flow that covers."}}, {"label": "next.cards[1].link_label", "set_text": {"id": {"component": "6ac7652b0d7b366d7fd65177", "element": "7e543664-f5a0-6411-93af-9782a78eaf4d"}, "text": "Open the warehouse size calculator"}}, {"label": "next.cards[1].link", "set_link": {"id": {"component": "6ac7652b0d7b366d7fd65177", "element": "7e543664-f5a0-6411-93af-9782a78eaf4b"}, "linkType": "page", "link": "6ac72b9663b2850d53a5f878"}}, {"label": "next.cards[2].title", "set_text": {"id": {"component": "6ac7652b0d7b366d7fd65177", "element": "7e543664-f5a0-6411-93af-9782a78eaf53"}, "text": "Cost what comes in, freight and all"}}, {"label": "next.cards[2].body", "set_text": {"id": {"component": "6ac7652b0d7b366d7fd65177", "element": "7e543664-f5a0-6411-93af-9782a78eaf56"}, "text": "Rank three supplier quotes on landed cost per unit, with freight counted, not the case price alone."}}, {"label": "next.cards[2].link_label", "set_text": {"id": {"component": "6ac7652b0d7b366d7fd65177", "element": "7e543664-f5a0-6411-93af-9782a78eaf5a"}, "text": "Open the landed cost calculator"}}]