[{"label": "who.chips[4].label", "set_text": {"id": {"component": "6ac79be1b863c26cbc96979a", "element": "65760273-35d1-a316-632e-d288d3495875"}, "text": "Controllers checking cash in stock"}}, {"label": "who.chips[5].label", "set_text": {"id": {"component": "6ac79be1b863c26cbc96979a", "element": "65760273-35d1-a316-632e-d288d349587a"}, "text": "Purchasing teams running weekly restocks"}}, {"label": "who.chips[6].label", "set_text": {"id": {"component": "6ac79be1b863c26cbc96979a", "element": "65760273-35d1-a316-632e-d288d349587f"}, "text": "Product managers costing new lines"}}, {"label": "who.chips[7].label", "set_text": {"id": {"component": "6ac79be1b863c26cbc96979a", "element": "65760273-35d1-a316-632e-d288d3495884"}, "text": "Warehouse leads trimming over par"}}, {"label": "who.chips[8].label", "set_text": {"id": {"component": "6ac79be1b863c26cbc96979a", "element": "65760273-35d1-a316-632e-d288d3495889"}, "text": "Analysts comparing par across suppliers"}}, {"label": "look.h2", "set_text": {"id": {"component": "6ac79be1b863c26cbc96979a", "element": "9b08a41b-99dd-8d29-bba3-578c0a69511d"}, "text": "What to look for before you trust the level"}}, {"label": "look.intro", "set_text": {"id": {"component": "6ac79be1b863c26cbc96979a", "element": "9b08a41b-99dd-8d29-bba3-578c0a695121"}, "text": "Par is one multiplication. The count and the days you feed it are where a top up goes wrong. Check these three first."}}, {"label": "look.steps[0].title", "set_text": {"id": {"component": "6ac79be1b863c26cbc96979a", "element": "9b08a41b-99dd-8d29-bba3-578c0a695127"}, "text": "A count of what can sell"}}, {"label": "look.steps[0].body", "set_text": {"id": {"component": "6ac79be1b863c26cbc96979a", "element": "9b08a41b-99dd-8d29-bba3-578c0a69512b"}, "text": "Leave damaged and short dated cases out of the 340 on hand. Count them in and the 740 case top up comes in short."}}, {"label": "look.steps[1].title", "set_text": {"id": {"component": "6ac79be1b863c26cbc96979a", "element": "9b08a41b-99dd-8d29-bba3-578c0a69512f"}, "text": "Days on the same footing"}}, {"label": "look.steps[1].body", "set_text": {"id": {"component": "6ac79be1b863c26cbc96979a", "element": "9b08a41b-99dd-8d29-bba3-578c0a695133"}, "text": "If 120 cases a day is per shipping day, count the cycle in shipping days too. Mix shipping days with calendar days and par reads high."}}, {"label": "look.steps[2].title", "set_text": {"id": {"component": "6ac79be1b863c26cbc96979a", "element": "9b08a41b-99dd-8d29-bba3-578c0a695137"}, "text": "How your supplier ships"}}]