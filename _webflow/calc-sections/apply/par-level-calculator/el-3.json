[{"label": "next.cards[0].title", "set_text": {"id": {"component": "6ac79be1b863c26cbc96979a", "element": "cf7f75ca-d90a-63ba-c432-76bcff8f9bad"}, "text": "Decide when the order goes in"}}, {"label": "next.cards[0].body", "set_text": {"id": {"component": "6ac79be1b863c26cbc96979a", "element": "cf7f75ca-d90a-63ba-c432-76bcff8f9bb0"}, "text": "Find the stock level that should start the next order, the days of cover left, and what a late supplier costs in cases."}}, {"label": "next.cards[0].link_label", "set_text": {"id": {"component": "6ac79be1b863c26cbc96979a", "element": "cf7f75ca-d90a-63ba-c432-76bcff8f9bb4"}, "text": "Open the reorder point calculator"}}, {"label": "next.cards[0].link", "set_link": {"id": {"component": "6ac79be1b863c26cbc96979a", "element": "cf7f75ca-d90a-63ba-c432-76bcff8f9bb2"}, "linkType": "page", "link": "6ac7652a2a715d3e702a0559"}}, {"label": "next.cards[1].title", "set_text": {"id": {"component": "6ac79be1b863c26cbc96979a", "element": "cf7f75ca-d90a-63ba-c432-76bcff8f9bba"}, "text": "Size the reserve from real swings"}}, {"label": "next.cards[1].body", "set_text": {"id": {"component": "6ac79be1b863c26cbc96979a", "element": "cf7f75ca-d90a-63ba-c432-76bcff8f9bbd"}, "text": "Turn how much your demand and lead times move into a buffer, at a service level you choose, checked against shelf life."}}, {"label": "next.cards[1].link_label", "set_text": {"id": {"component": "6ac79be1b863c26cbc96979a", "element": "cf7f75ca-d90a-63ba-c432-76bcff8f9bc1"}, "text": "Open the safety stock calculator"}}, {"label": "next.cards[1].link", "set_link": {"id": {"component": "6ac79be1b863c26cbc96979a", "element": "cf7f75ca-d90a-63ba-c432-76bcff8f9bbf"}, "linkType": "page", "link": "6ac735249b6f12d26ba60ce1"}}, {"label": "next.cards[2].title", "set_text": {"id": {"component": "6ac79be1b863c26cbc96979a", "element": "cf7f75ca-d90a-63ba-c432-76bcff8f9bc7"}, "text": "Price the stock par keeps on hand"}}, {"label": "next.cards[2].body", "set_text": {"id": {"component": "6ac79be1b863c26cbc96979a", "element": "cf7f75ca-d90a-63ba-c432-76bcff8f9bca"}, "text": "Build a carrying rate from capital, storage, spoilage, insurance and obsolescence, then read what holding stock costs a year."}}, {"label": "next.cards[2].link_label", "set_text": {"id": {"component": "6ac79be1b863c26cbc96979a", "element": "cf7f75ca-d90a-63ba-c432-76bcff8f9bce"}, "text": "Open the inventory carrying cost calculator"}}, {"label": "next.cards[2].link", "set_link": {"id": {"component": "6ac79be1b863c26cbc96979a", "element": "cf7f75ca-d90a-63ba-c432-76bcff8f9bcc"}, "linkType": "page", "link": "6ac7866e071fb41c4807eab0"}}]