[{"label": "who.chips[6].alt.image", "set_image_asset": {"id": {"component": "6ac79be1b863c26cbc96979a", "element": "65760273-35d1-a316-632e-d288d349587d"}, "image_asset_id": "6ad07a8636601c73ce216e84"}}, {"label": "who.chips[7].alt.image", "set_image_asset": {"id": {"component": "6ac79be1b863c26cbc96979a", "element": "65760273-35d1-a316-632e-d288d3495882"}, "image_asset_id": "6ac71ff1d74c17b09757a391"}}, {"label": "who.chips[8].alt.image", "set_image_asset": {"id": {"component": "6ac79be1b863c26cbc96979a", "element": "65760273-35d1-a316-632e-d288d3495887"}, "image_asset_id": "6ad07a8b1207c22da70d53ca"}}, {"label": "look.h2", "set_text": {"id": {"component": "6ac79be1b863c26cbc96979a", "element": "9b08a41b-99dd-8d29-bba3-578c0a69511d"}, "text": "When a par level comes out wrong"}}, {"label": "look.intro", "set_text": {"id": {"component": "6ac79be1b863c26cbc96979a", "element": "9b08a41b-99dd-8d29-bba3-578c0a695121"}, "text": "Par is one multiplication. The count, the days and the way your supplier ships are where a top up goes wrong."}}, {"label": "vos.body", "set_text": {"id": {"component": "6ac79be1b863c26cbc96979a", "element": "7bbeccd7-8104-415c-1a64-593884f5b813"}, "text": "VOS does not set par levels, count your stock or buy from your suppliers. Par is set line by line, and that is how orders reach you. Each account orders by voice in the VOS app, from a guide tied to your SKUs."}}, {"label": "next.cards[0].alt.image", "set_image_asset": {"id": {"component": "6ac79be1b863c26cbc96979a", "element": "cf7f75ca-d90a-63ba-c432-76bcff8f9baa"}, "image_asset_id": "6ad07a86f43d7bfc43f824d1"}}, {"label": "next.cards[1].alt.image", "set_image_asset": {"id": {"component": "6ac79be1b863c26cbc96979a", "element": "cf7f75ca-d90a-63ba-c432-76bcff8f9bb7"}, "image_asset_id": "6ad07a8582b4c538b5789ee3"}}, {"label": "next.cards[2].body", "set_text": {"id": {"component": "6ac79be1b863c26cbc96979a", "element": "cf7f75ca-d90a-63ba-c432-76bcff8f9bca"}, "text": "See what holding that stock costs a year, at a rate built from your own capital, space and spoilage figures."}}, {"label": "next.cards[2].alt.image", "set_image_asset": {"id": {"component": "6ac79be1b863c26cbc96979a", "element": "cf7f75ca-d90a-63ba-c432-76bcff8f9bc4"}, "image_asset_id": "6ac71fed026c60b59b375bd5"}}]