[{"label": "who.chips[2].label", "set_text": {"id": {"component": "6ac72b9663b2850d53a5f878", "element": "71865604-aa9d-cbb6-ff09-ea16a7613ebc"}, "text": "Owners planning next year's volume"}}, {"label": "who.chips[3].label", "set_text": {"id": {"component": "6ac72b9663b2850d53a5f878", "element": "71865604-aa9d-cbb6-ff09-ea16a7613ec1"}, "text": "Receiving leads booking inbound loads"}}, {"label": "who.chips[4].label", "set_text": {"id": {"component": "6ac72b9663b2850d53a5f878", "element": "71865604-aa9d-cbb6-ff09-ea16a7613ec6"}, "text": "Buyers taking a bulk deal"}}, {"label": "who.chips[5].label", "set_text": {"id": {"component": "6ac72b9663b2850d53a5f878", "element": "71865604-aa9d-cbb6-ff09-ea16a7613ecb"}, "text": "Ops planning a re-rack"}}, {"label": "who.chips[6].label", "set_text": {"id": {"component": "6ac72b9663b2850d53a5f878", "element": "71865604-aa9d-cbb6-ff09-ea16a7613ed0"}, "text": "Buyers sizing a promo buy"}}, {"label": "who.chips[7].label", "set_text": {"id": {"component": "6ac72b9663b2850d53a5f878", "element": "71865604-aa9d-cbb6-ff09-ea16a7613ed5"}, "text": "Managers trimming slow lines"}}, {"label": "who.chips[8].label", "set_text": {"id": {"component": "6ac72b9663b2850d53a5f878", "element": "71865604-aa9d-cbb6-ff09-ea16a7613eda"}, "text": "Owners comparing two layouts"}}, {"label": "look.h2", "set_text": {"id": {"component": "6ac72b9663b2850d53a5f878", "element": "6c238dfc-ff26-185d-53be-b38ac2279bc6"}, "text": "What to check before you trust the capacity"}}, {"label": "look.intro", "set_text": {"id": {"component": "6ac72b9663b2850d53a5f878", "element": "6c238dfc-ff26-185d-53be-b38ac2279bca"}, "text": "Capacity is only as true as the building figure and the flow you enter. Check these three before a buyer plans against it."}}, {"label": "look.steps[0].title", "set_text": {"id": {"component": "6ac72b9663b2850d53a5f878", "element": "6c238dfc-ff26-185d-53be-b38ac2279bd0"}, "text": "The floor, not the lease"}}, {"label": "look.steps[0].body", "set_text": {"id": {"component": "6ac72b9663b2850d53a5f878", "element": "6c238dfc-ff26-185d-53be-b38ac2279bd4"}, "text": "A lease can measure to the outside of the walls, so measure the floor itself before you enter 3,000. Leave the office in it: the 55% usable share already takes the office out."}}, {"label": "look.steps[1].title", "set_text": {"id": {"component": "6ac72b9663b2850d53a5f878", "element": "6c238dfc-ff26-185d-53be-b38ac2279bd8"}, "text": "Cases a pallet across the range"}}]