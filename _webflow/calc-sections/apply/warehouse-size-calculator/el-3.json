[{"label": "next.h2", "set_text": {"id": {"component": "6ac72b9663b2850d53a5f878", "element": "b9d7d1a5-e2bc-2853-1b64-62b20385073f"}, "text": "What to run after warehouse capacity"}}, {"label": "next.intro", "set_text": {"id": {"component": "6ac72b9663b2850d53a5f878", "element": "b9d7d1a5-e2bc-2853-1b64-62b203850744"}, "text": "You know what the building holds. These three size what your stock needs, how long it sits, and what each route costs to run."}}, {"label": "next.cards[0].title", "set_text": {"id": {"component": "6ac72b9663b2850d53a5f878", "element": "b9d7d1a5-e2bc-2853-1b64-62b20385074c"}, "text": "Size the floor your stock needs"}}, {"label": "next.cards[0].body", "set_text": {"id": {"component": "6ac72b9663b2850d53a5f878", "element": "b9d7d1a5-e2bc-2853-1b64-62b20385074f"}, "text": "Work out the square feet your inventory needs once aisles, dock and staging are counted, and what stacking higher saves."}}, {"label": "next.cards[0].link_label", "set_text": {"id": {"component": "6ac72b9663b2850d53a5f878", "element": "b9d7d1a5-e2bc-2853-1b64-62b203850753"}, "text": "Open the warehouse space calculator"}}, {"label": "next.cards[0].link", "set_link": {"id": {"component": "6ac72b9663b2850d53a5f878", "element": "b9d7d1a5-e2bc-2853-1b64-62b203850751"}, "linkType": "page", "link": "6ac735232408756f9071e095"}}, {"label": "next.cards[1].title", "set_text": {"id": {"component": "6ac72b9663b2850d53a5f878", "element": "b9d7d1a5-e2bc-2853-1b64-62b203850759"}, "text": "Check how long a case sits"}}, {"label": "next.cards[1].body", "set_text": {"id": {"component": "6ac72b9663b2850d53a5f878", "element": "b9d7d1a5-e2bc-2853-1b64-62b20385075c"}, "text": "See how many times a year you turn stock, and the cash a slow turn keeps tied up."}}, {"label": "next.cards[1].link_label", "set_text": {"id": {"component": "6ac72b9663b2850d53a5f878", "element": "b9d7d1a5-e2bc-2853-1b64-62b203850760"}, "text": "Open the inventory turnover calculator"}}, {"label": "next.cards[1].link", "set_link": {"id": {"component": "6ac72b9663b2850d53a5f878", "element": "b9d7d1a5-e2bc-2853-1b64-62b20385075e"}, "linkType": "page", "link": "6ac7252ae188e18d1d906bba"}}, {"label": "next.cards[2].title", "set_text": {"id": {"component": "6ac72b9663b2850d53a5f878", "element": "b9d7d1a5-e2bc-2853-1b64-62b203850766"}, "text": "Cost the routes that empty it"}}, {"label": "next.cards[2].body", "set_text": {"id": {"component": "6ac72b9663b2850d53a5f878", "element": "b9d7d1a5-e2bc-2853-1b64-62b203850769"}, "text": "Break a route into cost per drop, per case and per mile, and see where a delivery minimum belongs."}}]