[{"label": "who.chips[7].alt.image", "set_image_asset": {"id": {"component": "6ac7866c27806c8148c2855e", "element": "689f4c43-f40c-f3f5-68ac-8521c5296fd3"}, "image_asset_id": "6ad07a8a27aa3ab4d513d988"}}, {"label": "who.chips[8].alt.image", "set_image_asset": {"id": {"component": "6ac7866c27806c8148c2855e", "element": "689f4c43-f40c-f3f5-68ac-8521c5296fd8"}, "image_asset_id": "6ad07a8b1207c22da70d53ca"}}, {"label": "look.h2", "set_text": {"id": {"component": "6ac7866c27806c8148c2855e", "element": "1635d733-8e70-4e26-f8fd-83ecb36e959b"}, "text": "Make the price variance compare like with like"}}, {"label": "vos.body", "set_text": {"id": {"component": "6ac7866c27806c8148c2855e", "element": "9d1ac7fb-6734-e13d-2209-b29ed6a897a5"}, "text": "VOS does not read supplier invoices or calculate variance. It covers the same items on the way out, as customer orders. Each one placed in the VOS app reaches you by email, EDI, API or QuickBooks."}}, {"label": "next.cards[0].alt.image", "set_image_asset": {"id": {"component": "6ac7866c27806c8148c2855e", "element": "ba2e353b-78d9-acaf-2db8-8584d0f95eb5"}, "image_asset_id": "6ad07a86f43d7bfc43f824d1"}}, {"label": "next.cards[1].body", "set_text": {"id": {"component": "6ac7866c27806c8148c2855e", "element": "ba2e353b-78d9-acaf-2db8-8584d0f95ec8"}, "text": "Weigh three supplier offers unit by unit, freight in, before the next standard price is set."}}, {"label": "next.cards[1].alt.image", "set_image_asset": {"id": {"component": "6ac7866c27806c8148c2855e", "element": "ba2e353b-78d9-acaf-2db8-8584d0f95ec2"}, "image_asset_id": "6ad07a8582b4c538b5789ee3"}}, {"label": "next.cards[2].alt.image", "set_image_asset": {"id": {"component": "6ac7866c27806c8148c2855e", "element": "ba2e353b-78d9-acaf-2db8-8584d0f95ecf"}, "image_asset_id": "6ac71f2edacb5c302d9d5cab"}}]