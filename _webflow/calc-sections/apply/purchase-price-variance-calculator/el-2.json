[{"label": "look.steps[2].title", "set_text": {"id": {"component": "6ac7866c27806c8148c2855e", "element": "1635d733-8e70-4e26-f8fd-83ecb36e95b5"}, "text": "Supplier item codes matched to yours"}}, {"label": "look.steps[2].body", "set_text": {"id": {"component": "6ac7866c27806c8148c2855e", "element": "1635d733-8e70-4e26-f8fd-83ecb36e95b9"}, "text": "A supplier that renumbers an item can make it look new, with no standard at all. Match their item code to your own before you compare."}}, {"label": "vos.badge", "set_text": {"id": {"component": "6ac7866c27806c8148c2855e", "element": "9d1ac7fb-6734-e13d-2209-b29ed6a89796"}, "text": "Order Formats"}}, {"label": "vos.h2", "set_text": {"id": {"component": "6ac7866c27806c8148c2855e", "element": "9d1ac7fb-6734-e13d-2209-b29ed6a89797"}, "text": "Where VOS fits next to purchase price variance"}}, {"label": "vos.row_badge", "set_text": {"id": {"component": "6ac7866c27806c8148c2855e", "element": "9d1ac7fb-6734-e13d-2209-b29ed6a897a0"}, "text": "Your Selling Side"}}, {"label": "vos.h3", "set_text": {"id": {"component": "6ac7866c27806c8148c2855e", "element": "9d1ac7fb-6734-e13d-2209-b29ed6a897a1"}, "text": "Customer orders arrive in a format you already use"}}, {"label": "vos.body", "set_text": {"id": {"component": "6ac7866c27806c8148c2855e", "element": "9d1ac7fb-6734-e13d-2209-b29ed6a897a5"}, "text": "VOS does not read supplier invoices or calculate variance. It works on the selling side of the same items. Customer orders from the VOS app reach you by email, EDI, API or QuickBooks."}}, {"label": "vos.bullets[0]", "set_text": {"id": {"component": "6ac7866c27806c8148c2855e", "element": "9d1ac7fb-6734-e13d-2209-b29ed6a897ac"}, "text": "PDF, Excel or Word by email to a rep or purchasing team"}}, {"label": "vos.bullets[1]", "set_text": {"id": {"component": "6ac7866c27806c8148c2855e", "element": "9d1ac7fb-6734-e13d-2209-b29ed6a897b2"}, "text": "Each account orders at the prices you set"}}, {"label": "vos.bullets[2]", "set_text": {"id": {"component": "6ac7866c27806c8148c2855e", "element": "9d1ac7fb-6734-e13d-2209-b29ed6a897b8"}, "text": "Guide prices updated from one admin platform"}}, {"label": "vos.bullets[3]", "set_text": {"id": {"component": "6ac7866c27806c8148c2855e", "element": "9d1ac7fb-6734-e13d-2209-b29ed6a897be"}, "text": "Works alongside your ERP, with nothing to rip out"}}, {"label": "next.h2", "set_text": {"id": {"component": "6ac7866c27806c8148c2855e", "element": "ba2e353b-78d9-acaf-2db8-8584d0f95eab"}, "text": "What to run after purchase price variance"}}]