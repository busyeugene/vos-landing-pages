[{"label": "next.intro", "set_text": {"id": {"component": "6ac7866c27806c8148c2855e", "element": "ba2e353b-78d9-acaf-2db8-8584d0f95eb0"}, "text": "The variance tells you what a price cost you. These three free calculators look at savings, freight and the terms you pay on."}}, {"label": "next.cards[0].title", "set_text": {"id": {"component": "6ac7866c27806c8148c2855e", "element": "ba2e353b-78d9-acaf-2db8-8584d0f95eb8"}, "text": "Separate real savings from avoided ones"}}, {"label": "next.cards[0].body", "set_text": {"id": {"component": "6ac7866c27806c8148c2855e", "element": "ba2e353b-78d9-acaf-2db8-8584d0f95ebb"}, "text": "See which part of a reported saving reaches the P&L, with hard savings kept apart from the increases you avoided."}}, {"label": "next.cards[0].link_label", "set_text": {"id": {"component": "6ac7866c27806c8148c2855e", "element": "ba2e353b-78d9-acaf-2db8-8584d0f95ebf"}, "text": "Open the procurement savings calculator"}}, {"label": "next.cards[0].link", "set_link": {"id": {"component": "6ac7866c27806c8148c2855e", "element": "ba2e353b-78d9-acaf-2db8-8584d0f95ebd"}, "linkType": "page", "link": "6ac78670c218082afa38ac6f"}}, {"label": "next.cards[1].title", "set_text": {"id": {"component": "6ac7866c27806c8148c2855e", "element": "ba2e353b-78d9-acaf-2db8-8584d0f95ec5"}, "text": "Rank offers with freight counted"}}, {"label": "next.cards[1].body", "set_text": {"id": {"component": "6ac7866c27806c8148c2855e", "element": "ba2e353b-78d9-acaf-2db8-8584d0f95ec8"}, "text": "Compare three supplier quotes on landed cost per unit, freight in, before you set the next standard price."}}, {"label": "next.cards[1].link_label", "set_text": {"id": {"component": "6ac7866c27806c8148c2855e", "element": "ba2e353b-78d9-acaf-2db8-8584d0f95ecc"}, "text": "Open the landed cost calculator"}}, {"label": "next.cards[1].link", "set_link": {"id": {"component": "6ac7866c27806c8148c2855e", "element": "ba2e353b-78d9-acaf-2db8-8584d0f95eca"}, "linkType": "page", "link": "6ac7652962cd713ecd056f43"}}, {"label": "next.cards[2].title", "set_text": {"id": {"component": "6ac7866c27806c8148c2855e", "element": "ba2e353b-78d9-acaf-2db8-8584d0f95ed2"}, "text": "Put a price on payment terms"}}, {"label": "next.cards[2].body", "set_text": {"id": {"component": "6ac7866c27806c8148c2855e", "element": "ba2e353b-78d9-acaf-2db8-8584d0f95ed5"}, "text": "See what a discount for paying a supplier early is worth once it is turned into a yearly rate."}}, {"label": "next.cards[2].link_label", "set_text": {"id": {"component": "6ac7866c27806c8148c2855e", "element": "ba2e353b-78d9-acaf-2db8-8584d0f95ed9"}, "text": "Open the early payment discount calculator"}}]