[{"label": "who.chips[3].label", "set_text": {"id": {"component": "6ac7866c27806c8148c2855e", "element": "689f4c43-f40c-f3f5-68ac-8521c5296fc1"}, "text": "Receiving clerks checking deliveries"}}, {"label": "who.chips[4].label", "set_text": {"id": {"component": "6ac7866c27806c8148c2855e", "element": "689f4c43-f40c-f3f5-68ac-8521c5296fc6"}, "text": "Accounts payable approving invoices"}}, {"label": "who.chips[5].label", "set_text": {"id": {"component": "6ac7866c27806c8148c2855e", "element": "689f4c43-f40c-f3f5-68ac-8521c5296fcb"}, "text": "Category managers renewing contracts"}}, {"label": "who.chips[6].label", "set_text": {"id": {"component": "6ac7866c27806c8148c2855e", "element": "689f4c43-f40c-f3f5-68ac-8521c5296fd0"}, "text": "Pricing staff passing on increases"}}, {"label": "who.chips[7].label", "set_text": {"id": {"component": "6ac7866c27806c8148c2855e", "element": "689f4c43-f40c-f3f5-68ac-8521c5296fd5"}, "text": "Purchasing leads recovering overcharges"}}, {"label": "who.chips[8].label", "set_text": {"id": {"component": "6ac7866c27806c8148c2855e", "element": "689f4c43-f40c-f3f5-68ac-8521c5296fda"}, "text": "Controllers comparing standard and actual"}}, {"label": "look.h2", "set_text": {"id": {"component": "6ac7866c27806c8148c2855e", "element": "1635d733-8e70-4e26-f8fd-83ecb36e959b"}, "text": "What to look for before you trust the variance"}}, {"label": "look.intro", "set_text": {"id": {"component": "6ac7866c27806c8148c2855e", "element": "1635d733-8e70-4e26-f8fd-83ecb36e959f"}, "text": "The subtraction is exact. The variance is only as honest as three inputs, and each one fails in a familiar way."}}, {"label": "look.steps[0].title", "set_text": {"id": {"component": "6ac7866c27806c8148c2855e", "element": "1635d733-8e70-4e26-f8fd-83ecb36e95a5"}, "text": "Overcharges already credited"}}, {"label": "look.steps[0].body", "set_text": {"id": {"component": "6ac7866c27806c8148c2855e", "element": "1635d733-8e70-4e26-f8fd-83ecb36e95a9"}, "text": "If the supplier has already credited an overcharge, use the corrected price. Otherwise the variance flags a gap that has been settled."}}, {"label": "look.steps[1].title", "set_text": {"id": {"component": "6ac7866c27806c8148c2855e", "element": "1635d733-8e70-4e26-f8fd-83ecb36e95ad"}, "text": "The same unit on both sides"}}, {"label": "look.steps[1].body", "set_text": {"id": {"component": "6ac7866c27806c8148c2855e", "element": "1635d733-8e70-4e26-f8fd-83ecb36e95b1"}, "text": "Check that the standard and the invoice price the same unit. A standard per case against an invoice priced per pound gives a gap that is only arithmetic."}}]