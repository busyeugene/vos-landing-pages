[{"label": "next.h2", "set_text": {"id": {"component": "6ac7866ff16ee3a82e89dd76", "element": "dfc38588-c157-6d6a-a05b-db6833f6cb3b"}, "text": "What to run after markup"}}, {"label": "next.intro", "set_text": {"id": {"component": "6ac7866ff16ee3a82e89dd76", "element": "dfc38588-c157-6d6a-a05b-db6833f6cb40"}, "text": "A markup rung prices one case from one cost. These free calculators test it against other rules, against the shelf and across your whole book."}}, {"label": "next.cards[0].title", "set_text": {"id": {"component": "6ac7866ff16ee3a82e89dd76", "element": "dfc38588-c157-6d6a-a05b-db6833f6cb48"}, "text": "Test the rung against two other rules"}}, {"label": "next.cards[0].body", "set_text": {"id": {"component": "6ac7866ff16ee3a82e89dd76", "element": "dfc38588-c157-6d6a-a05b-db6833f6cb4b"}, "text": "Price the same case off a target margin, a flat dollar profit and a competitor's price, with the margin each one leaves."}}, {"label": "next.cards[0].link_label", "set_text": {"id": {"component": "6ac7866ff16ee3a82e89dd76", "element": "dfc38588-c157-6d6a-a05b-db6833f6cb4f"}, "text": "Open the product pricing calculator"}}, {"label": "next.cards[0].link", "set_link": {"id": {"component": "6ac7866ff16ee3a82e89dd76", "element": "dfc38588-c157-6d6a-a05b-db6833f6cb4d"}, "linkType": "page", "link": "6ac718c668be300e93fb7203"}}, {"label": "next.cards[1].title", "set_text": {"id": {"component": "6ac7866ff16ee3a82e89dd76", "element": "dfc38588-c157-6d6a-a05b-db6833f6cb55"}, "text": "See the margin at the store's shelf"}}, {"label": "next.cards[1].body", "set_text": {"id": {"component": "6ac7866ff16ee3a82e89dd76", "element": "dfc38588-c157-6d6a-a05b-db6833f6cb58"}, "text": "Turn a store's unit cost and shelf price into its retail margin, the markup that matches it and the price a target needs."}}, {"label": "next.cards[1].link_label", "set_text": {"id": {"component": "6ac7866ff16ee3a82e89dd76", "element": "dfc38588-c157-6d6a-a05b-db6833f6cb5c"}, "text": "Open the retail margin calculator"}}, {"label": "next.cards[1].link", "set_link": {"id": {"component": "6ac7866ff16ee3a82e89dd76", "element": "dfc38588-c157-6d6a-a05b-db6833f6cb5a"}, "linkType": "page", "link": "6ac76528743f1f2a6f8ae6e6"}}, {"label": "next.cards[2].title", "set_text": {"id": {"component": "6ac7866ff16ee3a82e89dd76", "element": "dfc38588-c157-6d6a-a05b-db6833f6cb62"}, "text": "Find what your whole book earns"}}, {"label": "next.cards[2].body", "set_text": {"id": {"component": "6ac7866ff16ee3a82e89dd76", "element": "dfc38588-c157-6d6a-a05b-db6833f6cb65"}, "text": "Take a landed cost to a wholesale price, then see low-markup staples pull your blended margin below the quote."}}]