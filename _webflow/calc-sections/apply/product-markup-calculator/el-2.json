[{"label": "look.steps[1].body", "set_text": {"id": {"component": "6ac7866ff16ee3a82e89dd76", "element": "b2cd3559-eb61-7d51-0a84-a506dfd22482"}, "text": "The 30% target is gross margin, before delivery, sales pay and rent. Type the net margin you hope to keep and the markup comes out far too low."}}, {"label": "look.steps[2].title", "set_text": {"id": {"component": "6ac7866ff16ee3a82e89dd76", "element": "b2cd3559-eb61-7d51-0a84-a506dfd22486"}, "text": "Price endings that round up"}}, {"label": "look.steps[2].body", "set_text": {"id": {"component": "6ac7866ff16ee3a82e89dd76", "element": "b2cd3559-eb61-7d51-0a84-a506dfd2248a"}, "text": "If your list rounds prices to set endings, round $31.43 up, not down. Rounding down to the nearest ending puts the case under its target."}}, {"label": "vos.badge", "set_text": {"id": {"component": "6ac7866ff16ee3a82e89dd76", "element": "8558ce73-7581-3b66-592e-14c1e614e72b"}, "text": "Order History"}}, {"label": "vos.h2", "set_text": {"id": {"component": "6ac7866ff16ee3a82e89dd76", "element": "8558ce73-7581-3b66-592e-14c1e614e72c"}, "text": "Where VOS fits next to the ladder"}}, {"label": "vos.row_badge", "set_text": {"id": {"component": "6ac7866ff16ee3a82e89dd76", "element": "8558ce73-7581-3b66-592e-14c1e614e735"}, "text": "Your Case Counts"}}, {"label": "vos.h3", "set_text": {"id": {"component": "6ac7866ff16ee3a82e89dd76", "element": "8558ce73-7581-3b66-592e-14c1e614e736"}, "text": "The orders behind your case counts"}}, {"label": "vos.body", "set_text": {"id": {"component": "6ac7866ff16ee3a82e89dd76", "element": "8558ce73-7581-3b66-592e-14c1e614e73a"}, "text": "VOS does not calculate markups or set prices. It touches one input, the case count behind your monthly gross profit. Customers order by voice in the VOS app, and you see each account's order history in one admin platform."}}, {"label": "vos.bullets[0]", "set_text": {"id": {"component": "6ac7866ff16ee3a82e89dd76", "element": "8558ce73-7581-3b66-592e-14c1e614e741"}, "text": "Each app order carries a number, date and timestamp"}}, {"label": "vos.bullets[1]", "set_text": {"id": {"component": "6ac7866ff16ee3a82e89dd76", "element": "8558ce73-7581-3b66-592e-14c1e614e747"}, "text": "Order guides updated in the same place when a price moves"}}, {"label": "vos.bullets[2]", "set_text": {"id": {"component": "6ac7866ff16ee3a82e89dd76", "element": "8558ce73-7581-3b66-592e-14c1e614e74d"}, "text": "Each account orders at the prices you set, tied to your SKUs"}}, {"label": "vos.bullets[3]", "set_text": {"id": {"component": "6ac7866ff16ee3a82e89dd76", "element": "8558ce73-7581-3b66-592e-14c1e614e753"}, "text": "Orders captured 24/7, after hours included"}}]