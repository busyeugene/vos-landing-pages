[{"label": "who.chips[8].alt.image", "set_image_asset": {"id": {"component": "6ac7866ff16ee3a82e89dd76", "element": "f7f8b3f4-8f3e-064b-6629-6d6eaa696f97"}, "image_asset_id": "6ad07a8c46e29627d6ef796b"}}, {"label": "look.h2", "set_text": {"id": {"component": "6ac7866ff16ee3a82e89dd76", "element": "b2cd3559-eb61-7d51-0a84-a506dfd2246c"}, "text": "Before you pick a markup rung"}}, {"label": "vos.body", "set_text": {"id": {"component": "6ac7866ff16ee3a82e89dd76", "element": "8558ce73-7581-3b66-592e-14c1e614e73a"}, "text": "VOS does not calculate markups or set prices. It touches one input, the case count behind your monthly gross profit. Every order a customer speaks into the VOS app is saved to that account's history, in one admin platform."}}, {"label": "next.cards[0].alt.image", "set_image_asset": {"id": {"component": "6ac7866ff16ee3a82e89dd76", "element": "dfc38588-c157-6d6a-a05b-db6833f6cb45"}, "image_asset_id": "6ad07a86f43d7bfc43f824d1"}}, {"label": "next.cards[1].alt.image", "set_image_asset": {"id": {"component": "6ac7866ff16ee3a82e89dd76", "element": "dfc38588-c157-6d6a-a05b-db6833f6cb52"}, "image_asset_id": "6ac71feed74c17b09757a220"}}, {"label": "next.cards[2].body", "set_text": {"id": {"component": "6ac7866ff16ee3a82e89dd76", "element": "dfc38588-c157-6d6a-a05b-db6833f6cb65"}, "text": "Set staple and specialty markups side by side and read the blended margin the two leave together."}}, {"label": "next.cards[2].alt.image", "set_image_asset": {"id": {"component": "6ac7866ff16ee3a82e89dd76", "element": "dfc38588-c157-6d6a-a05b-db6833f6cb5f"}, "image_asset_id": "6ad07a8582b4c538b5789ee3"}}]