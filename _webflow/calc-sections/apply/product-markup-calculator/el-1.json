[{"label": "who.chips[2].label", "set_text": {"id": {"component": "6ac7866ff16ee3a82e89dd76", "element": "f7f8b3f4-8f3e-064b-6629-6d6eaa696f7b"}, "text": "Managers raising a category's rung"}}, {"label": "who.chips[3].label", "set_text": {"id": {"component": "6ac7866ff16ee3a82e89dd76", "element": "f7f8b3f4-8f3e-064b-6629-6d6eaa696f80"}, "text": "DSD reps pricing store lines"}}, {"label": "who.chips[4].label", "set_text": {"id": {"component": "6ac7866ff16ee3a82e89dd76", "element": "f7f8b3f4-8f3e-064b-6629-6d6eaa696f85"}, "text": "Finance reconciling markup to margin"}}, {"label": "who.chips[5].label", "set_text": {"id": {"component": "6ac7866ff16ee3a82e89dd76", "element": "f7f8b3f4-8f3e-064b-6629-6d6eaa696f8a"}, "text": "Teams converting margin targets"}}, {"label": "who.chips[6].label", "set_text": {"id": {"component": "6ac7866ff16ee3a82e89dd76", "element": "f7f8b3f4-8f3e-064b-6629-6d6eaa696f8f"}, "text": "Reps pricing a new item"}}, {"label": "who.chips[7].label", "set_text": {"id": {"component": "6ac7866ff16ee3a82e89dd76", "element": "f7f8b3f4-8f3e-064b-6629-6d6eaa696f94"}, "text": "Controllers spotting thin rungs"}}, {"label": "who.chips[8].label", "set_text": {"id": {"component": "6ac7866ff16ee3a82e89dd76", "element": "f7f8b3f4-8f3e-064b-6629-6d6eaa696f99"}, "text": "Anyone comparing two markup rungs"}}, {"label": "look.h2", "set_text": {"id": {"component": "6ac7866ff16ee3a82e89dd76", "element": "b2cd3559-eb61-7d51-0a84-a506dfd2246c"}, "text": "What to check before you set the rung"}}, {"label": "look.intro", "set_text": {"id": {"component": "6ac7866ff16ee3a82e89dd76", "element": "b2cd3559-eb61-7d51-0a84-a506dfd22470"}, "text": "The ladder is exact arithmetic. What goes wrong is the cost you start from and the target you aim at."}}, {"label": "look.steps[0].title", "set_text": {"id": {"component": "6ac7866ff16ee3a82e89dd76", "element": "b2cd3559-eb61-7d51-0a84-a506dfd22476"}, "text": "A cost for the unit you sell"}}, {"label": "look.steps[0].body", "set_text": {"id": {"component": "6ac7866ff16ee3a82e89dd76", "element": "b2cd3559-eb61-7d51-0a84-a506dfd2247a"}, "text": "If you split cases and sell eaches, divide the $22.00 by the pack before you mark it up. A rung on the case cost does not price a single each."}}, {"label": "look.steps[1].title", "set_text": {"id": {"component": "6ac7866ff16ee3a82e89dd76", "element": "b2cd3559-eb61-7d51-0a84-a506dfd2247e"}, "text": "A gross target, not a net one"}}]