[{"label": "next.intro", "set_text": {"id": {"component": "6ac72b948f277e012d8d7584", "element": "b5f8f61d-cd39-321d-182d-af06358f3822"}, "text": "Unit price tells you which pack is the better buy. These three free calculators carry that choice into freight, trim and the invoice."}}, {"label": "next.cards[0].title", "set_text": {"id": {"component": "6ac72b948f277e012d8d7584", "element": "b5f8f61d-cd39-321d-182d-af06358f382a"}, "text": "Add freight and rank three offers"}}, {"label": "next.cards[0].body", "set_text": {"id": {"component": "6ac72b948f277e012d8d7584", "element": "b5f8f61d-cd39-321d-182d-af06358f382d"}, "text": "Rank three supplier quotes on landed cost per unit with freight counted, since the cheapest case is rarely the cheapest unit."}}, {"label": "next.cards[0].link_label", "set_text": {"id": {"component": "6ac72b948f277e012d8d7584", "element": "b5f8f61d-cd39-321d-182d-af06358f3831"}, "text": "Open the landed cost calculator"}}, {"label": "next.cards[0].link", "set_link": {"id": {"component": "6ac72b948f277e012d8d7584", "element": "b5f8f61d-cd39-321d-182d-af06358f382f"}, "linkType": "page", "link": "6ac7652962cd713ecd056f43"}}, {"label": "next.cards[1].title", "set_text": {"id": {"component": "6ac72b948f277e012d8d7584", "element": "b5f8f61d-cd39-321d-182d-af06358f3837"}, "text": "Price on the pounds you can sell"}}, {"label": "next.cards[1].body", "set_text": {"id": {"component": "6ac72b948f277e012d8d7584", "element": "b5f8f61d-cd39-321d-182d-af06358f383a"}, "text": "Price cut and portioned product on the pounds left after trim, not on the weight you bought."}}, {"label": "next.cards[1].link_label", "set_text": {"id": {"component": "6ac72b948f277e012d8d7584", "element": "b5f8f61d-cd39-321d-182d-af06358f383e"}, "text": "Open the food markup calculator"}}, {"label": "next.cards[1].link", "set_link": {"id": {"component": "6ac72b948f277e012d8d7584", "element": "b5f8f61d-cd39-321d-182d-af06358f383c"}, "linkType": "page", "link": "6ac79be2180bc9b3c91fb79c"}}, {"label": "next.cards[2].title", "set_text": {"id": {"component": "6ac72b948f277e012d8d7584", "element": "b5f8f61d-cd39-321d-182d-af06358f3844"}, "text": "Check the invoice against your standard"}}, {"label": "next.cards[2].body", "set_text": {"id": {"component": "6ac72b948f277e012d8d7584", "element": "b5f8f61d-cd39-321d-182d-af06358f3847"}, "text": "Set what you paid against your standard price, per case and as a percent, then see what the gap is worth in a year."}}, {"label": "next.cards[2].link_label", "set_text": {"id": {"component": "6ac72b948f277e012d8d7584", "element": "b5f8f61d-cd39-321d-182d-af06358f384b"}, "text": "Open the purchase price variance calculator"}}]