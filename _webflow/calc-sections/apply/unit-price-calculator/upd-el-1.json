[{"label": "who.chips[7].alt.image", "set_image_asset": {"id": {"component": "6ac72b948f277e012d8d7584", "element": "3f59c076-bdb6-2859-0e77-d55cf2249c6a"}, "image_asset_id": "6ad07a89927330500c3959e0"}}, {"label": "who.chips[8].alt.image", "set_image_asset": {"id": {"component": "6ac72b948f277e012d8d7584", "element": "3f59c076-bdb6-2859-0e77-d55cf2249c6f"}, "image_asset_id": "6ad07a8f36601c73ce217313"}}, {"label": "look.h2", "set_text": {"id": {"component": "6ac72b948f277e012d8d7584", "element": "5a2b8521-a42f-b1a4-3f4c-e4c6e478633d"}, "text": "Put both unit prices on the same footing"}}, {"label": "vos.body", "set_text": {"id": {"component": "6ac72b948f277e012d8d7584", "element": "f8710a66-6931-6200-5632-b778d1e1578c"}, "text": "VOS does not compare packs or buy stock. Once you choose a pack, you put it on each account's guide, tied to your SKUs. Customers build the order by voice in the VOS app, then review each line before sending."}}, {"label": "next.cards[0].body", "set_text": {"id": {"component": "6ac72b948f277e012d8d7584", "element": "b5f8f61d-cd39-321d-182d-af06358f382d"}, "text": "Carry the pack comparison further: add each supplier's freight and see which of three quotes lands cheapest per unit."}}, {"label": "next.cards[0].alt.image", "set_image_asset": {"id": {"component": "6ac72b948f277e012d8d7584", "element": "b5f8f61d-cd39-321d-182d-af06358f3827"}, "image_asset_id": "6ad07a86f43d7bfc43f824d1"}}, {"label": "next.cards[1].alt.image", "set_image_asset": {"id": {"component": "6ac72b948f277e012d8d7584", "element": "b5f8f61d-cd39-321d-182d-af06358f3834"}, "image_asset_id": "6ad07a8582b4c538b5789ee3"}}, {"label": "next.cards[2].alt.image", "set_image_asset": {"id": {"component": "6ac72b948f277e012d8d7584", "element": "b5f8f61d-cd39-321d-182d-af06358f3841"}, "image_asset_id": "6ac71f2f2c3d8300eaf3b24f"}}]