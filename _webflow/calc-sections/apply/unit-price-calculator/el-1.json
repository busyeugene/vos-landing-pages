[{"label": "who.chips[3].label", "set_text": {"id": {"component": "6ac72b948f277e012d8d7584", "element": "3f59c076-bdb6-2859-0e77-d55cf2249c58"}, "text": "DSD reps swapping store packs"}}, {"label": "who.chips[4].label", "set_text": {"id": {"component": "6ac72b948f277e012d8d7584", "element": "3f59c076-bdb6-2859-0e77-d55cf2249c5d"}, "text": "Controllers checking cost per pound"}}, {"label": "who.chips[5].label", "set_text": {"id": {"component": "6ac72b948f277e012d8d7584", "element": "3f59c076-bdb6-2859-0e77-d55cf2249c62"}, "text": "Purchasing teams spotting spec changes"}}, {"label": "who.chips[6].label", "set_text": {"id": {"component": "6ac72b948f277e012d8d7584", "element": "3f59c076-bdb6-2859-0e77-d55cf2249c67"}, "text": "Pricing staff setting pound prices"}}, {"label": "who.chips[7].label", "set_text": {"id": {"component": "6ac72b948f277e012d8d7584", "element": "3f59c076-bdb6-2859-0e77-d55cf2249c6c"}, "text": "Owners cutting cost of goods"}}, {"label": "who.chips[8].label", "set_text": {"id": {"component": "6ac72b948f277e012d8d7584", "element": "3f59c076-bdb6-2859-0e77-d55cf2249c71"}, "text": "Sales teams comparing competitor packs"}}, {"label": "look.h2", "set_text": {"id": {"component": "6ac72b948f277e012d8d7584", "element": "5a2b8521-a42f-b1a4-3f4c-e4c6e478633d"}, "text": "What to look for before you trust the comparison"}}, {"label": "look.intro", "set_text": {"id": {"component": "6ac72b948f277e012d8d7584", "element": "5a2b8521-a42f-b1a4-3f4c-e4c6e4786341"}, "text": "The division is simple. The weights and counts you type in are where most comparisons slip, and these three checks catch it."}}, {"label": "look.steps[0].title", "set_text": {"id": {"component": "6ac72b948f277e012d8d7584", "element": "5a2b8521-a42f-b1a4-3f4c-e4c6e4786347"}, "text": "Weights in the same measure"}}, {"label": "look.steps[0].body", "set_text": {"id": {"component": "6ac72b948f277e012d8d7584", "element": "5a2b8521-a42f-b1a4-3f4c-e4c6e478634b"}, "text": "Pounds against pounds. A spec sheet in ounces or grams has to be converted before it goes in, or the per pound line comes out badly wrong."}}, {"label": "look.steps[1].title", "set_text": {"id": {"component": "6ac72b948f277e012d8d7584", "element": "5a2b8521-a42f-b1a4-3f4c-e4c6e478634f"}, "text": "A count that matches the price"}}, {"label": "look.steps[1].body", "set_text": {"id": {"component": "6ac72b948f277e012d8d7584", "element": "5a2b8521-a42f-b1a4-3f4c-e4c6e4786353"}, "text": "A case may be listed by the sleeve or the inner pack, and a price sheet may quote either one. Count the units the price actually covers."}}]