[{"label": "look.steps[2].title", "set_text": {"id": {"component": "6ac72b948f277e012d8d7584", "element": "5a2b8521-a42f-b1a4-3f4c-e4c6e4786357"}, "text": "Prices from the same date"}}, {"label": "look.steps[2].body", "set_text": {"id": {"component": "6ac72b948f277e012d8d7584", "element": "5a2b8521-a42f-b1a4-3f4c-e4c6e478635b"}, "text": "Take both prices from the same week. A pack quoted last month against one quoted today mixes a price change into a size comparison."}}, {"label": "vos.badge", "set_text": {"id": {"component": "6ac72b948f277e012d8d7584", "element": "f8710a66-6931-6200-5632-b778d1e1577d"}, "text": "Order Review"}}, {"label": "vos.h2", "set_text": {"id": {"component": "6ac72b948f277e012d8d7584", "element": "f8710a66-6931-6200-5632-b778d1e1577e"}, "text": "Where VOS fits once you pick a pack"}}, {"label": "vos.row_badge", "set_text": {"id": {"component": "6ac72b948f277e012d8d7584", "element": "f8710a66-6931-6200-5632-b778d1e15787"}, "text": "Your Chosen Pack"}}, {"label": "vos.h3", "set_text": {"id": {"component": "6ac72b948f277e012d8d7584", "element": "f8710a66-6931-6200-5632-b778d1e15788"}, "text": "Customers check each line before it reaches you"}}, {"label": "vos.body", "set_text": {"id": {"component": "6ac72b948f277e012d8d7584", "element": "f8710a66-6931-6200-5632-b778d1e1578c"}, "text": "VOS does not compare packs or buy stock. It works on the selling side, where the pack you chose meets the order. Customers order by voice in the VOS app from a guide tied to your SKUs, and review each line before sending."}}, {"label": "vos.bullets[0]", "set_text": {"id": {"component": "6ac72b948f277e012d8d7584", "element": "f8710a66-6931-6200-5632-b778d1e15793"}, "text": "Orders arrive confirmed, with a number and timestamp"}}, {"label": "vos.bullets[1]", "set_text": {"id": {"component": "6ac72b948f277e012d8d7584", "element": "f8710a66-6931-6200-5632-b778d1e15799"}, "text": "Guides updated per account in one admin platform"}}, {"label": "vos.bullets[2]", "set_text": {"id": {"component": "6ac72b948f277e012d8d7584", "element": "f8710a66-6931-6200-5632-b778d1e1579f"}, "text": "The catalog updates as stock changes"}}, {"label": "vos.bullets[3]", "set_text": {"id": {"component": "6ac72b948f277e012d8d7584", "element": "f8710a66-6931-6200-5632-b778d1e157a5"}, "text": "Most customers place a first order the same day"}}, {"label": "next.h2", "set_text": {"id": {"component": "6ac72b948f277e012d8d7584", "element": "b5f8f61d-cd39-321d-182d-af06358f381d"}, "text": "What to run after unit price"}}]