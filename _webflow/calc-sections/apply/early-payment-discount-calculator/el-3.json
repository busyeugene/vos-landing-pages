[{"label": "next.h2", "set_text": {"id": {"component": "6ac79be4b863c26cbc9698b6", "element": "6725eb18-6bcd-551c-034a-3f87e8daab0f"}, "text": "What to run after the early payment discount"}}, {"label": "next.intro", "set_text": {"id": {"component": "6ac79be4b863c26cbc9698b6", "element": "6725eb18-6bcd-551c-034a-3f87e8daab14"}, "text": "The discount decides when you pay suppliers. These three cover when your accounts pay you, what you paid against standard, and what a deal really saved."}}, {"label": "next.cards[0].title", "set_text": {"id": {"component": "6ac79be4b863c26cbc9698b6", "element": "6725eb18-6bcd-551c-034a-3f87e8daab1c"}, "text": "See how fast your accounts pay you"}}, {"label": "next.cards[0].body", "set_text": {"id": {"component": "6ac79be4b863c26cbc9698b6", "element": "6725eb18-6bcd-551c-034a-3f87e8daab1f"}, "text": "Check how many days past terms your customers really pay, and what financing that delay costs you a year."}}, {"label": "next.cards[0].link_label", "set_text": {"id": {"component": "6ac79be4b863c26cbc9698b6", "element": "6725eb18-6bcd-551c-034a-3f87e8daab23"}, "text": "Open the AR turnover calculator"}}, {"label": "next.cards[0].link", "set_link": {"id": {"component": "6ac79be4b863c26cbc9698b6", "element": "6725eb18-6bcd-551c-034a-3f87e8daab21"}, "linkType": "page", "link": "6ac72b932e36cb4efe865399"}}, {"label": "next.cards[1].title", "set_text": {"id": {"component": "6ac79be4b863c26cbc9698b6", "element": "6725eb18-6bcd-551c-034a-3f87e8daab29"}, "text": "Check what you paid against standard"}}, {"label": "next.cards[1].body", "set_text": {"id": {"component": "6ac79be4b863c26cbc9698b6", "element": "6725eb18-6bcd-551c-034a-3f87e8daab2c"}, "text": "Set what you actually paid against your standard price, per case and as a percent, and size the gap over a year."}}, {"label": "next.cards[1].link_label", "set_text": {"id": {"component": "6ac79be4b863c26cbc9698b6", "element": "6725eb18-6bcd-551c-034a-3f87e8daab30"}, "text": "Open the price variance calculator"}}, {"label": "next.cards[1].link", "set_link": {"id": {"component": "6ac79be4b863c26cbc9698b6", "element": "6725eb18-6bcd-551c-034a-3f87e8daab2e"}, "linkType": "page", "link": "6ac7866c27806c8148c2855e"}}, {"label": "next.cards[2].title", "set_text": {"id": {"component": "6ac79be4b863c26cbc9698b6", "element": "6725eb18-6bcd-551c-034a-3f87e8daab36"}, "text": "Split a real saving from an avoided one"}}, {"label": "next.cards[2].body", "set_text": {"id": {"component": "6ac79be4b863c26cbc9698b6", "element": "6725eb18-6bcd-551c-034a-3f87e8daab39"}, "text": "Separate hard savings from the increases you kept off the table, and see which part actually reaches the P&L."}}]