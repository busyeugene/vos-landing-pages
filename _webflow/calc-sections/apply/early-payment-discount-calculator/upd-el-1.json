[{"label": "who.chips[8].alt.image", "set_image_asset": {"id": {"component": "6ac79be4b863c26cbc9698b6", "element": "6593b25f-d169-73e7-2d95-04c8ff89da20"}, "image_asset_id": "6ad07a860941cf0d0c62fa17"}}, {"label": "look.h2", "set_text": {"id": {"component": "6ac79be4b863c26cbc9698b6", "element": "0f1a3cff-238a-bb56-406d-b7c18a1c7f6b"}, "text": "Read the terms before you take the discount"}}, {"label": "look.intro", "set_text": {"id": {"component": "6ac79be4b863c26cbc9698b6", "element": "0f1a3cff-238a-bb56-406d-b7c18a1c7f6f"}, "text": "The yearly rate is plain arithmetic. The risk sits in the terms you enter and the invoice behind them, so test both against a real invoice."}}, {"label": "vos.body", "set_text": {"id": {"component": "6ac79be4b863c26cbc9698b6", "element": "d393ab1d-b18c-5008-0fb4-921216eda2f0"}, "text": "VOS does not calculate discounts, pay suppliers or touch your payables. Its part is the sale, not the purchase: each order your accounts place by voice in the VOS app comes in confirmed and timestamped. Paying early stays your decision, made in your own books."}}, {"label": "next.cards[0].alt.image", "set_image_asset": {"id": {"component": "6ac79be4b863c26cbc9698b6", "element": "6725eb18-6bcd-551c-034a-3f87e8daab19"}, "image_asset_id": "6ac71ff16a53ab9c5d7fb081"}}, {"label": "next.cards[1].alt.image", "set_image_asset": {"id": {"component": "6ac79be4b863c26cbc9698b6", "element": "6725eb18-6bcd-551c-034a-3f87e8daab26"}, "image_asset_id": "6ad07a86f43d7bfc43f824d1"}}, {"label": "next.cards[2].alt.image", "set_image_asset": {"id": {"component": "6ac79be4b863c26cbc9698b6", "element": "6725eb18-6bcd-551c-034a-3f87e8daab33"}, "image_asset_id": "6ad07a8582b4c538b5789ee3"}}]