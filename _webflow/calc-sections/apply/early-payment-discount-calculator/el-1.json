[{"label": "who.chips[2].label", "set_text": {"id": {"component": "6ac79be4b863c26cbc9698b6", "element": "6593b25f-d169-73e7-2d95-04c8ff89da04"}, "text": "Finance ranking invoices by rate"}}, {"label": "who.chips[3].label", "set_text": {"id": {"component": "6ac79be4b863c26cbc9698b6", "element": "6593b25f-d169-73e7-2d95-04c8ff89da09"}, "text": "Buyers weighing freight against discounts"}}, {"label": "who.chips[4].label", "set_text": {"id": {"component": "6ac79be4b863c26cbc9698b6", "element": "6593b25f-d169-73e7-2d95-04c8ff89da0e"}, "text": "Payables clerks scheduling payments"}}, {"label": "who.chips[5].label", "set_text": {"id": {"component": "6ac79be4b863c26cbc9698b6", "element": "6593b25f-d169-73e7-2d95-04c8ff89da13"}, "text": "Teams planning weekly payment runs"}}, {"label": "who.chips[6].label", "set_text": {"id": {"component": "6ac79be4b863c26cbc9698b6", "element": "6593b25f-d169-73e7-2d95-04c8ff89da18"}, "text": "Purchasing managers comparing net prices"}}, {"label": "who.chips[7].label", "set_text": {"id": {"component": "6ac79be4b863c26cbc9698b6", "element": "6593b25f-d169-73e7-2d95-04c8ff89da1d"}, "text": "Owners getting through tight months"}}, {"label": "who.chips[8].label", "set_text": {"id": {"component": "6ac79be4b863c26cbc9698b6", "element": "6593b25f-d169-73e7-2d95-04c8ff89da22"}, "text": "Anyone offered new payment terms"}}, {"label": "look.h2", "set_text": {"id": {"component": "6ac79be4b863c26cbc9698b6", "element": "0f1a3cff-238a-bb56-406d-b7c18a1c7f6b"}, "text": "What to check before you take the discount"}}, {"label": "look.intro", "set_text": {"id": {"component": "6ac79be4b863c26cbc9698b6", "element": "0f1a3cff-238a-bb56-406d-b7c18a1c7f6f"}, "text": "The yearly rate is plain arithmetic. The risk sits in the terms you enter and the invoice behind them. Check these three against a real invoice first."}}, {"label": "look.steps[0].title", "set_text": {"id": {"component": "6ac79be4b863c26cbc9698b6", "element": "0f1a3cff-238a-bb56-406d-b7c18a1c7f75"}, "text": "When the 10 days start"}}, {"label": "look.steps[0].body", "set_text": {"id": {"component": "6ac79be4b863c26cbc9698b6", "element": "0f1a3cff-238a-bb56-406d-b7c18a1c7f79"}, "text": "Most terms count the 10 days from the invoice date, not the day the product arrives. Slow approvals eat into that window before any payment can go out."}}, {"label": "look.steps[1].title", "set_text": {"id": {"component": "6ac79be4b863c26cbc9698b6", "element": "0f1a3cff-238a-bb56-406d-b7c18a1c7f7d"}, "text": "How your volume tier is paid"}}]