[{"label": "who.chips[2].label", "set_text": {"id": {"component": "6ac72b932e36cb4efe865399", "element": "02165e3b-ba5a-ce6f-61d0-20952bf6b103"}, "text": "Finance leads briefing a lender"}}, {"label": "who.chips[3].label", "set_text": {"id": {"component": "6ac72b932e36cb4efe865399", "element": "02165e3b-ba5a-ce6f-61d0-20952bf6b108"}, "text": "Ops settling delivery disputes"}}, {"label": "who.chips[4].label", "set_text": {"id": {"component": "6ac72b932e36cb4efe865399", "element": "02165e3b-ba5a-ce6f-61d0-20952bf6b10d"}, "text": "Credit teams chasing past due"}}, {"label": "who.chips[5].label", "set_text": {"id": {"component": "6ac72b932e36cb4efe865399", "element": "02165e3b-ba5a-ce6f-61d0-20952bf6b112"}, "text": "Clerks running monthly statements"}}, {"label": "who.chips[6].label", "set_text": {"id": {"component": "6ac72b932e36cb4efe865399", "element": "02165e3b-ba5a-ce6f-61d0-20952bf6b117"}, "text": "Sales managers setting account terms"}}, {"label": "who.chips[7].label", "set_text": {"id": {"component": "6ac72b932e36cb4efe865399", "element": "02165e3b-ba5a-ce6f-61d0-20952bf6b11c"}, "text": "Owners spotting slower payers"}}, {"label": "who.chips[8].label", "set_text": {"id": {"component": "6ac72b932e36cb4efe865399", "element": "02165e3b-ba5a-ce6f-61d0-20952bf6b121"}, "text": "Controllers comparing year over year"}}, {"label": "look.h2", "set_text": {"id": {"component": "6ac72b932e36cb4efe865399", "element": "6b32e9e3-0c13-0f5e-d786-0a264de0eba5"}, "text": "What to check before you quote the ratio"}}, {"label": "look.intro", "set_text": {"id": {"component": "6ac72b932e36cb4efe865399", "element": "6b32e9e3-0c13-0f5e-d786-0a264de0eba9"}, "text": "The result rests on a handful of inputs. These three can shift it without anyone noticing, so check them first."}}, {"label": "look.steps[0].title", "set_text": {"id": {"component": "6ac72b932e36cb4efe865399", "element": "6b32e9e3-0c13-0f5e-d786-0a264de0ebaf"}, "text": "A terms figure that fits the book"}}, {"label": "look.steps[0].body", "set_text": {"id": {"component": "6ac72b932e36cb4efe865399", "element": "6b32e9e3-0c13-0f5e-d786-0a264de0ebb3"}, "text": "The calculator takes one set of terms. If accounts run on a mix, weight the terms by credit sales before you enter them, or the days past terms will be off."}}, {"label": "look.steps[1].title", "set_text": {"id": {"component": "6ac72b932e36cb4efe865399", "element": "6b32e9e3-0c13-0f5e-d786-0a264de0ebb7"}, "text": "Debt that will never be paid"}}]