[{"label": "next.h2", "set_text": {"id": {"component": "6ac72b932e36cb4efe865399", "element": "1c5756a0-6e39-ed71-1729-5c4f1c4a36dd"}, "text": "What to run after receivables turnover"}}, {"label": "next.intro", "set_text": {"id": {"component": "6ac72b932e36cb4efe865399", "element": "1c5756a0-6e39-ed71-1729-5c4f1c4a36e2"}, "text": "Turnover shows how fast cash comes in. These three look at paying suppliers early, stock that holds cash, and what a price move does to profit."}}, {"label": "next.cards[0].title", "set_text": {"id": {"component": "6ac72b932e36cb4efe865399", "element": "1c5756a0-6e39-ed71-1729-5c4f1c4a36ea"}, "text": "Weigh paying a supplier early"}}, {"label": "next.cards[0].body", "set_text": {"id": {"component": "6ac72b932e36cb4efe865399", "element": "1c5756a0-6e39-ed71-1729-5c4f1c4a36ed"}, "text": "Price a supplier's early pay discount as a yearly rate, and see what the case costs after discounts and freight."}}, {"label": "next.cards[0].link_label", "set_text": {"id": {"component": "6ac72b932e36cb4efe865399", "element": "1c5756a0-6e39-ed71-1729-5c4f1c4a36f1"}, "text": "Open the early payment discount calculator"}}, {"label": "next.cards[0].link", "set_link": {"id": {"component": "6ac72b932e36cb4efe865399", "element": "1c5756a0-6e39-ed71-1729-5c4f1c4a36ef"}, "linkType": "page", "link": "6ac79be4b863c26cbc9698b6"}}, {"label": "next.cards[1].title", "set_text": {"id": {"component": "6ac72b932e36cb4efe865399", "element": "1c5756a0-6e39-ed71-1729-5c4f1c4a36f7"}, "text": "See where stock holds your cash"}}, {"label": "next.cards[1].body", "set_text": {"id": {"component": "6ac72b932e36cb4efe865399", "element": "1c5756a0-6e39-ed71-1729-5c4f1c4a36fa"}, "text": "Find the cash a slow stock turn keeps tied up, and how long a case sits before it sells."}}, {"label": "next.cards[1].link_label", "set_text": {"id": {"component": "6ac72b932e36cb4efe865399", "element": "1c5756a0-6e39-ed71-1729-5c4f1c4a36fe"}, "text": "Open the inventory turnover calculator"}}, {"label": "next.cards[1].link", "set_link": {"id": {"component": "6ac72b932e36cb4efe865399", "element": "1c5756a0-6e39-ed71-1729-5c4f1c4a36fc"}, "linkType": "page", "link": "6ac7252ae188e18d1d906bba"}}, {"label": "next.cards[2].title", "set_text": {"id": {"component": "6ac72b932e36cb4efe865399", "element": "1c5756a0-6e39-ed71-1729-5c4f1c4a3704"}, "text": "Check a price change before it lands"}}, {"label": "next.cards[2].body", "set_text": {"id": {"component": "6ac72b932e36cb4efe865399", "element": "1c5756a0-6e39-ed71-1729-5c4f1c4a3707"}, "text": "See the profit swing per case, and how much volume a raise can afford to lose before it costs you."}}]