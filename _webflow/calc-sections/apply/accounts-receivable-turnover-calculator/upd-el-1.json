[{"label": "who.chips[8].alt.image", "set_image_asset": {"id": {"component": "6ac72b932e36cb4efe865399", "element": "02165e3b-ba5a-ce6f-61d0-20952bf6b11f"}, "image_asset_id": "6ac71f2e6a53ab9c5d7f6eee"}}, {"label": "look.h2", "set_text": {"id": {"component": "6ac72b932e36cb4efe865399", "element": "6b32e9e3-0c13-0f5e-d786-0a264de0eba5"}, "text": "Inputs that bend a receivables turnover ratio"}}, {"label": "next.cards[0].alt.image", "set_image_asset": {"id": {"component": "6ac72b932e36cb4efe865399", "element": "1c5756a0-6e39-ed71-1729-5c4f1c4a36e7"}, "image_asset_id": "6ad07a86f43d7bfc43f824d1"}}, {"label": "next.cards[1].body", "set_text": {"id": {"component": "6ac72b932e36cb4efe865399", "element": "1c5756a0-6e39-ed71-1729-5c4f1c4a36fa"}, "text": "Measure the cash sitting in stock and the days a case waits on your shelf, then see what trimming those days frees."}}, {"label": "next.cards[1].alt.image", "set_image_asset": {"id": {"component": "6ac72b932e36cb4efe865399", "element": "1c5756a0-6e39-ed71-1729-5c4f1c4a36f4"}, "image_asset_id": "6ac71feed74c17b09757a220"}}, {"label": "next.cards[2].body", "set_text": {"id": {"component": "6ac72b932e36cb4efe865399", "element": "1c5756a0-6e39-ed71-1729-5c4f1c4a3707"}, "text": "Work out the volume a raise can lose, or a cut must win, before the change starts costing you profit."}}, {"label": "next.cards[2].alt.image", "set_image_asset": {"id": {"component": "6ac72b932e36cb4efe865399", "element": "1c5756a0-6e39-ed71-1729-5c4f1c4a3701"}, "image_asset_id": "6ad07a8582b4c538b5789ee3"}}]