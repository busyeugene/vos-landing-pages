[{"label": "who.chips[8].alt.image", "set_image_asset": {"id": {"component": "6ac73521a469d3c306f7aa87", "element": "e966ffac-c3ee-30cf-a177-6a7707042c9f"}, "image_asset_id": "6ad07a8636601c73ce216e84"}}, {"label": "look.h2", "set_text": {"id": {"component": "6ac73521a469d3c306f7aa87", "element": "e74766aa-6e79-7094-b162-0059787bef17"}, "text": "Check the mix before you budget on the blend"}}, {"label": "look.intro", "set_text": {"id": {"component": "6ac73521a469d3c306f7aa87", "element": "e74766aa-6e79-7094-b162-0059787bef1b"}, "text": "The blend is only as true as the split you type. Anyone building a budget on it should settle these three questions first."}}, {"label": "vos.body", "set_text": {"id": {"component": "6ac73521a469d3c306f7aa87", "element": "b3ec81f2-249a-e4e1-b20c-0d4f35227202"}, "text": "VOS does not calculate markups or measure your blend. Routine order taking moves off your reps: orders arrive confirmed once customers place them by voice in the VOS app."}}, {"label": "next.cards[0].alt.image", "set_image_asset": {"id": {"component": "6ac73521a469d3c306f7aa87", "element": "651d1240-80a3-493e-3076-61e6eb2741c6"}, "image_asset_id": "6ad07a86f43d7bfc43f824d1"}}, {"label": "next.cards[1].alt.image", "set_image_asset": {"id": {"component": "6ac73521a469d3c306f7aa87", "element": "651d1240-80a3-493e-3076-61e6eb2741d3"}, "image_asset_id": "6ac71feed74c17b09757a220"}}, {"label": "next.cards[2].body", "set_text": {"id": {"component": "6ac73521a469d3c306f7aa87", "element": "651d1240-80a3-493e-3076-61e6eb2741e6"}, "text": "Move a staple's price on paper first, and find the case volume that holds profit steady after the change."}}, {"label": "next.cards[2].alt.image", "set_image_asset": {"id": {"component": "6ac73521a469d3c306f7aa87", "element": "651d1240-80a3-493e-3076-61e6eb2741e0"}, "image_asset_id": "6ad07a8582b4c538b5789ee3"}}]