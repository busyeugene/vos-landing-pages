[{"label": "next.h2", "set_text": {"id": {"component": "6ac73521a469d3c306f7aa87", "element": "651d1240-80a3-493e-3076-61e6eb2741bc"}, "text": "What to run after wholesale markup"}}, {"label": "next.intro", "set_text": {"id": {"component": "6ac73521a469d3c306f7aa87", "element": "651d1240-80a3-493e-3076-61e6eb2741c1"}, "text": "The blend shows what the book really earns. These free calculators check the cost under it, the shelf above it and a price move."}}, {"label": "next.cards[0].title", "set_text": {"id": {"component": "6ac73521a469d3c306f7aa87", "element": "651d1240-80a3-493e-3076-61e6eb2741c9"}, "text": "Build the case cost first"}}, {"label": "next.cards[0].body", "set_text": {"id": {"component": "6ac73521a469d3c306f7aa87", "element": "651d1240-80a3-493e-3076-61e6eb2741cc"}, "text": "Start from the supplier price, add freight, handling and shrink, and read the margin your markup really leaves."}}, {"label": "next.cards[0].link_label", "set_text": {"id": {"component": "6ac73521a469d3c306f7aa87", "element": "651d1240-80a3-493e-3076-61e6eb2741d0"}, "text": "Open the material markup calculator"}}, {"label": "next.cards[0].link", "set_link": {"id": {"component": "6ac73521a469d3c306f7aa87", "element": "651d1240-80a3-493e-3076-61e6eb2741ce"}, "linkType": "page", "link": "6ac72b95bdfb92fbc692e782"}}, {"label": "next.cards[1].title", "set_text": {"id": {"component": "6ac73521a469d3c306f7aa87", "element": "651d1240-80a3-493e-3076-61e6eb2741d6"}, "text": "Check the shelf price above yours"}}, {"label": "next.cards[1].body", "set_text": {"id": {"component": "6ac73521a469d3c306f7aa87", "element": "651d1240-80a3-493e-3076-61e6eb2741d9"}, "text": "See your wholesale price become a shelf price, and whether the store's margin is wide enough to keep your line."}}, {"label": "next.cards[1].link_label", "set_text": {"id": {"component": "6ac73521a469d3c306f7aa87", "element": "651d1240-80a3-493e-3076-61e6eb2741dd"}, "text": "Open the wholesale to retail markup calculator"}}, {"label": "next.cards[1].link", "set_link": {"id": {"component": "6ac73521a469d3c306f7aa87", "element": "651d1240-80a3-493e-3076-61e6eb2741db"}, "linkType": "page", "link": "6ac73522edd07accabdbe401"}}, {"label": "next.cards[2].title", "set_text": {"id": {"component": "6ac73521a469d3c306f7aa87", "element": "651d1240-80a3-493e-3076-61e6eb2741e3"}, "text": "Test a price move on a staple"}}, {"label": "next.cards[2].body", "set_text": {"id": {"component": "6ac73521a469d3c306f7aa87", "element": "651d1240-80a3-493e-3076-61e6eb2741e6"}, "text": "Before you move a staple's price, see the profit swing per case and how much volume a raise can lose before profit falls."}}]