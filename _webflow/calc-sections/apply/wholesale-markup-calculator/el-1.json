[{"label": "who.chips[2].label", "set_text": {"id": {"component": "6ac73521a469d3c306f7aa87", "element": "e966ffac-c3ee-30cf-a177-6a7707042c83"}, "text": "Reps growing specialty sales"}}, {"label": "who.chips[3].label", "set_text": {"id": {"component": "6ac73521a469d3c306f7aa87", "element": "e966ffac-c3ee-30cf-a177-6a7707042c88"}, "text": "Route managers pricing small drops"}}, {"label": "who.chips[4].label", "set_text": {"id": {"component": "6ac73521a469d3c306f7aa87", "element": "e966ffac-c3ee-30cf-a177-6a7707042c8d"}, "text": "Finance budgeting overhead against margin"}}, {"label": "who.chips[5].label", "set_text": {"id": {"component": "6ac73521a469d3c306f7aa87", "element": "e966ffac-c3ee-30cf-a177-6a7707042c92"}, "text": "Teams renewing contract accounts"}}, {"label": "who.chips[6].label", "set_text": {"id": {"component": "6ac73521a469d3c306f7aa87", "element": "e966ffac-c3ee-30cf-a177-6a7707042c97"}, "text": "Category managers setting markups"}}, {"label": "who.chips[7].label", "set_text": {"id": {"component": "6ac73521a469d3c306f7aa87", "element": "e966ffac-c3ee-30cf-a177-6a7707042c9c"}, "text": "Controllers watching staple share"}}, {"label": "who.chips[8].label", "set_text": {"id": {"component": "6ac73521a469d3c306f7aa87", "element": "e966ffac-c3ee-30cf-a177-6a7707042ca1"}, "text": "Owners ranking accounts by mix"}}, {"label": "look.h2", "set_text": {"id": {"component": "6ac73521a469d3c306f7aa87", "element": "e74766aa-6e79-7094-b162-0059787bef17"}, "text": "What to check before you plan on the blend"}}, {"label": "look.intro", "set_text": {"id": {"component": "6ac73521a469d3c306f7aa87", "element": "e74766aa-6e79-7094-b162-0059787bef1b"}, "text": "The blend is only as true as the split you type. Check these three before anyone builds a budget on it."}}, {"label": "look.steps[0].title", "set_text": {"id": {"component": "6ac73521a469d3c306f7aa87", "element": "e74766aa-6e79-7094-b162-0059787bef21"}, "text": "Staple share in dollars, not cases"}}, {"label": "look.steps[0].body", "set_text": {"id": {"component": "6ac73521a469d3c306f7aa87", "element": "e74766aa-6e79-7094-b162-0059787bef25"}, "text": "Weight the 60% by sales dollars. Staples are often the cheaper cases, so a share counted in cases overstates their pull on the blend."}}, {"label": "look.steps[1].title", "set_text": {"id": {"component": "6ac73521a469d3c306f7aa87", "element": "e74766aa-6e79-7094-b162-0059787bef29"}, "text": "One markup that stands for specialty"}}]