[{"label": "next.cards[0].body", "set_text": {"id": {"component": "6ac79be2180bc9b3c91fb79c", "element": "474f1684-6d1c-a992-9e47-6076e8b98975"}, "text": "Build a case cost from freight, handling and shrink, then see what your markup keeps once shrink comes out."}}, {"label": "next.cards[0].link_label", "set_text": {"id": {"component": "6ac79be2180bc9b3c91fb79c", "element": "474f1684-6d1c-a992-9e47-6076e8b98979"}, "text": "Open the material markup calculator"}}, {"label": "next.cards[0].link", "set_link": {"id": {"component": "6ac79be2180bc9b3c91fb79c", "element": "474f1684-6d1c-a992-9e47-6076e8b98977"}, "linkType": "page", "link": "6ac72b95bdfb92fbc692e782"}}, {"label": "next.cards[1].title", "set_text": {"id": {"component": "6ac79be2180bc9b3c91fb79c", "element": "474f1684-6d1c-a992-9e47-6076e8b9897f"}, "text": "Compare two pack sizes"}}, {"label": "next.cards[1].body", "set_text": {"id": {"component": "6ac79be2180bc9b3c91fb79c", "element": "474f1684-6d1c-a992-9e47-6076e8b98982"}, "text": "Put two packs on the same base, per unit and per pound, so the bigger box does not just look cheaper."}}, {"label": "next.cards[1].link_label", "set_text": {"id": {"component": "6ac79be2180bc9b3c91fb79c", "element": "474f1684-6d1c-a992-9e47-6076e8b98986"}, "text": "Open the unit price calculator"}}, {"label": "next.cards[1].link", "set_link": {"id": {"component": "6ac79be2180bc9b3c91fb79c", "element": "474f1684-6d1c-a992-9e47-6076e8b98984"}, "linkType": "page", "link": "6ac72b948f277e012d8d7584"}}, {"label": "next.cards[2].title", "set_text": {"id": {"component": "6ac79be2180bc9b3c91fb79c", "element": "474f1684-6d1c-a992-9e47-6076e8b9898c"}, "text": "Check the price against the market"}}, {"label": "next.cards[2].body", "set_text": {"id": {"component": "6ac79be2180bc9b3c91fb79c", "element": "474f1684-6d1c-a992-9e47-6076e8b9898f"}, "text": "Test your case price against a competitor's price and a flat profit target, not just a margin goal."}}, {"label": "next.cards[2].link_label", 