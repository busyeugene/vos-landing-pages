[{"label": "who.chips[4].label", "set_text": {"id": {"component": "6ac79be2180bc9b3c91fb79c", "element": "d25d63f4-1139-0a8d-2694-8da2288ae61e"}, "text": "Controllers costing trim"}}, {"label": "who.chips[5].label", "set_text": {"id": {"component": "6ac79be2180bc9b3c91fb79c", "element": "d25d63f4-1139-0a8d-2694-8da2288ae623"}, "text": "Teams repricing on grade changes"}}, {"label": "who.chips[6].label", "set_text": {"id": {"component": "6ac79be2180bc9b3c91fb79c", "element": "d25d63f4-1139-0a8d-2694-8da2288ae628"}, "text": "Reps quoting by the pound"}}, {"label": "who.chips[7].label", "set_text": {"id": {"component": "6ac79be2180bc9b3c91fb79c", "element": "d25d63f4-1139-0a8d-2694-8da2288ae62d"}, "text": "Supervisors tracking cutter yields"}}, {"label": "who.chips[8].label", "set_text": {"id": {"component": "6ac79be2180bc9b3c91fb79c", "element": "d25d63f4-1139-0a8d-2694-8da2288ae632"}, "text": "Buyers comparing supplier yields"}}, {"label": "look.h2", "set_text": {"id": {"component": "6ac79be2180bc9b3c91fb79c", "element": "928ad4b5-cf0f-f187-b5d9-705cd2bbe1cc"}, "text": "What to check before you price the cut"}}, {"label": "look.intro", "set_text": {"id": {"component": "6ac79be2180bc9b3c91fb79c", "element": "928ad4b5-cf0f-f187-b5d9-705cd2bbe1d0"}, "text": "Yield moves this price the most, and it is the input most often guessed. Check these three before a rep quotes the cut."}}, {"label": "look.steps[0].title", "set_text": {"id": {"component": "6ac79be2180bc9b3c91fb79c", "element": "928ad4b5-cf0f-f187-b5d9-705cd2bbe1d6"}, "text": "The case weight that arrives"}}, {"label": "look.steps[0].body", "set_text": {"id": {"component": "6ac79be2180bc9b3c91fb79c", "element": "928ad4b5-cf0f-f187-b5d9-705cd2bbe1da"}, "text": "If the supplier bills by the case, weigh what comes off the truck. A 40 lb case that weighs in light costs more per pound than the label says."}}, {"label": "look.steps[1].title", "set_text": {"id": {"component": "6ac79be2180bc9b3c91fb79c", "element": "928ad4b5-cf0f-f187-b5d9-705cd2bbe1de"}, "text": "Weight lost before it ships"}}, {"label": "look.steps[1].body", "set_text": {"id": {"component": "6ac79be2180bc9b3c91fb79c", "element": "928ad4b5-cf0f-f187-b5d9-705cd2bbe1e2"}, "text": "Product gives up liquid in the cooler and on the saw. Measure usable weight as it leaves, not right after cutting, or the yield reads high."}}, {"label": "look.steps[2].title", "set_text": {"id": {"component": "6ac79be2180bc9b3c91fb79c", "element": "928ad4b5-cf0f-f187-b5d9-705cd2bbe1e6"}, "text": "Trim you sell, taken off the cost"}}]