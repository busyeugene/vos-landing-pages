[{"label": "look.steps[2].body", "set_text": {"id": {"component": "6ac79be2180bc9b3c91fb79c", "element": "928ad4b5-cf0f-f187-b5d9-705cd2bbe1ea"}, "text": "If trim goes out as ground product or to a renderer, take what it earns off the $48.00. Skip that and the cut carries a cost the trim already pays back."}}, {"label": "vos.badge", "set_text": {"id": {"component": "6ac79be2180bc9b3c91fb79c", "element": "b9a34736-2aa2-a356-aeda-f615f3f10e9e"}, "text": "Order Intake"}}, {"label": "vos.h2", "set_text": {"id": {"component": "6ac79be2180bc9b3c91fb79c", "element": "b9a34736-2aa2-a356-aeda-f615f3f10e9f"}, "text": "Where VOS fits around the cut room"}}, {"label": "vos.row_badge", "set_text": {"id": {"component": "6ac79be2180bc9b3c91fb79c", "element": "b9a34736-2aa2-a356-aeda-f615f3f10ea8"}, "text": "Your Cut Room"}}, {"label": "vos.h3", "set_text": {"id": {"component": "6ac79be2180bc9b3c91fb79c", "element": "b9a34736-2aa2-a356-aeda-f615f3f10ea9"}, "text": "A confirmed order to cut against"}}, {"label": "vos.body", "set_text": {"id": {"component": "6ac79be2180bc9b3c91fb79c", "element": "b9a34736-2aa2-a356-aeda-f615f3f10ead"}, "text": "VOS does not price cut product or calculate yield. It works on the order: customers order by voice in the VOS app, review each line, and the order reaches you confirmed and timestamped."}}, {"label": "vos.bullets[0]", "set_text": {"id": {"component": "6ac79be2180bc9b3c91fb79c", "element": "b9a34736-2aa2-a356-aeda-f615f3f10eb4"}, "text": "Orders captured 24/7, overnight ones included"}}, {"label": "vos.bullets[1]", "set_text": {"id": {"component": "6ac79be2180bc9b3c91fb79c", "element": "b9a34736-2aa2-a356-aeda-f615f3f10eba"}, "text": "Each app order carries a number, so who ordered what is on record"}}, {"label": "vos.bullets[2]", "set_text": {"id": {"component": "6ac79be2180bc9b3c91fb79c", "element": "b9a34736-2aa2-a356-aeda-f615f3f10ec0"}, "text": "Delivered by email, EDI or API, in the format you use"}}, {"label": "next.h2", "set_text": {"id": {"component": "6ac79be2180bc9b3c91fb79c", "element": "474f1684-6d1c-a992-9e47-6076e8b98965"}, "text": "What to run after food markup"}}, {"label": "next.intro", "set_text": {"id": {"component": "6ac79be2180bc9b3c91fb79c", "element": "474f1684-6d1c-a992-9e47-6076e8b9896a"}, "text": "The yield price takes care of the trim. These free calculators take care of shrink, pack sizes and the pricing rule itself."}}, {"label": "next.cards[0].title", "set_text": {"id": {"component": "6ac79be2180bc9b3c91fb79c", "element": "474f1684-6d1c-a992-9e47-6076e8b98972"}, "text": "Count shrink as well as trim"}}]