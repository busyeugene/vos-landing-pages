[{"label": "next.intro", "set_text": {"id": {"component": "6ac718c668be300e93fb7203", "element": "cd0399f1-6f75-d624-d551-15498e413590"}, "text": "A pricing rule settles one case. These free calculators check the markup behind it, the volume a price change needs and the floor under extra volume."}}, {"label": "next.cards[0].title", "set_text": {"id": {"component": "6ac718c668be300e93fb7203", "element": "cd0399f1-6f75-d624-d551-15498e413598"}, "text": "Read the markup behind a price"}}, {"label": "next.cards[0].body", "set_text": {"id": {"component": "6ac718c668be300e93fb7203", "element": "cd0399f1-6f75-d624-d551-15498e41359b"}, "text": "Line up four markup rungs on one cost, with the margin each keeps, and find the markup a target margin needs."}}, {"label": "next.cards[0].link_label", "set_text": {"id": {"component": "6ac718c668be300e93fb7203", "element": "cd0399f1-6f75-d624-d551-15498e41359f"}, "text": "Open the product markup calculator"}}, {"label": "next.cards[0].link", "set_link": {"id": {"component": "6ac718c668be300e93fb7203", "element": "cd0399f1-6f75-d624-d551-15498e41359d"}, "linkType": "page", "link": "6ac7866ff16ee3a82e89dd76"}}, {"label": "next.cards[1].title", "set_text": {"id": {"component": "6ac718c668be300e93fb7203", "element": "cd0399f1-6f75-d624-d551-15498e4135a5"}, "text": "Check the volume a new price needs"}}, {"label": "next.cards[1].body", "set_text": {"id": {"component": "6ac718c668be300e93fb7203", "element": "cd0399f1-6f75-d624-d551-15498e4135a8"}, "text": "See the profit swing per case when a price moves, and how much volume a raise can lose before it costs you money."}}, {"label": "next.cards[1].link", "set_link": {"id": {"component": "6ac718c668be300e93fb7203", "element": "cd0399f1-6f75-d624-d551-15498e4135aa"}, "linkType": "page", "link": "6ac735253fe7317c927e4447"}}, {"label": "next.cards[2].title", "set_text": {"id": {"component": "6ac718c668be300e93fb7203", "element": "cd0399f1-6f75-d624-d551-15498e4135b2"}, "text": "Find the floor for extra volume"}}, {"label": "next.cards[2].body", "set_text": {"id": {"component": "6ac718c668be300e93fb7203", "element": "cd0399f1-6f75-d624-d551-15498e4135b5"}, "text": "Work out what one more case really costs, including the step cost when that volume needs another truck or route."}}, {"label": "next.cards[2].link_label", "set_text": {"id": {"component": "6ac718c668be300e93fb7203", "element": "cd0399f1-6f75-d624-d551-15498e4135b9"}, "text": "Open the marginal cost calculator"}}, {"label": "next.cards[2].link", "set_link": {"id": {"component": "6ac718c668be300e93fb7203", "element": "cd0399f1-6f75-d624-d551-15498e4135b7"}, "linkType": "page", "link": "6ac69810ef654fbdecf37f4b"}}]