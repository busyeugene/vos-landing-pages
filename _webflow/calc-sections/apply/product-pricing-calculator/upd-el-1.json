[{"label": "who.chips[8].alt.image", "set_image_asset": {"id": {"component": "6ac718c668be300e93fb7203", "element": "d5fd5a95-37e4-222d-a94e-ee6481015303"}, "image_asset_id": "6ad07a86a7398c6342ee4976"}}, {"label": "look.h2", "set_text": {"id": {"component": "6ac718c668be300e93fb7203", "element": "d5d38a9b-92f4-a3c9-6a7c-7846aacd8b25"}, "text": "Feed the pricing rules honest numbers first"}}, {"label": "look.intro", "set_text": {"id": {"component": "6ac718c668be300e93fb7203", "element": "d5d38a9b-92f4-a3c9-6a7c-7846aacd8b29"}, "text": "Each rule is only as honest as the numbers you feed it. A rep quoting off the result is trusting all three of these."}}, {"label": "next.cards[0].alt.image", "set_image_asset": {"id": {"component": "6ac718c668be300e93fb7203", "element": "cd0399f1-6f75-d624-d551-15498e413595"}, "image_asset_id": "6ad07a86f43d7bfc43f824d1"}}, {"label": "next.cards[1].body", "set_text": {"id": {"component": "6ac718c668be300e93fb7203", "element": "cd0399f1-6f75-d624-d551-15498e4135a8"}, "text": "Once you pick a price, see how the profit per case shifts and how many cases a raise can lose before profit drops."}}, {"label": "next.cards[1].alt.image", "set_image_asset": {"id": {"component": "6ac718c668be300e93fb7203", "element": "cd0399f1-6f75-d624-d551-15498e4135a2"}, "image_asset_id": "6ac71f2e6a53ab9c5d7f6eee"}}, {"label": "next.cards[2].body", "set_text": {"id": {"component": "6ac718c668be300e93fb7203", "element": "cd0399f1-6f75-d624-d551-15498e4135b5"}, "text": "See what added volume costs per case, including the jump when it takes a second truck or a new route."}}, {"label": "next.cards[2].alt.image", "set_image_asset": {"id": {"component": "6ac718c668be300e93fb7203", "element": "cd0399f1-6f75-d624-d551-15498e4135af"}, "image_asset_id": "6ad07a8582b4c538b5789ee3"}}]