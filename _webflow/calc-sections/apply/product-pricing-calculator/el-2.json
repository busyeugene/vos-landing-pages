[{"label": "look.steps[1].body", "set_text": {"id": {"component": "6ac718c668be300e93fb7203", "element": "d5d38a9b-92f4-a3c9-6a7c-7846aacd8b3b"}, "text": "Leave a supplier rebate out of the $22.00 unless you are sure to earn it. Miss the volume target and every case was priced off a cost lower than the one you paid."}}, {"label": "look.steps[2].title", "set_text": {"id": {"component": "6ac718c668be300e93fb7203", "element": "d5d38a9b-92f4-a3c9-6a7c-7846aacd8b3f"}, "text": "Volume that holds at the price"}}, {"label": "look.steps[2].body", "set_text": {"id": {"component": "6ac718c668be300e93fb7203", "element": "d5d38a9b-92f4-a3c9-6a7c-7846aacd8b43"}, "text": "The $51,360 a month assumes all 6,000 cases still sell at $30.56. If a raise costs you accounts, the real month is smaller."}}, {"label": "vos.badge", "set_text": {"id": {"component": "6ac718c668be300e93fb7203", "element": "fdb81582-abe0-588b-6cc3-3070c0202714"}, "text": "Order Guides"}}, {"label": "vos.h2", "set_text": {"id": {"component": "6ac718c668be300e93fb7203", "element": "fdb81582-abe0-588b-6cc3-3070c0202715"}, "text": "Where VOS fits in your pricing"}}, {"label": "vos.row_badge", "set_text": {"id": {"component": "6ac718c668be300e93fb7203", "element": "fdb81582-abe0-588b-6cc3-3070c020271e"}, "text": "Your Price List"}}, {"label": "vos.h3", "set_text": {"id": {"component": "6ac718c668be300e93fb7203", "element": "fdb81582-abe0-588b-6cc3-3070c020271f"}, "text": "The price you choose is the price they order at"}}, {"label": "vos.body", "set_text": {"id": {"component": "6ac718c668be300e93fb7203", "element": "fdb81582-abe0-588b-6cc3-3070c0202723"}, "text": "VOS does not set or calculate your prices. It carries yours onto the order. Each account has its own order guide at the prices you set, and orders from it by voice in the VOS app."}}, {"label": "vos.bullets[0]", "set_text": {"id": {"component": "6ac718c668be300e93fb7203", "element": "fdb81582-abe0-588b-6cc3-3070c020272a"}, "text": "Guides updated in one admin platform when you reprice"}}, {"label": "vos.bullets[1]", "set_text": {"id": {"component": "6ac718c668be300e93fb7203", "element": "fdb81582-abe0-588b-6cc3-3070c0202730"}, "text": "Each item tied to your own SKUs"}}, {"label": "vos.bullets[2]", "set_text": {"id": {"component": "6ac718c668be300e93fb7203", "element": "fdb81582-abe0-588b-6cc3-3070c0202736"}, "text": "Each app order arrives confirmed, with a number and a timestamp"}}, {"label": "next.h2", "set_text": {"id": {"component": "6ac718c668be300e93fb7203", "element": "cd0399f1-6f75-d624-d551-15498e41358b"}, "text": "What to run after product pricing"}}]