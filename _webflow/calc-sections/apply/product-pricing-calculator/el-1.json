[{"label": "who.chips[2].label", "set_text": {"id": {"component": "6ac718c668be300e93fb7203", "element": "d5fd5a95-37e4-222d-a94e-ee64810152e7"}, "text": "Buyers passing on cost increases"}}, {"label": "who.chips[3].label", "set_text": {"id": {"component": "6ac718c668be300e93fb7203", "element": "d5fd5a95-37e4-222d-a94e-ee64810152ec"}, "text": "Route reps fielding price questions"}}, {"label": "who.chips[4].label", "set_text": {"id": {"component": "6ac718c668be300e93fb7203", "element": "d5fd5a95-37e4-222d-a94e-ee64810152f1"}, "text": "Controllers checking monthly profit"}}, {"label": "who.chips[5].label", "set_text": {"id": {"component": "6ac718c668be300e93fb7203", "element": "d5fd5a95-37e4-222d-a94e-ee64810152f6"}, "text": "Teams reviewing prices each quarter"}}, {"label": "who.chips[6].label", "set_text": {"id": {"component": "6ac718c668be300e93fb7203", "element": "d5fd5a95-37e4-222d-a94e-ee64810152fb"}, "text": "Category managers pricing new SKUs"}}, {"label": "who.chips[7].label", "set_text": {"id": {"component": "6ac718c668be300e93fb7203", "element": "d5fd5a95-37e4-222d-a94e-ee6481015300"}, "text": "Reps answering a lower quote"}}, {"label": "who.chips[8].label", "set_text": {"id": {"component": "6ac718c668be300e93fb7203", "element": "d5fd5a95-37e4-222d-a94e-ee6481015305"}, "text": "Owners comparing pricing rules"}}, {"label": "look.h2", "set_text": {"id": {"component": "6ac718c668be300e93fb7203", "element": "d5d38a9b-92f4-a3c9-6a7c-7846aacd8b25"}, "text": "What to check before you trust the price"}}, {"label": "look.intro", "set_text": {"id": {"component": "6ac718c668be300e93fb7203", "element": "d5d38a9b-92f4-a3c9-6a7c-7846aacd8b29"}, "text": "Each rule is only as honest as the numbers you feed it. Check these three before a rep quotes off the result."}}, {"label": "look.steps[0].title", "set_text": {"id": {"component": "6ac718c668be300e93fb7203", "element": "d5d38a9b-92f4-a3c9-6a7c-7846aacd8b2f"}, "text": "A competitor price that is like for like"}}, {"label": "look.steps[0].body", "set_text": {"id": {"component": "6ac718c668be300e93fb7203", "element": "d5d38a9b-92f4-a3c9-6a7c-7846aacd8b33"}, "text": "A $31.00 quote may be a different pack, a different brand or a one-week deal. Match only the same case on the same delivery terms."}}, {"label": "look.steps[1].title", "set_text": {"id": {"component": "6ac718c668be300e93fb7203", "element": "d5d38a9b-92f4-a3c9-6a7c-7846aacd8b37"}, "text": "Rebates counted only once they are earned"}}]