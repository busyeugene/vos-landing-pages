[{"label": "who.chips[4].label", "set_text": {"id": {"component": "6ac7866e071fb41c4807eab0", "element": "f5dbac6c-894b-8660-2a82-9ab4d90f0ee1"}, "text": "Finance teams setting capital cost"}}, {"label": "who.chips[5].label", "set_text": {"id": {"component": "6ac7866e071fb41c4807eab0", "element": "f5dbac6c-894b-8660-2a82-9ab4d90f0ee6"}, "text": "Category managers reviewing slow lines"}}, {"label": "who.chips[6].label", "set_text": {"id": {"component": "6ac7866e071fb41c4807eab0", "element": "f5dbac6c-894b-8660-2a82-9ab4d90f0eeb"}, "text": "Sales managers costing a promotion"}}, {"label": "who.chips[7].label", "set_text": {"id": {"component": "6ac7866e071fb41c4807eab0", "element": "f5dbac6c-894b-8660-2a82-9ab4d90f0ef0"}, "text": "Warehouse leads cutting spoilage"}}, {"label": "who.chips[8].label", "set_text": {"id": {"component": "6ac7866e071fb41c4807eab0", "element": "f5dbac6c-894b-8660-2a82-9ab4d90f0ef5"}, "text": "Analysts comparing cooler and dry"}}, {"label": "look.h2", "set_text": {"id": {"component": "6ac7866e071fb41c4807eab0", "element": "f31fc820-52bd-2ac3-c0e0-8151bb03ab66"}, "text": "What to look for before you trust the rate"}}, {"label": "look.intro", "set_text": {"id": {"component": "6ac7866e071fb41c4807eab0", "element": "f31fc820-52bd-2ac3-c0e0-8151bb03ab6a"}, "text": "Five rates add up in seconds. Whether each one is honest takes longer. Check these three before the 27% goes into a buying decision."}}, {"label": "look.steps[0].title", "set_text": {"id": {"component": "6ac7866e071fb41c4807eab0", "element": "f31fc820-52bd-2ac3-c0e0-8151bb03ab70"}, "text": "Only costs that move with stock"}}, {"label": "look.steps[0].body", "set_text": {"id": {"component": "6ac7866e071fb41c4807eab0", "element": "f31fc820-52bd-2ac3-c0e0-8151bb03ab74"}, "text": "A lease you pay at any stock level is not a carrying cost unless holding less would free the space. Count it anyway and the 7 storage points read high."}}, {"label": "look.steps[1].title", "set_text": {"id": {"component": "6ac7866e071fb41c4807eab0", "element": "f31fc820-52bd-2ac3-c0e0-8151bb03ab78"}, "text": "Losses priced at cost"}}, {"label": "look.steps[1].body", "set_text": {"id": {"component": "6ac7866e071fb41c4807eab0", "element": "f31fc820-52bd-2ac3-c0e0-8151bb03ab7c"}, "text": "Value the dump log at what you paid, the same basis as the $132,000. Price it at sell price and the 6 spoilage points come out too high."}}, {"label": "look.steps[2].title", "set_text": {"id": {"component": "6ac7866e071fb41c4807eab0", "element": "f31fc820-52bd-2ac3-c0e0-8151bb03ab80"}, "text": "A normal year in the dump log"}}]