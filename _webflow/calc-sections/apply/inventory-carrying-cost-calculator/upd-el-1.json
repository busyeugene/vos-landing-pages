[{"label": "who.chips[6].alt.image", "set_image_asset": {"id": {"component": "6ac7866e071fb41c4807eab0", "element": "f5dbac6c-894b-8660-2a82-9ab4d90f0ee9"}, "image_asset_id": "6ad07a87835ef439cc7910a2"}}, {"label": "who.chips[7].alt.image", "set_image_asset": {"id": {"component": "6ac7866e071fb41c4807eab0", "element": "f5dbac6c-894b-8660-2a82-9ab4d90f0eee"}, "image_asset_id": "6ad07a8582ff418bc8a6c6b6"}}, {"label": "who.chips[8].alt.image", "set_image_asset": {"id": {"component": "6ac7866e071fb41c4807eab0", "element": "f5dbac6c-894b-8660-2a82-9ab4d90f0ef3"}, "image_asset_id": "6ad07a8c46e29627d6ef796b"}}, {"label": "look.h2", "set_text": {"id": {"component": "6ac7866e071fb41c4807eab0", "element": "f31fc820-52bd-2ac3-c0e0-8151bb03ab66"}, "text": "Each carrying cost rate needs a second look"}}, {"label": "look.intro", "set_text": {"id": {"component": "6ac7866e071fb41c4807eab0", "element": "f31fc820-52bd-2ac3-c0e0-8151bb03ab6a"}, "text": "Five rates add up in seconds. Whether each one is honest takes longer. Run through the points below before the 27% steers a buying decision."}}, {"label": "vos.body", "set_text": {"id": {"component": "6ac7866e071fb41c4807eab0", "element": "673f7f14-a000-bb6f-db99-52bf2b90c169"}, "text": "VOS does not price your holding costs or change any of the five rates. Its part is on the selling side, where dated stock goes out. Promos reach your customers by notification and text, and they order by voice in the VOS app."}}, {"label": "next.cards[0].body", "set_text": {"id": {"component": "6ac7866e071fb41c4807eab0", "element": "71afd5bd-232e-ecff-6888-7c9689bdc011"}, "text": "Turn cost of goods and average stock into turns a year, days on hand, and the dollars a slow turn leaves sitting."}}, {"label": "next.cards[0].alt.image", "set_image_asset": {"id": {"component": "6ac7866e071fb41c4807eab0", "element": "71afd5bd-232e-ecff-6888-7c9689bdc00b"}, "image_asset_id": "6ad07a86f43d7bfc43f824d1"}}, {"label": "next.cards[1].alt.image", "set_image_asset": {"id": {"component": "6ac7866e071fb41c4807eab0", "element": "71afd5bd-232e-ecff-6888-7c9689bdc018"}, "image_asset_id": "6ad07a8582b4c538b5789ee3"}}, {"label": "next.cards[2].alt.image", "set_image_asset": {"id": {"component": "6ac7866e071fb41c4807eab0", "element": "71afd5bd-232e-ecff-6888-7c9689bdc025"}, "image_asset_id": "6ac71f2fdacb5c302d9d5d2f"}}]