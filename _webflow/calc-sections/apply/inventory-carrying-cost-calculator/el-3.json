[{"label": "next.cards[0].title", "set_text": {"id": {"component": "6ac7866e071fb41c4807eab0", "element": "71afd5bd-232e-ecff-6888-7c9689bdc00e"}, "text": "See how long a case sits"}}, {"label": "next.cards[0].body", "set_text": {"id": {"component": "6ac7866e071fb41c4807eab0", "element": "71afd5bd-232e-ecff-6888-7c9689bdc011"}, "text": "Find how many times a year your stock turns, how long a case sits, and the cash a slow turn ties up."}}, {"label": "next.cards[0].link_label", "set_text": {"id": {"component": "6ac7866e071fb41c4807eab0", "element": "71afd5bd-232e-ecff-6888-7c9689bdc015"}, "text": "Open the inventory turnover calculator"}}, {"label": "next.cards[0].link", "set_link": {"id": {"component": "6ac7866e071fb41c4807eab0", "element": "71afd5bd-232e-ecff-6888-7c9689bdc013"}, "linkType": "page", "link": "6ac7252ae188e18d1d906bba"}}, {"label": "next.cards[1].title", "set_text": {"id": {"component": "6ac7866e071fb41c4807eab0", "element": "71afd5bd-232e-ecff-6888-7c9689bdc01b"}, "text": "Check what the buffer parks in cash"}}, {"label": "next.cards[1].body", "set_text": {"id": {"component": "6ac7866e071fb41c4807eab0", "element": "71afd5bd-232e-ecff-6888-7c9689bdc01e"}, "text": "Size a buffer from how much demand and lead times move, pick a service level, and see the cash it ties up."}}, {"label": "next.cards[1].link_label", "set_text": {"id": {"component": "6ac7866e071fb41c4807eab0", "element": "71afd5bd-232e-ecff-6888-7c9689bdc022"}, "text": "Open the safety stock calculator"}}, {"label": "next.cards[1].link", "set_link": {"id": {"component": "6ac7866e071fb41c4807eab0", "element": "71afd5bd-232e-ecff-6888-7c9689bdc020"}, "linkType": "page", "link": "6ac735249b6f12d26ba60ce1"}}, {"label": "next.cards[2].title", "set_text": {"id": {"component": "6ac7866e071fb41c4807eab0", "element": "71afd5bd-232e-ecff-6888-7c9689bdc028"}, "text": "Size the floor your stock fills"}}, {"label": "next.cards[2].body", "set_text": {"id": {"component": "6ac7866e071fb41c4807eab0", "eleme