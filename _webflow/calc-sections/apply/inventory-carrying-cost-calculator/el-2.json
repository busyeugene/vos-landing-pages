[{"label": "look.steps[2].body", "set_text": {"id": {"component": "6ac7866e071fb41c4807eab0", "element": "f31fc820-52bd-2ac3-c0e0-8151bb03ab84"}, "text": "One freezer failure or recall can swamp a year of spoilage. Take it out, or price it on its own, before it sets the rate for years after."}}, {"label": "vos.badge", "set_text": {"id": {"component": "6ac7866e071fb41c4807eab0", "element": "673f7f14-a000-bb6f-db99-52bf2b90c15a"}, "text": "Selling Side"}}, {"label": "vos.h2", "set_text": {"id": {"component": "6ac7866e071fb41c4807eab0", "element": "673f7f14-a000-bb6f-db99-52bf2b90c15b"}, "text": "Where VOS fits in your carrying cost"}}, {"label": "vos.row_badge", "set_text": {"id": {"component": "6ac7866e071fb41c4807eab0", "element": "673f7f14-a000-bb6f-db99-52bf2b90c164"}, "text": "Your Spoilage Line"}}, {"label": "vos.h3", "set_text": {"id": {"component": "6ac7866e071fb41c4807eab0", "element": "673f7f14-a000-bb6f-db99-52bf2b90c165"}, "text": "Dated stock costs least when it sells in time"}}, {"label": "vos.body", "set_text": {"id": {"component": "6ac7866e071fb41c4807eab0", "element": "673f7f14-a000-bb6f-db99-52bf2b90c169"}, "text": "VOS does not price your holding costs or change any of the five rates. It works on the selling side: your customers order by voice in the VOS app, and promos reach them by notification and text."}}, {"label": "vos.bullets[0]", "set_text": {"id": {"component": "6ac7866e071fb41c4807eab0", "element": "673f7f14-a000-bb6f-db99-52bf2b90c170"}, "text": "Order guides and prices updated in one admin platform"}}, {"label": "vos.bullets[1]", "set_text": {"id": {"component": "6ac7866e071fb41c4807eab0", "element": "673f7f14-a000-bb6f-db99-52bf2b90c176"}, "text": "Sales reps freed to sell, not to take orders"}}, {"label": "vos.bullets[2]", "set_text": {"id": {"component": "6ac7866e071fb41c4807eab0", "element": "673f7f14-a000-bb6f-db99-52bf2b90c17c"}, "text": "Orders captured 24/7, after hours included"}}, {"label": "vos.bullets[3]", "set_text": {"id": {"component": "6ac7866e071fb41c4807eab0", "element": "673f7f14-a000-bb6f-db99-52bf2b90c182"}, "text": "Most customers place a first order the same day"}}, {"label": "next.h2", "set_text": {"id": {"component": "6ac7866e071fb41c4807eab0", "element": "71afd5bd-232e-ecff-6888-7c9689bdc001"}, "text": "What to run after carrying cost"}}, {"label": "next.intro", "set_text": {"id": {"component": "6ac7866e071fb41c4807eab0", "element": "71afd5bd-232e-ecff-6888-7c9689bdc006"}, "text": "The rate prices a dollar of stock for a year. These free calculators show how long the stock sits, what a buffer parks, and how much floor it fills."}}]