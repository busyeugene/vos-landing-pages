[{"label": "look.steps[2].body", "set_text": {"id": {"component": "6ac735249b6f12d26ba60ce1", "element": "d4e21acd-1028-79b7-cfce-9c2dba8e7532"}, "text": "It means a 5.0% chance of running out in each restock cycle. It is not a 95% fill rate, which counts the cases you ship."}}, {"label": "vos.badge", "set_text": {"id": {"component": "6ac735249b6f12d26ba60ce1", "element": "a8f80bb6-6a4f-5545-4a31-af378bf6215a"}, "text": "Order History"}}, {"label": "vos.h2", "set_text": {"id": {"component": "6ac735249b6f12d26ba60ce1", "element": "a8f80bb6-6a4f-5545-4a31-af378bf6215b"}, "text": "Where VOS fits in your buffer"}}, {"label": "vos.row_badge", "set_text": {"id": {"component": "6ac735249b6f12d26ba60ce1", "element": "a8f80bb6-6a4f-5545-4a31-af378bf62164"}, "text": "Your Demand Swing"}}, {"label": "vos.h3", "set_text": {"id": {"component": "6ac735249b6f12d26ba60ce1", "element": "a8f80bb6-6a4f-5545-4a31-af378bf62165"}, "text": "The swing starts with what each account orders"}}, {"label": "vos.body", "set_text": {"id": {"component": "6ac735249b6f12d26ba60ce1", "element": "a8f80bb6-6a4f-5545-4a31-af378bf62169"}, "text": "VOS does not size your buffer or forecast demand. It keeps a record to check your swing against: each order placed by voice in the VOS app, by account and time."}}, {"label": "vos.bullets[0]", "set_text": {"id": {"component": "6ac735249b6f12d26ba60ce1", "element": "a8f80bb6-6a4f-5545-4a31-af378bf62170"}, "text": "Order history per account in one admin platform"}}, {"label": "vos.bullets[1]", "set_text": {"id": {"component": "6ac735249b6f12d26ba60ce1", "element": "a8f80bb6-6a4f-5545-4a31-af378bf62176"}, "text": "Each app order carries a date and a timestamp"}}, {"label": "vos.bullets[2]", "set_text": {"id": {"component": "6ac735249b6f12d26ba60ce1", "element": "a8f80bb6-6a4f-5545-4a31-af378bf6217c"}, "text": "Customers review each line before sending"}}, {"label": "vos.bullets[3]", "set_text": {"id": {"component": "6ac735249b6f12d26ba60ce1", "element": "a8f80bb6-6a4f-5545-4a31-af378bf62182"}, "text": "Works alongside your ERP, with nothing to rip out"}}, {"label": "next.h2", "set_text": {"id": {"component": "6ac735249b6f12d26ba60ce1", "element": "fe483b97-c77d-1e06-c9d0-5cf68bf8ef30"}, "text": "What to run after safety stock"}}, {"label": "next.intro", "set_text": {"id": {"component": "6ac735249b6f12d26ba60ce1", "element": "fe483b97-c77d-1e06-c9d0-5cf68bf8ef35"}, "text": "Safety stock sizes the buffer. These free calculators turn it into a trigger, price what holding it costs, and set the level each order restores."}}]