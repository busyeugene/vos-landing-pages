[{"label": "who.chips[4].label", "set_text": {"id": {"component": "6ac735249b6f12d26ba60ce1", "element": "3987e627-7415-be05-4136-c09b74bf6a1c"}, "text": "Controllers pricing extra service points"}}, {"label": "who.chips[5].label", "set_text": {"id": {"component": "6ac735249b6f12d26ba60ce1", "element": "3987e627-7415-be05-4136-c09b74bf6a21"}, "text": "Planners rerunning after supplier changes"}}, {"label": "who.chips[6].label", "set_text": {"id": {"component": "6ac735249b6f12d26ba60ce1", "element": "3987e627-7415-be05-4136-c09b74bf6a26"}, "text": "Sales managers setting service promises"}}, {"label": "who.chips[7].label", "set_text": {"id": {"component": "6ac735249b6f12d26ba60ce1", "element": "3987e627-7415-be05-4136-c09b74bf6a2b"}, "text": "Ops teams cutting spoiled buffer"}}, {"label": "who.chips[8].label", "set_text": {"id": {"component": "6ac735249b6f12d26ba60ce1", "element": "3987e627-7415-be05-4136-c09b74bf6a30"}, "text": "Analysts comparing lines by swing"}}, {"label": "look.h2", "set_text": {"id": {"component": "6ac735249b6f12d26ba60ce1", "element": "d4e21acd-1028-79b7-cfce-9c2dba8e7514"}, "text": "What to look for before you trust the buffer"}}, {"label": "look.intro", "set_text": {"id": {"component": "6ac735249b6f12d26ba60ce1", "element": "d4e21acd-1028-79b7-cfce-9c2dba8e7518"}, "text": "The formula does the hard part. The swings you feed it decide the answer. Check these three before you commit cash to a buffer."}}, {"label": "look.steps[0].title", "set_text": {"id": {"component": "6ac735249b6f12d26ba60ce1", "element": "d4e21acd-1028-79b7-cfce-9c2dba8e751e"}, "text": "A swing measured day by day"}}, {"label": "look.steps[0].body", "set_text": {"id": {"component": "6ac735249b6f12d26ba60ce1", "element": "d4e21acd-1028-79b7-cfce-9c2dba8e7522"}, "text": "The 35 case swing is how far one day strays from 120. Work it out from weekly totals divided by seven and it comes out too small."}}, {"label": "look.steps[1].title", "set_text": {"id": {"component": "6ac735249b6f12d26ba60ce1", "element": "d4e21acd-1028-79b7-cfce-9c2dba8e7526"}, "text": "Demand, not shipments"}}, {"label": "look.steps[1].body", "set_text": {"id": {"component": "6ac735249b6f12d26ba60ce1", "element": "d4e21acd-1028-79b7-cfce-9c2dba8e752a"}, "text": "In a week you ran short, shipments look calmer than what accounts asked for. Build the swing from orders, or the short weeks shrink the buffer meant to cover them."}}, {"label": "look.steps[2].title", "set_text": {"id": {"component": "6ac735249b6f12d26ba60ce1", "element": "d4e21acd-1028-79b7-cfce-9c2dba8e752e"}, "text": "What 95% really promises"}}]