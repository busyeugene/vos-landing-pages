[{"label": "next.cards[0].title", "set_text": {"id": {"component": "6ac735249b6f12d26ba60ce1", "element": "fe483b97-c77d-1e06-c9d0-5cf68bf8ef3d"}, "text": "Turn the buffer into a trigger"}}, {"label": "next.cards[0].body", "set_text": {"id": {"component": "6ac735249b6f12d26ba60ce1", "element": "fe483b97-c77d-1e06-c9d0-5cf68bf8ef40"}, "text": "Add the buffer to lead time demand for the stock level that starts the next order, plus the days of cover you have left."}}, {"label": "next.cards[0].link_label", "set_text": {"id": {"component": "6ac735249b6f12d26ba60ce1", "element": "fe483b97-c77d-1e06-c9d0-5cf68bf8ef44"}, "text": "Open the reorder point calculator"}}, {"label": "next.cards[0].link", "set_link": {"id": {"component": "6ac735249b6f12d26ba60ce1", "element": "fe483b97-c77d-1e06-c9d0-5cf68bf8ef42"}, "linkType": "page", "link": "6ac7652a2a715d3e702a0559"}}, {"label": "next.cards[1].title", "set_text": {"id": {"component": "6ac735249b6f12d26ba60ce1", "element": "fe483b97-c77d-1e06-c9d0-5cf68bf8ef4a"}, "text": "Price the cost of holding it"}}, {"label": "next.cards[1].body", "set_text": {"id": {"component": "6ac735249b6f12d26ba60ce1", "element": "fe483b97-c77d-1e06-c9d0-5cf68bf8ef4d"}, "text": "Build a carrying rate from capital, storage, spoilage, insurance and obsolescence, instead of borrowing a rule of thumb."}}, {"label": "next.cards[1].link_label", "set_text": {"id": {"component": "6ac735249b6f12d26ba60ce1", "element": "fe483b97-c77d-1e06-c9d0-5cf68bf8ef51"}, "text": "Open the inventory carrying cost calculator"}}, {"label": "next.cards[1].link", "set_link": {"id": {"component": "6ac735249b6f12d26ba60ce1", "element": "fe483b97-c77d-1e06-c9d0-5cf68bf8ef4f"}, "linkType": "page", "link": "6ac7866e071fb41c4807eab0"}}, {"label": "next.cards[2].title", "set_text": {"id": {"component": "6ac735249b6f12d26ba60ce1", "element": "fe483b97-c77d-1e06-c9d0-5cf68bf8ef57"}, "text": "Set the level each order restores"}}, {"label": "next.cards[2].body", "set_text": {"id": {"component": "6ac735249b6f12d26ba60ce1", "element": "fe483b97-c77d-1e06-c9d0-5cf68bf8ef5a"}, "text": "Work out the level each line tops back up to between deliveries, and what each buffer day ties up in cash."}}, {"label": "next.cards[2].link_label", "set_text": {"id": {"component": "6ac735249b6f12d26ba60ce1", "element": "fe483b97-c77d-1e06-c9d0-5cf68bf8ef5e"}, "text": "Open the par level calculator"}}, {"label": "next.cards[2].link", "set_link": {"id": {"component": "6ac735249b6f12d26ba60ce1", "element": "fe483b97-c77d-1e06-c9d0-5cf68bf8ef5c"}, "linkType": "page", "link": "6ac79be1b863c26cbc96979a"}}]