[{"label": "who.chips[4].label", "set_text": {"id": {"component": "6ac76528743f1f2a6f8ae6e6", "element": "d024d6c0-dd23-426b-637e-7a394e4c789e"}, "text": "Key account managers defending margin"}}, {"label": "who.chips[5].label", "set_text": {"id": {"component": "6ac76528743f1f2a6f8ae6e6", "element": "d024d6c0-dd23-426b-637e-7a394e4c78a3"}, "text": "Merchandisers checking tags after resets"}}, {"label": "who.chips[6].label", "set_text": {"id": {"component": "6ac76528743f1f2a6f8ae6e6", "element": "d024d6c0-dd23-426b-637e-7a394e4c78a8"}, "text": "Reps suggesting a shelf price"}}, {"label": "who.chips[7].label", "set_text": {"id": {"component": "6ac76528743f1f2a6f8ae6e6", "element": "d024d6c0-dd23-426b-637e-7a394e4c78ad"}, "text": "Managers reviewing slow lines"}}, {"label": "who.chips[8].label", "set_text": {"id": {"component": "6ac76528743f1f2a6f8ae6e6", "element": "d024d6c0-dd23-426b-637e-7a394e4c78b2"}, "text": "Reps comparing against rival lines"}}, {"label": "look.h2", "set_text": {"id": {"component": "6ac76528743f1f2a6f8ae6e6", "element": "a42eba35-d95b-52d2-b914-017673fcb911"}, "text": "What to check before you quote the margin"}}, {"label": "look.intro", "set_text": {"id": {"component": "6ac76528743f1f2a6f8ae6e6", "element": "a42eba35-d95b-52d2-b914-017673fcb915"}, "text": "Two of the inputs come from the store's side, and both drift. Check these three before a number goes in front of a buyer."}}, {"label": "look.steps[0].title", "set_text": {"id": {"component": "6ac76528743f1f2a6f8ae6e6", "element": "a42eba35-d95b-52d2-b914-017673fcb91b"}, "text": "The tag on the shelf today"}}, {"label": "look.steps[0].body", "set_text": {"id": {"component": "6ac76528743f1f2a6f8ae6e6", "element": "a42eba35-d95b-52d2-b914-017673fcb91f"}, "text": "Use the price the store charges now, not the suggested price on your sell sheet. Stores move tags without telling their suppliers."}}, {"label": "look.steps[1].title", "set_text": {"id": {"component": "6ac76528743f1f2a6f8ae6e6", "element": "a42eba35-d95b-52d2-b914-017673fcb923"}, "text": "The store's cost after allowances"}}, {"label": "look.steps[1].body", "set_text": {"id": {"component": "6ac76528743f1f2a6f8ae6e6", "element": "a42eba35-d95b-52d2-b914-017673fcb927"}, "text": "If you pay a store a billback or a promotional allowance, take it off their unit cost for the weeks it runs. Leave it in and their margin reads lower than they see it."}}, {"label": "look.steps[2].title", "set_text": {"id": {"component": "6ac76528743f1f2a6f8ae6e6", "element": "a42eba35-d95b-52d2-b914-017673fcb92b"}, "text": "The unit the shelf really sells"}}]