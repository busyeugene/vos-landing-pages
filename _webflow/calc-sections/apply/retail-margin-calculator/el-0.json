[{"label": "whatis.h2", "set_text": {"id": {"component": "6ac76528743f1f2a6f8ae6e6", "element": "cd44b7a2-2c0d-5680-ff40-10ad4b19b75d"}, "text": "What is retail margin?"}}, {"label": "whatis.intro", "set_text": {"id": {"component": "6ac76528743f1f2a6f8ae6e6", "element": "cd44b7a2-2c0d-5680-ff40-10ad4b19b762"}, "text": "Retail margin is the share of the shelf price a store keeps once the item is paid for. It is the number store buyers plan in. For a distributor, the store's unit cost is your case price split by the pack, so your price sits inside their margin."}}, {"label": "whatis.cards[0].body", "set_text": {"id": {"component": "6ac76528743f1f2a6f8ae6e6", "element": "cd44b7a2-2c0d-5680-ff40-10ad4b19b76d"}, "text": "The gap between the tag and the unit cost, divided by the tag. A $2.38 unit on a $3.97 tag keeps $1.59, which is 40.1%."}}, {"label": "whatis.cards[1].body", "set_text": {"id": {"component": "6ac76528743f1f2a6f8ae6e6", "element": "cd44b7a2-2c0d-5680-ff40-10ad4b19b775"}, "text": "The store's labor, rent and power for the cold case. Retail margin is gross, so all of that is paid out of it later."}}, {"label": "whatis.cards[2].title", "set_text": {"id": {"component": "6ac76528743f1f2a6f8ae6e6", "element": "cd44b7a2-2c0d-5680-ff40-10ad4b19b77a"}, "text": "Why a supplier runs it"}}, {"label": "whatis.cards[2].body", "set_text": {"id": {"component": "6ac76528743f1f2a6f8ae6e6", "element": "cd44b7a2-2c0d-5680-ff40-10ad4b19b77d"}, "text": "Shelf space goes to the lines that earn the store money. Your case price is the one input in that margin you control."}}, {"label": "who.h2", "set_text": {"id": {"component": "6ac76528743f1f2a6f8ae6e6", "element": "d024d6c0-dd23-426b-637e-7a394e4c7880"}, "text": "Who uses a retail margin calculator"}}, {"label": "who.intro", "set_text": {"id": {"component": "6ac76528743f1f2a6f8ae6e6", "element": "d024d6c0-dd23-426b-637e-7a394e4c7885"}, "text": "It is built for independent and DSD food distributors who sell into stores. Anyone who meets a store buyer, suggests a shelf price or defends a line should run it first."}}, {"label": "who.chips[0].label", "set_text": {"id": {"component": "6ac76528743f1f2a6f8ae6e6", "element": "d024d6c0-dd23-426b-637e-7a394e4c788a"}, "text": "Owners pricing store accounts"}}, {"label": "who.chips[1].label", "set_text": {"id": {"component": "6ac76528743f1f2a6f8ae6e6", "element": "d024d6c0-dd23-426b-637e-7a394e4c788f"}, "text": "Reps preparing a category review"}}, {"label": "who.chips[2].label", "set_text": {"id": {"component": "6ac76528743f1f2a6f8ae6e6", "element": "d024d6c0-dd23-426b-637e-7a394e4c7894"}, "text": "Sales managers pitching new lines"}}, {"label": "who.chips[3].label", "set_text": {"id": {"component": "6ac76528743f1f2a6f8ae6e6", "element": "d024d6c0-dd23-426b-637e-7a394e4c7899"}, "text": "DSD reps checking store shelves"}}]