[{"label": "look.steps[2].body", "set_text": {"id": {"component": "6ac76528743f1f2a6f8ae6e6", "element": "a42eba35-d95b-52d2-b914-017673fcb92f"}, "text": "Split the case by the units that scan. A 12-unit case sold as six twin packs has a different unit cost and a different tag."}}, {"label": "vos.badge", "set_text": {"id": {"component": "6ac76528743f1f2a6f8ae6e6", "element": "0bae9749-e889-a783-22e6-a9ae7817b600"}, "text": "Store Accounts"}}, {"label": "vos.h2", "set_text": {"id": {"component": "6ac76528743f1f2a6f8ae6e6", "element": "0bae9749-e889-a783-22e6-a9ae7817b601"}, "text": "Where VOS fits with your store accounts"}}, {"label": "vos.row_badge", "set_text": {"id": {"component": "6ac76528743f1f2a6f8ae6e6", "element": "0bae9749-e889-a783-22e6-a9ae7817b60a"}, "text": "Your Case Price"}}, {"label": "vos.h3", "set_text": {"id": {"component": "6ac76528743f1f2a6f8ae6e6", "element": "0bae9749-e889-a783-22e6-a9ae7817b60b"}, "text": "The case price behind their margin"}}, {"label": "vos.body", "set_text": {"id": {"component": "6ac76528743f1f2a6f8ae6e6", "element": "0bae9749-e889-a783-22e6-a9ae7817b60f"}, "text": "VOS does not calculate a store's margin or set its shelf price. It keeps your side clear: each store orders by voice in the VOS app from a guide at the prices you set."}}, {"label": "vos.bullets[0]", "set_text": {"id": {"component": "6ac76528743f1f2a6f8ae6e6", "element": "0bae9749-e889-a783-22e6-a9ae7817b616"}, "text": "Promos and confirmations reach stores by notification and text"}}, {"label": "vos.bullets[1]", "set_text": {"id": {"component": "6ac76528743f1f2a6f8ae6e6", "element": "0bae9749-e889-a783-22e6-a9ae7817b61c"}, "text": "For DSD, drivers arrive with the right product"}}, {"label": "vos.bullets[2]", "set_text": {"id": {"component": "6ac76528743f1f2a6f8ae6e6", "element": "0bae9749-e889-a783-22e6-a9ae7817b622"}, "text": "Orders captured 24/7, after hours included"}}, {"label": "vos.bullets[3]", "set_text": {"id": {"component": "6ac76528743f1f2a6f8ae6e6", "element": "0bae9749-e889-a783-22e6-a9ae7817b628"}, "text": "Most customers place a first order the same day"}}, {"label": "next.h2", "set_text": {"id": {"component": "6ac76528743f1f2a6f8ae6e6", "element": "31760d9e-5504-7350-ffe2-bee11413aa46"}, "text": "What to run after retail margin"}}, {"label": "next.intro", "set_text": {"id": {"component": "6ac76528743f1f2a6f8ae6e6", "element": "31760d9e-5504-7350-ffe2-bee11413aa4b"}, "text": "Retail margin shows the store's side of the sum. These free calculators work back to your markup, the full chain and your own case price."}}]