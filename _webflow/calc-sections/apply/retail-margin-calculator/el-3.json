[{"label": "next.cards[0].title", "set_text": {"id": {"component": "6ac76528743f1f2a6f8ae6e6", "element": "31760d9e-5504-7350-ffe2-bee11413aa53"}, "text": "Put your own markup on a ladder"}}, {"label": "next.cards[0].body", "set_text": {"id": {"component": "6ac76528743f1f2a6f8ae6e6", "element": "31760d9e-5504-7350-ffe2-bee11413aa56"}, "text": "Switch to your own side: one case cost priced at four markup rungs, with the margin each one keeps."}}, {"label": "next.cards[0].link_label", "set_text": {"id": {"component": "6ac76528743f1f2a6f8ae6e6", "element": "31760d9e-5504-7350-ffe2-bee11413aa5a"}, "text": "Open the product markup calculator"}}, {"label": "next.cards[0].link", "set_link": {"id": {"component": "6ac76528743f1f2a6f8ae6e6", "element": "31760d9e-5504-7350-ffe2-bee11413aa58"}, "linkType": "page", "link": "6ac7866ff16ee3a82e89dd76"}}, {"label": "next.cards[1].title", "set_text": {"id": {"component": "6ac76528743f1f2a6f8ae6e6", "element": "31760d9e-5504-7350-ffe2-bee11413aa60"}, "text": "Follow one case to the shelf"}}, {"label": "next.cards[1].body", "set_text": {"id": {"component": "6ac76528743f1f2a6f8ae6e6", "element": "31760d9e-5504-7350-ffe2-bee11413aa63"}, "text": "Trace a case from your cost to the shelf price, and check your price still leaves the retailer enough margin to stock you."}}, {"label": "next.cards[1].link_label", "set_text": {"id": {"component": "6ac76528743f1f2a6f8ae6e6", "element": "31760d9e-5504-7350-ffe2-bee11413aa67"}, "text": "Open the wholesale to retail markup calculator"}}, {"label": "next.cards[1].link", "set_link": {"id": {"component": "6ac76528743f1f2a6f8ae6e6", "element": "31760d9e-5504-7350-ffe2-bee11413aa65"}, "linkType": "page", "link": "6ac73522edd07accabdbe401"}}, {"label": "next.cards[2].title", "set_text": {"id": {"component": "6ac76528743f1f2a6f8ae6e6", "element": "31760d9e-5504-7350-ffe2-bee11413aa6d"}, "text": "Set your case price three ways"}}, {"label": "next.cards[2].body", "set_text": {"id": {"component": "6ac76528743f1f2a6f8ae6e6", "element": "31760d9e-5504-7350-ffe2-bee11413aa70"}, "text": "Work out your case price from a target margin, a dollar profit per case or a competitor's price, and compare what each keeps."}}, {"label": "next.cards[2].link_label", "set_text": {"id": {"component": "6ac76528743f1f2a6f8ae6e6", "element": "31760d9e-5504-7350-ffe2-bee11413aa74"}, "text": "Open the product pricing calculator"}}, {"label": "next.cards[2].link", "set_link": {"id": {"component": "6ac76528743f1f2a6f8ae6e6", "element": "31760d9e-5504-7350-ffe2-bee11413aa72"}, "linkType": "page", "link": "6ac718c668be300e93fb7203"}}]