[{"label": "next.cards[0].title", "set_text": {"id": {"component": "6ac72b95bdfb92fbc692e782", "element": "eadb9345-c69b-b435-fb88-3d3bda973aa1"}, "text": "Rank supplier quotes on landed cost"}}, {"label": "next.cards[0].body", "set_text": {"id": {"component": "6ac72b95bdfb92fbc692e782", "element": "eadb9345-c69b-b435-fb88-3d3bda973aa4"}, "text": "Compare three supplier quotes per unit with freight counted, since the cheapest case price is rarely the cheapest unit."}}, {"label": "next.cards[0].link_label", "set_text": {"id": {"component": "6ac72b95bdfb92fbc692e782", "element": "eadb9345-c69b-b435-fb88-3d3bda973aa8"}, "text": "Open the landed cost calculator"}}, {"label": "next.cards[0].link", "set_link": {"id": {"component": "6ac72b95bdfb92fbc692e782", "element": "eadb9345-c69b-b435-fb88-3d3bda973aa6"}, "linkType": "page", "link": "6ac7652962cd713ecd056f43"}}, {"label": "next.cards[1].title", "set_text": {"id": {"component": "6ac72b95bdfb92fbc692e782", "element": "eadb9345-c69b-b435-fb88-3d3bda973aae"}, "text": "See what staples do to the blend"}}, {"label": "next.cards[1].body", "set_text": {"id": {"component": "6ac72b95bdfb92fbc692e782", "element": "eadb9345-c69b-b435-fb88-3d3bda973ab1"}, "text": "Take a landed cost to a wholesale price, then watch thin staple markups pull your blended margin down."}}, {"label": "next.cards[1].link_label", "set_text": {"id": {"component": "6ac72b95bdfb92fbc692e782", "element": "eadb9345-c69b-b435-fb88-3d3bda973ab5"}, "text": "Open the wholesale markup calculator"}}, {"label": "next.cards[1].link", "set_link": {"id": {"component": "6ac72b95bdfb92fbc692e782", "element": "eadb9345-c69b-b435-fb88-3d3bda973ab3"}, "linkType": "page", "link": "6ac73521a469d3c306f7aa87"}}, {"label": "next.cards[2].title", "set_text": {"id": {"component": "6ac72b95bdfb92fbc692e782", "element": "eadb9345-c69b-b435-fb88-3d3bda973abb"}, "text": "Read every markup rung at once"}}, {"label": "next.cards[2].body", "set_text": {"id": {"component": "6ac72b95bdfb92fbc692e782", "element": "eadb9345-c69b-b435-fb88-3d3bda973abe"}, "text": "Enter one cost and see the price and margin at four markup rungs, plus the markup a target margin needs."}}, {"label": "next.cards[2].link_label", "set_text": {"id": {"component": "6ac72b95bdfb92fbc692e782", "element": "eadb9345-c69b-b435-fb88-3d3bda973ac2"}, "text": "Open the product markup calculator"}}, {"label": "next.cards[2].link", "set_link": {"id": {"component": "6ac72b95bdfb92fbc692e782", "element": "eadb9345-c69b-b435-fb88-3d3bda973ac0"}, "linkType": "page", "link": "6ac7866ff16ee3a82e89dd76"}}]