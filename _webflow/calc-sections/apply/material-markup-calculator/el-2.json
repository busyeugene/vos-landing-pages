[{"label": "look.steps[2].body", "set_text": {"id": {"component": "6ac72b95bdfb92fbc692e782", "element": "2c639199-1a57-8562-cbdc-9eb60fd58cb9"}, "text": "Use the credits and write-offs in your own books, not a rule of thumb. The 3% default is a starting point, and perishables can run higher."}}, {"label": "vos.badge", "set_text": {"id": {"component": "6ac72b95bdfb92fbc692e782", "element": "c3f3f125-1a3a-df21-12e1-8aa0c50c0a19"}, "text": "Order Review"}}, {"label": "vos.h2", "set_text": {"id": {"component": "6ac72b95bdfb92fbc692e782", "element": "c3f3f125-1a3a-df21-12e1-8aa0c50c0a1a"}, "text": "Where VOS fits after the markup"}}, {"label": "vos.row_badge", "set_text": {"id": {"component": "6ac72b95bdfb92fbc692e782", "element": "c3f3f125-1a3a-df21-12e1-8aa0c50c0a23"}, "text": "Your Real Margin"}}, {"label": "vos.h3", "set_text": {"id": {"component": "6ac72b95bdfb92fbc692e782", "element": "c3f3f125-1a3a-df21-12e1-8aa0c50c0a24"}, "text": "A markup only holds on the right line"}}, {"label": "vos.body", "set_text": {"id": {"component": "6ac72b95bdfb92fbc692e782", "element": "c3f3f125-1a3a-df21-12e1-8aa0c50c0a28"}, "text": "VOS does not calculate your costs or set your markup. Its part comes after the price: customers order by voice in the VOS app and check each line before they send it."}}, {"label": "vos.bullets[0]", "set_text": {"id": {"component": "6ac72b95bdfb92fbc692e782", "element": "c3f3f125-1a3a-df21-12e1-8aa0c50c0a2f"}, "text": "Orders arrive confirmed, numbered and timestamped"}}, {"label": "vos.bullets[1]", "set_text": {"id": {"component": "6ac72b95bdfb92fbc692e782", "element": "c3f3f125-1a3a-df21-12e1-8aa0c50c0a35"}, "text": "Each item tied to your own SKUs"}}, {"label": "vos.bullets[2]", "set_text": {"id": {"component": "6ac72b95bdfb92fbc692e782", "element": "c3f3f125-1a3a-df21-12e1-8aa0c50c0a3b"}, "text": "Catalog updates as stock changes, for fewer stockout surprises"}}, {"label": "vos.bullets[3]", "set_text": {"id": {"component": "6ac72b95bdfb92fbc692e782", "element": "c3f3f125-1a3a-df21-12e1-8aa0c50c0a41"}, "text": "Sent by email as PDF, Excel or Word, or by EDI or API"}}, {"label": "next.h2", "set_text": {"id": {"component": "6ac72b95bdfb92fbc692e782", "element": "eadb9345-c69b-b435-fb88-3d3bda973a94"}, "text": "What to run after material markup"}}, {"label": "next.intro", "set_text": {"id": {"component": "6ac72b95bdfb92fbc692e782", "element": "eadb9345-c69b-b435-fb88-3d3bda973a99"}, "text": "Material markup turns a landed cost into a price. These free calculators check the cost going in and the margin coming out."}}]