[{"label": "who.chips[4].label", "set_text": {"id": {"component": "6ac72b95bdfb92fbc692e782", "element": "3b1749aa-bbc7-35b6-770f-acc417427d57"}, "text": "Controllers costing handling labor"}}, {"label": "who.chips[5].label", "set_text": {"id": {"component": "6ac72b95bdfb92fbc692e782", "element": "3b1749aa-bbc7-35b6-770f-acc417427d5c"}, "text": "Pricing teams rerunning the markup"}}, {"label": "who.chips[6].label", "set_text": {"id": {"component": "6ac72b95bdfb92fbc692e782", "element": "3b1749aa-bbc7-35b6-770f-acc417427d61"}, "text": "Pricing staff building case costs"}}, {"label": "who.chips[7].label", "set_text": {"id": {"component": "6ac72b95bdfb92fbc692e782", "element": "3b1749aa-bbc7-35b6-770f-acc417427d66"}, "text": "Ops managers measuring shrink"}}, {"label": "who.chips[8].label", "set_text": {"id": {"component": "6ac72b95bdfb92fbc692e782", "element": "3b1749aa-bbc7-35b6-770f-acc417427d6b"}, "text": "Finance comparing two margins"}}, {"label": "look.h2", "set_text": {"id": {"component": "6ac72b95bdfb92fbc692e782", "element": "2c639199-1a57-8562-cbdc-9eb60fd58c9b"}, "text": "What to check before you trust the margin"}}, {"label": "look.intro", "set_text": {"id": {"component": "6ac72b95bdfb92fbc692e782", "element": "2c639199-1a57-8562-cbdc-9eb60fd58c9f"}, "text": "The markup is the one number you choose. Freight, handling and shrink are estimates, and estimates are where the margin goes wrong."}}, {"label": "look.steps[0].title", "set_text": {"id": {"component": "6ac72b95bdfb92fbc692e782", "element": "2c639199-1a57-8562-cbdc-9eb60fd58ca5"}, "text": "Freight split over what really arrived"}}, {"label": "look.steps[0].body", "set_text": {"id": {"component": "6ac72b95bdfb92fbc692e782", "element": "2c639199-1a57-8562-cbdc-9eb60fd58ca9"}, "text": "A load charge divided by a full truck's worth of cases understates freight when the truck came half full. Divide by the cases that arrived."}}, {"label": "look.steps[1].title", "set_text": {"id": {"component": "6ac72b95bdfb92fbc692e782", "element": "2c639199-1a57-8562-cbdc-9eb60fd58cad"}, "text": "Handling from timed work, not a guess"}}, {"label": "look.steps[1].body", "set_text": {"id": {"component": "6ac72b95bdfb92fbc692e782", "element": "2c639199-1a57-8562-cbdc-9eb60fd58cb1"}, "text": "Time a few pallets from the dock to the shelf, and cost the hours at the full wage with taxes. Then divide by the cases."}}, {"label": "look.steps[2].title", "set_text": {"id": {"component": "6ac72b95bdfb92fbc692e782", "element": "2c639199-1a57-8562-cbdc-9eb60fd58cb5"}, "text": "Shrink from your own write-offs"}}]